# ── SpectraSynq K1 Firmware — .gitignore ───────────────────────────────────
# british-english-guard: ignore — `artifacts/` is the literal on-disk directory
# name in this repo and must be spelled that way to match real paths.
# Clean-slate hygiene (audit 2026-06-23): scratch, agent state, and build
# artefacts never enter the repo by construction.

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# PlatformIO build output + generated compile DB
.pio/
compile_commands.json
# PIO preprocesses the sketch to <Sketch>.ino.cpp inside src_dir on every build
*.ino.cpp

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Agent / tooling state (never commit)
.claude/worktrees/
.claude/hooks/.summonaikit-task-contract.txt
.claude/proven-config.json
.claude/.proven-config-version
.claude/launch.json
.claude/settings.json
.claude-flow/
.ok/
.entire/
.codex/*
!.codex/skills/
!.codex/skills/**
.codex-subagent/
.cursor/*
!.cursor/skills/
!.cursor/skills/**
!.cursor/rules/
!.cursor/rules/**
.superpowers/
.planning/
.cache/
.understand-anything/
.playwright-mcp/
graphify-out/
.graphifyignore

# Devin agent state — local config + generated run outputs only.
# .devin/agent-os.md and scripts/agent/*.sh ARE tracked.
.devin/config.local.json
.devin/last-bootstrap.json
.devin/repo-truth-report.json
.devin/delegations.json
.devin/k1-session-target.json

# Scratch / working space — ephemeral, clean up when done
_scratch/
__probe.txt
evidence/
findings.md
*.bak.*
.mcp.json.bak.*

# Heavy local artefact dumps (binaries / media) — text receipts may be staged
# pathwise when Captain explicitly authorises a docs(artifacts) wave.
artifacts/**/knob_build/
artifacts/**/knob_build_*/
artifacts/**/*.bin
artifacts/**/*.elf
artifacts/**/*.map
artifacts/ble_midi_71_20260628/

# Heavy media / capture binaries (kept in the archive repo, not here)
*.mp4
*.mov
*.pdf
docs/**/runtime-evidence/*.mp4

# Host-harness generated outputs (the synthetic control fixtures ARE tracked)
/build/audio-semantic-metrics/*
!/build/audio-semantic-metrics/control-fixtures/
scripts/regression-harness/results/**/run-*/
# Regenerable A/B stimulus WAV (8.6MB; rebuild via `wireless_ab_bench.py make-stimulus`)
scripts/regression-harness/fixtures/*.wav

# Test-generated cross-repo artefact: the ws-registry codegen test writes into
# the Tab5 controller path, which is a SEPARATE repo (not vendored here).
sb-tab5-wireless-controller/

# OTA / firmware signing secrets — NEVER commit private keys (Class-D secret).
# Private key lives outside the repo (~/.k1_secrets/, 0600). Public key may be committed
# deliberately for signature verification, but private keys are categorically excluded.
*_PRIVATE.pem
*.key
secure_boot_signing_key*.pem
k1_ota_signing_PRIVATE.pem

# Stimulus WAVs >5MB — pre-commit rejects; keep local for eval replay only
artifacts/**/stimulus_*.wav

# ── Tab5 Deck16 controller (tab5_firmware/) — added 2026-08-11 ──────────────
# The Tab5 tree ships SOURCE only. Everything below is a local build input or a
# regenerable/licence-restricted asset and must never enter history. Without
# these rules `git add -A` stages ~57.5k files / 5.6 GB of PlatformIO cache.
# pinned PIO platforms + packages (5.6 GB local cache).
# NOTE: .gitignore has NO trailing-comment support — a `pattern  # note` line
# makes the comment part of the pattern and silently matches nothing.
tab5_firmware/vendor/
tab5_firmware/.pio/
tab5_firmware/build/
tab5_firmware/build.log
tab5_firmware/managed_components/
tab5_firmware/dependencies.lock
tab5_firmware/sdkconfig.tab5_*.old
# Studio Feixen TRIAL type specimens — TRIAL EULA, redistribution NOT granted.
# Licensed release fonts live outside the repo; only generated LVGL glyph C
# arrays that we are licensed to ship may be committed.
tab5_firmware/fonts_unused/
# Superseded pre-Countach LVGL font C arrays — regenerate via tab5_firmware/tools/
tab5_firmware/_retired_fonts_pre_countach/

# Parallel-lane git worktrees (3.9 GB). Worktree contents belong to their own
# branches; the container directory must never be tracked from this checkout.
.worktrees/

# Editor / agent scratch copies left beside sources
*.orig
*.hardened.bak
*.working
