{
  "$meta": {
    "name": "K718 Remoted — HALO design tokens",
    "version": "0.1.0",
    "device": "K718 Remoted / K1 Encoder — round LCD 480×480, Ø68mm bezel, Ø60mm active",
    "authority": "spec/K718-DESIGN-LANGUAGE.md is the normative source; these tokens are its machine-readable implementation and must agree with it.",
    "evidence": "spec/_design-evidence.md (DLG-02 forensic extraction of the 4 boards)",
    "note": "Hex is NOT printed on the boards; values are principled neon-on-dark hues chosen to meet the board's documented contrast ratios (§color.contrastTargets) and match the territory swatch sequences. Semantic-accent meanings are FIXED across all themes."
  },

  "device": {
    "bezel.od.mm": 68.0,
    "active.dia.mm": 60.0,
    "active.dia.px": 480,
    "scale.pxPerMm": 8,
    "active.r.px": 240,
    "bezel.ringWidth.mm": 4.0,
    "bezel.ringWidth.px": 32
  },

  "grid": {
    "safe.marginPct": 0.06,
    "safe.margin.px": 14,
    "safe.r.px": 226,
    "band": {
      "bezel-safe": { "rOuter": 240, "rInner": 226, "role": "dead zone / glow bleed", "critical": false },
      "nav":        { "rOuter": 226, "rInner": 188, "role": "top-level mode & category navigation" },
      "control":    { "rOuter": 188, "rInner": 138, "role": "active parameter control (interactive)" },
      "signal-core":{ "rOuter": 138, "rInner": 70,  "role": "live signal visualization (spectrum/waveform)" },
      "readout":    { "rOuter": 70,  "rInner": 0,   "role": "the single primary value + unit (sacred)" }
    },
    "zone": {
      "crown":     { "clock": 12, "angleDeg": 0,   "content": "status badge / primary state" },
      "right-arc": { "clock": "1-5", "content": "secondary nav / mode labels" },
      "keel":      { "clock": 6, "angleDeg": 180, "content": "state edge + promotion lane anchor" },
      "left-arc":  { "clock": "7-11", "content": "secondary nav / mode labels" }
    }
  },

  "color": {
    "bg": {
      "base":   "#06070A",
      "raised": "#0E1014",
      "ring":   "#14171D",
      "hairline": "#222630"
    },
    "text": {
      "primary":   "#FFFFFF",
      "secondary": "#C4CAD4",
      "tertiary":  "#8A92A0",
      "disabled":  "#4A515C"
    },
    "accent": {
      "_doc": "FIXED meaning across every Theme Territory. A theme may restyle a palette but may never reassign these meanings.",
      "focus":   { "hex": "#2DD4F5", "hue": "cyan",    "meaning": "focus ring — the selected element",      "contrastTarget": 9.7 },
      "input":   { "hex": "#FF4FD8", "hue": "magenta", "meaning": "user input / pending focus / focus dots", "contrastTarget": 7.1, "_verified": "7.1:1 vs bg (AAA) — computed, not the board's 8.1" },
      "active":  { "hex": "#FF9A2E", "hue": "amber",   "meaning": "active arc — value currently changing",   "contrastTarget": 7.2 },
      "confirm": { "hex": "#3FD96A", "hue": "green",   "meaning": "committed / locked / healthy",            "contrastTarget": 6.3 },
      "alert":   { "hex": "#FF4D4D", "hue": "red",     "meaning": "warning / conflict / critical (act now)", "contrastTarget": 6.0 }
    },
    "_violet_retired": { "hex": "#A66BFF", "_role": "DECORATIVE — theme-palette (--c*) only, NOT a semantic accent (Vignelli V2). Exactly 5 semantic accents exist." },
    "trust": {
      "_doc": "Trust State lifecycle (Axis B). committing == active (amber); no yellow collision.",
      "settled":    "#8A92A0",
      "pending":    "#FF4FD8",
      "committing": "#FF9A2E",
      "committed":  "#3FD96A"
    },
    "trustZone": {
      "_doc": "Truth Ring = THREE discrete steps (V4), large jumps, no simultaneous-hue overload. committed is the green confirm accent (separate terminus).",
      "pending": "#FF4FD8",
      "near":    "#FF9A2E",
      "ready":   "#2DD4F5"
    },
    "contrastTargets": {
      "_doc": "Board 02 §04 documented ratios on the dark background; token hues are calibrated to these.",
      "white": 15.6, "cyan": 9.7, "magenta": 8.1, "amber": 7.2, "green": 6.3, "violet": 4.8,
      "ringAccentMin": 2.9
    },
    "territory": {
      "_doc": "The ONLY sanctioned visual-variation axis. Each = {base, accent palette (5), motion profile, density}. Meanings of semantic accents above never change.",
      "signal-observatory": {
        "character": "Clean. Scientific. Precise.",
        "swatch": ["#2D6BF5", "#2D9CF5", "#2DD4F5", "#5CE0E0", "#A66BFF"],
        "motion": "calm", "density": "high"
      },
      "afterglow-district": {
        "character": "Cinematic. Moody. Electric.",
        "swatch": ["#A66BFF", "#FF4FD8", "#FF5C9C", "#FF4D4D", "#FF8A1E"],
        "motion": "smooth", "density": "low"
      },
      "prism-firewall": {
        "character": "Data-driven. Vivid. Adaptive.",
        "swatch": ["#2DE0C4", "#2DD4F5", "#3FD0FF", "#3FD96A", "#B6FF3D"],
        "motion": "responsive", "density": "high"
      },
      "laser-liturgy": {
        "character": "Sacred. Focused. Ritual.",
        "swatch": ["#7A4DFF", "#A66BFF", "#D04FFF", "#FF5CD0", "#FF4FD8"],
        "motion": "deliberate", "density": "minimal"
      },
      "zero-g-bazaar": {
        "character": "Energetic. Holographic. Alive.",
        "swatch": ["#FF8A1E", "#FFA63D", "#FFC74D", "#FFE14D", "#2D9CF5"],
        "motion": "lively", "density": "medium"
      }
    }
  },

  "type": {
    "family": {
      "_standard": "K1 Signal Interface (artifacts/.../fonts) — Captain-referenced",
      "display": "DIN Condensed Bold",
      "displayProxyWeb": "Oswald / Saira Condensed (where DIN Condensed unavailable)",
      "label":   "Inter Regular",
      "numeric": "DIN Condensed Bold, tabular figures (tnum) — readout uses the display face",
      "deviceNote": "On ESP32-S3/LVGL these must be compiled as bitmap glyph sets at the ladder sizes (T1-T5); not webfonts."
    },
    "scale": {
      "t1": { "px": 30, "range": [28, 32], "role": "Primary numeric (Readout)", "minContrast": "AAA", "family": "numeric" },
      "t2": { "px": 22, "range": [20, 24], "role": "Primary labels",            "minContrast": "AAA", "family": "label" },
      "t3": { "px": 17, "range": [16, 18], "role": "Secondary labels",          "minContrast": "AAA", "family": "label" },
      "t4": { "px": 14, "range": [13, 15], "role": "Tertiary info",             "minContrast": "AA",  "family": "label" },
      "t5": { "px": 11, "range": [11, 12], "role": "Micro labels",              "minContrast": "AA",  "family": "label" },
      "t6": { "px": 10, "range": [9, 10],  "role": "Micro / fine print",        "minContrast": "A",   "family": "label" }
    },
    "tracking": { "label": "0.08em", "numeric": "0" }
  },

  "motion": {
    "_doc": "Motion is feedback, never decoration. Target 60fps at full brightness.",
    "idle":    { "desc": "balanced ring brightness, low energy", "durMs": 0,   "easing": "linear" },
    "live":    { "desc": "signal viz animates to audio",         "durMs": 0,   "easing": "linear" },
    "focus":   { "desc": "focus ring + dots brighten",           "durMs": 160, "easing": "cubic-bezier(0.2,0.8,0.2,1)" },
    "adjust":  { "desc": "active arc fills/pulses in real time",  "durMs": 90,  "easing": "cubic-bezier(0.4,0,0.2,1)" },
    "confirm": { "desc": "one brief confirm pulse, then settle",  "durMs": 320, "easing": "cubic-bezier(0.3,0,0,1)", "oneShot": true }
  },

  "occlusion": {
    "left-thumb":  { "coverage": 0.30, "arc": "lower-left",  "rule": "lowest-priority content only" },
    "right-thumb": { "coverage": 0.30, "arc": "lower-right", "rule": "keep readout center clear" },
    "finger-swipe":{ "coverage": 0.15, "arc": "bottom",      "rule": "state edge must persist through swipe" }
  }
}
