+    case FN_BRIGHTNESS:    return 39;              // global.master_brightness
+    case FN_SENSITIVITY:   return 34;              // global.sensitivity
+    case FN_EDGE_LIGHTING: return 45;              // edge.enabled
+    case FN_MIRROR:        return ch == 0 ? 8  : 27;
