+  RemotedEmitStatus st = remoted_control_emit_index(idx, value, false);
+  Serial.printf("DASH_EMIT fn=%s raw=%d midi_index=%d path=%s value=%.4f status=%d\n",
+                FUNCS[s.func].name,
+                raw,
+                idx,
