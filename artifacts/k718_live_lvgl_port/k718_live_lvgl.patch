+static uint16_t pal_color565(const PaletteDef& p, int i) {
+  int idx = i;
+  if (p.count > 1 && idx == 0 && p.count > 3) idx = 1;  // skip dark base for effects
+  if (idx < 0) idx = 0;
+  if (idx >= p.count) idx = p.count - 1;
+  return rgb565_hex(p.rgb[idx]);
+}
