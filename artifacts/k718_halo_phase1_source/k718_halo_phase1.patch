+void setRotation(uint8_t rot)
+{
+  if (rot > 3)
+    return;
+  if (lcd == NULL || touch == NULL)
+    return;
+
+  switch (rot)
+  {
+  case 1: // 顺时针90度
+    lcd->swapXY(true);
+    lcd->mirrorX(true);
+    lcd->mirrorY(false);
+    touch->swapXY(true);
+    touch->mirrorX(true);
+    touch->mirrorY(false);
+    break;
+  case 2:
+    lcd->swapXY(false);
+    lcd->mirrorX(true);
+    lcd->mirrorY(true);
+    touch->swapXY(false);
+    touch->mirrorX(true);
+    touch->mirrorY(true);
+    break;
+  case 3:
+    lcd->swapXY(true);
+    lcd->mirrorX(false);
+    lcd->mirrorY(true);
+    touch->swapXY(true);
+    touch->mirrorX(false);
+    touch->mirrorY(true);
+    break;
+  default:
+    lcd->swapXY(false);
+    lcd->mirrorX(false);
+    lcd->mirrorY(false);
+    touch->swapXY(false);
+    touch->mirrorX(false);
+    touch->mirrorY(false);
+    break;
+  }
+}
+
+void screen_switch(bool on)
+{
+  if (NULL == backlight)
+    return;
+  if (on)
+    backlight->on();
+  else
+    backlight->off();
+}
