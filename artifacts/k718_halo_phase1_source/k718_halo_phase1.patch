+// Encode one logical control change into a MIDI 1.0 byte stream (status+data,
+// running status NOT used). Returns the number of bytes written to `out`
+// (out must hold >= 12). Rounding is round-half-up to match the host parity
+// reference; the K1 decoder dequantises, so the rounding choice only moves a
+// float by <=1 LSB of the 14-bit grid (within the documented tolerance).
+static inline int k1_ble_midi_encode(const K1BleMidiEntry* e, float value, uint8_t* out) {
+  uint8_t ch = (uint8_t)(e->channel & 0x0F);
+  switch (e->type) {
+    case K1MIDI_CC14: {
+      float t = (e->vmax > e->vmin) ? (value - e->vmin) / (e->vmax - e->vmin) : 0.0f;
+      int n = (int)floorf(t * 16383.0f + 0.5f);
+      if (n < 0) n = 0;
+      if (n > 16383) n = 16383;
+      out[0] = (uint8_t)(0xB0 | ch); out[1] = e->cc_msb; out[2] = (uint8_t)((n >> 7) & 0x7F);
+      out[3] = (uint8_t)(0xB0 | ch); out[4] = e->cc_lsb; out[5] = (uint8_t)(n & 0x7F);
+      return 6;
+    }
+    case K1MIDI_CC7_BOOL:
+      out[0] = (uint8_t)(0xB0 | ch); out[1] = e->cc_msb; out[2] = (value != 0.0f) ? 127 : 0;
+      return 3;
+    case K1MIDI_CC7_ENUM:
+      out[0] = (uint8_t)(0xB0 | ch); out[1] = e->cc_msb; out[2] = (uint8_t)((int)value & 0x7F);
+      return 3;
+    case K1MIDI_PC:
+      out[0] = (uint8_t)(0xC0 | ch); out[1] = (uint8_t)((int)value & 0x7F);
+      return 2;
+    case K1MIDI_NRPN: {
+      int d = (int)value & 0x3FFF;
+      uint16_t p = e->nrpn_param;
+      out[0]  = (uint8_t)(0xB0 | ch); out[1]  = 99; out[2]  = (uint8_t)((p >> 7) & 0x7F);
+      out[3]  = (uint8_t)(0xB0 | ch); out[4]  = 98; out[5]  = (uint8_t)(p & 0x7F);
+      out[6]  = (uint8_t)(0xB0 | ch); out[7]  = 6;  out[8]  = (uint8_t)((d >> 7) & 0x7F);
+      out[9]  = (uint8_t)(0xB0 | ch); out[10] = 38; out[11] = (uint8_t)(d & 0x7F);
+      return 12;
+    }
+  }
+  return 0;
+}
