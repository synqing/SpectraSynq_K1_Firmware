+if grep -RInE 's_center|s_hint|s_link|s_pri|s_sec|s_menu_rows|static const int BPM|bpm=|LINKED|ADVERTISING|BLE LOST|BLE LINK|BLE ADV|PEND|CONFIRMED|ACK|received|applied' $FILES; then
