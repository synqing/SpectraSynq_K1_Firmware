+  const int offsetx1 = area->x1;
+  const int offsetx2 = area->x2;
+  const int offsety1 = area->y1;
+  const int offsety2 = area->y2;
+  lcd->drawBitmap(offsetx1, offsety1, offsetx2 - offsetx1 + 1, offsety2 - offsety1 + 1, (const uint8_t *)color_p);
+}
