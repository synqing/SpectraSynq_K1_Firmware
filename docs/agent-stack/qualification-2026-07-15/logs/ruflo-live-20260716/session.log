{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0147eVpnVp6Pd2Aq1N4Pr29k","type":"tool_result","content":"1\t/*----------------------------------------\n2\t  K1 AP CAPTURE / TELEMETRY (diagnostics) — implementation\n3\t  ----------------------------------------\n4\t  Bodies lifted verbatim from serial_menu.h (Phase A Lane 2, S1). The whole\n5\t  unit is gated on `ENABLE_TEMPO_STREAM && ENABLE_AP_FRONTEND_DEBUG`, set only\n6\t  in the non-shippable probe envs, so this TU compiles to NOTHING in\n7\t  production. The capture buffers/counters (formerly file-scope `static` in the\n8\t  single-include serial_menu.h) are defined here with external linkage and\n9\t  declared `extern` in the header, so the call sites remaining in serial_menu.h\n10\t  reference the same storage.\n11\t*/\n12\t\n13\t// Gate FIRST, BEFORE any #include. In production (k1_hardware) the probe gate\n14\t// is OFF, so this TU preprocesses to NOTHING — no \"globals.h\" pull-in, hence no\n15\t// static-initialiser constructor (`_GLOBAL__sub_I_…`) added to the production\n16\t// link. (Including the header unconditionally added +160 B of global-ctor code\n17\t// to k1_hardware even with the body gated out — globals.h declares\n18\t// non-trivially-constructed globals whose guard inits emit per-TU.)\n19\t#if ENABLE_TEMPO_STREAM && ENABLE_AP_FRONTEND_DEBUG\n20\t\n21\t#include \"k1_ap_capture_telemetry.h\"\n22\t#include \"serial_parse_helpers.h\"   // vp_parse_bool\n23\t#include \"k1ev_capture.h\"           // buffered [K1EV] capture (piggybacked arm/dump; no-op unless ENABLE_K1EV_STREAM)\n24\t#include <stdlib.h>                 // atol\n25\t#include <string.h>                 // strcmp\n26\t\n27\t// ---- Capture state (external linkage; initialisers verbatim from serial_menu.h)\n28\tbool AP_FRONTEND_DEBUG_ENABLED = false;\n29\tAPNovCaptureSample AP_NOV_CAPTURE_BUFFER[AP_NOV_CAPTURE_CAPACITY];\n30\tuint16_t AP_NOV_CAPTURE_COUNT = 0;\n31\tuint32_t AP_NOV_CAPTURE_DROPPED = 0;\n32\tuint32_t AP_NOV_CAPTURE_START_MS = 0;\n33\tuint32_t AP_NOV_CAPTURE_END_MS = 0;\n34\tuint32_t AP_NOV_CAPTURE_LAST_EMIT = 0;\n35\tbool AP_NOV_CAPTURE_ACTIVE = false;\n36\tAPCadenceCaptureSample* AP_CAD_CAPTURE_BUFFER = nullptr;\n37\tuint16_t AP_CAD_CAPTURE_COUNT = 0;\n38\tuint32_t AP_CAD_CAPTURE_DROPPED = 0;\n39\tuint32_t AP_CAD_CAPTURE_START_MS = 0;\n40\tuint32_t AP_CAD_CAPTURE_END_MS = 0;\n41\tuint32_t AP_CAD_CAPTURE_LAST_EMIT = 0;\n42\tuint32_t AP_CAD_CAPTURE_LAST_EMIT_MS = 0;\n43\tbool AP_CAD_CAPTURE_ACTIVE = false;\n44\tbool AP_CAD_CAPTURE_ALLOC_FAILED = false;\n45\tbool AP_CAD_SOAK_ACTIVE = false;\n46\tuint32_t AP_CAD_SOAK_START_MS = 0;\n47\tuint32_t AP_CAD_SOAK_END_MS = 0;\n48\tuint32_t AP_CAD_SOAK_FIRST_FRAME_MS = 0;\n49\tuint32_t AP_CAD_SOAK_LAST_FRAME_MS = 0;\n50\tuint32_t AP_CAD_SOAK_FIRST_EMIT_MS = 0;\n51\tuint32_t AP_CAD_SOAK_LAST_EMIT_MS = 0;\n52\tuint32_t AP_CAD_SOAK_LAST_EMIT = 0;\n53\tuint32_t AP_CAD_SOAK_PREV_FRAME = 0;\n54\tuint32_t AP_CAD_SOAK_PREV_FRAME_MS = 0;\n55\tuint32_t AP_CAD_SOAK_ROW_COUNT = 0;\n56\tuint32_t AP_CAD_SOAK_EMITTED_COUNT = 0;\n57\tuint32_t AP_CAD_SOAK_I2S_NOT_OK = 0;\n58\tuint32_t AP_CAD_SOAK_BYTES_MISMATCH = 0;\n59\tuint32_t AP_CAD_SOAK_FRAME_GAPS = 0;\n60\tuint32_t AP_CAD_SOAK_TIMESTAMP_REGRESSIONS = 0;\n61\tuint32_t AP_CAD_SOAK_CORE_BAD = 0;\n62\tuint32_t AP_CAD_SOAK_ACTIVE_OVER_7500 = 0;\n63\tuint32_t AP_CAD_SOAK_EMITTED_ACTIVE_OVER_7500 = 0;\n64\tuint32_t AP_CAD_SOAK_ACTIVE_MAX_US = 0;\n65\tuint16_t AP_CAD_SOAK_WORST_USED = 0;\n66\tbool AP_CAD_SOAK_HAVE_PREV = false;\n67\tAPCadenceCaptureSample AP_CAD_SOAK_WORST[AP_CAD_SOAK_WORST_COUNT];\n68\tuint32_t AP_CAD_SOAK_ACTIVE_HIST[AP_CAD_SOAK_HIST_BUCKETS];\n69\t\n70\t// ---- Capture handlers (verbatim from serial_menu.h 644-1397) ---------------\n71\tuint16_t ap_nov_capture_q16(float value) {\n72\t  if (!isfinite(value) || value <= 0.0f) {\n73\t    return 0;\n74\t  }\n75\t  if (value >= 1.0f) {\n76\t    return 65535U;\n77\t  }\n78\t  return (uint16_t)(value * 65535.0f + 0.5f);\n79\t}\n80\t\n81\tuint16_t ap_nov_capture_q8_8(float value) {\n82\t  if (!isfinite(value) || value <= 0.0f) {\n83\t    return 0;\n84\t  }\n85\t  if (value >= 255.996f) {\n86\t    return 65535U;\n87\t  }\n88\t  return (uint16_t)(value * 256.0f + 0.5f);\n89\t}\n90\t\n91\tvoid ap_nov_capture_print_q16(uint16_t value) {\n92\t  USBSerial.print((float)value / 65535.0f, 5);\n93\t}\n94\t\n95\tvoid ap_nov_capture_print_q8_8(uint16_t value) {\n96\t  USBSerial.print((float)value / 256.0f, 5);\n97\t}\n98\t\n99\tvoid ap_nov_capture_status() {\n100\t  tx_begin();\n101\t  USBSerial.print(\"NOV_CAPTURE: active=\");\n102\t  USBSerial.print(vp_bool_text(AP_NOV_CAPTURE_ACTIVE));\n103\t  USBSerial.print(\" count=\");\n104\t  USBSerial.print(AP_NOV_CAPTURE_COUNT);\n105\t  USBSerial.print(\" capacity=\");\n106\t  USBSerial.print(AP_NOV_CAPTURE_CAPACITY);\n107\t  USBSerial.print(\" dropped=\");\n108\t  USBSerial.print(AP_NOV_CAPTURE_DROPPED);\n109\t  USBSerial.print(\" start_ms=\");\n110\t  USBSerial.print(AP_NOV_CAPTURE_START_MS);\n111\t  USBSerial.print(\" end_ms=\");\n112\t  USBSerial.println(AP_NOV_CAPTURE_END_MS);\n113\t  tx_end();\n114\t}\n115\t\n116\tvoid ap_nov_capture_clear() {\n117\t  AP_NOV_CAPTURE_ACTIVE = false;\n118\t  AP_NOV_CAPTURE_COUNT = 0;\n119\t  AP_NOV_CAPTURE_DROPPED = 0;\n120\t  AP_NOV_CAPTURE_START_MS = 0;\n121\t  AP_NOV_CAPTURE_END_MS = 0;\n122\t  AP_NOV_CAPTURE_LAST_EMIT = k1_tempo_debug_read().emit_count;\n123\t}\n124\t\n125\tbool ap_nov_capture_arm(uint32_t duration_ms) {\n126\t  if (duration_ms == 0 || duration_ms > AP_NOV_CAPTURE_MAX_MS) {\n127\t    return false;\n128\t  }\n129\t  AP_NOV_CAPTURE_COUNT = 0;\n130\t  AP_NOV_CAPTURE_DROPPED = 0;\n131\t  AP_NOV_CAPTURE_START_MS = millis();\n132\t  AP_NOV_CAPTURE_END_MS = AP_NOV_CAPTURE_START_MS + duration_ms;\n133\t  AP_NOV_CAPTURE_LAST_EMIT = k1_tempo_debug_read().emit_count;\n134\t  AP_NOV_CAPTURE_ACTIVE = true;\n135\t#ifdef ENABLE_K1EV_STREAM\n136\t  // Piggyback: the same duration arms the buffered [K1EV] capture, so the existing\n137\t  // `nov_capture=<ms>` serial command (device_novelty_buffer_capture.py) drives both\n138\t  // with no new command and no tool edit. Non-fatal if the k1ev PSRAM alloc fails.\n139\t  k1ev_capture_arm(duration_ms);\n140\t#endif\n141\t  return true;\n142\t}\n143\t\n144\tvoid ap_nov_capture_tick(uint32_t t_now, const K1TempoDebugSnapshot& td) {\n145\t  if (!AP_NOV_CAPTURE_ACTIVE) {\n146\t    return;\n147\t  }\n148\t  if ((int32_t)(t_now - AP_NOV_CAPTURE_END_MS) >= 0) {\n149\t    AP_NOV_CAPTURE_ACTIVE = false;\n150\t    return;\n151\t  }\n152\t  if (td.emit_count == AP_NOV_CAPTURE_LAST_EMIT) {\n153\t    return;\n154\t  }\n155\t  AP_NOV_CAPTURE_LAST_EMIT = td.emit_count;\n156\t  if (AP_NOV_CAPTURE_COUNT >= AP_NOV_CAPTURE_CAPACITY) {\n157\t    AP_NOV_CAPTURE_DROPPED++;\n158\t    return;\n159\t  }\n160\t\n161\t  APNovCaptureSample& sample = AP_NOV_CAPTURE_BUFFER[AP_NOV_CAPTURE_COUNT++];\n162\t  sample.t_ms = td.last_emit_ms;\n163\t  sample.emit_count = td.emit_count;\n164\t  sample.novelty_q16 = ap_nov_capture_q16(td.last_novelty);\n165\t  sample.scaled_novelty_q8_8 = ap_nov_capture_q8_8(td.last_scaled_novelty);\n166\t  sample.scale_q8_8 = ap_nov_capture_q8_8(td.novelty_scale);\n167\t  sample.flags = (td.silence_detected ? 0x01 : 0x00) | (td.acf_valid ? 0x02 : 0x00);\n168\t  sample.reserved = 0;\n169\t}\n170\t\n171\tvoid ap_nov_capture_dump() {\n172\t  // NOTE: the [K1EV] buffered dump is DELIBERATELY NOT emitted here. Injecting the\n173\t  // large k1ev block into this stream corrupts the capture tool's NOV/APCAD parse\n174\t  // (device_novelty_buffer_capture.py expects a clean NOV dump). The k1ev buffer is\n175\t  // dumped out-of-band by the decoupled `k1ev_dump=1` command (serial_diag_ap_dispatch),\n176\t  // which an orchestrator sends AFTER the tool's capture completes, when serial is quiet.\n177\t  AP_NOV_CAPTURE_ACTIVE = false;\n178\t  USBSerial.print(\"NOV_CAPTURE_BEGIN,count=\");\n179\t  USBSerial.print(AP_NOV_CAPTURE_COUNT);\n180\t  USBSerial.print(\",capacity=\");\n181\t  USBSerial.print(AP_NOV_CAPTURE_CAPACITY);\n182\t  USBSerial.print(\",dropped=\");\n183\t  USBSerial.print(AP_NOV_CAPTURE_DROPPED);\n184\t  USBSerial.print(\",start_ms=\");\n185\t  USBSerial.print(AP_NOV_CAPTURE_START_MS);\n186\t  USBSerial.print(\",end_ms=\");\n187\t  USBSerial.println(AP_NOV_CAPTURE_END_MS);\n188\t  for (uint16_t i = 0; i < AP_NOV_CAPTURE_COUNT; i++) {\n189\t    const APNovCaptureSample& sample = AP_NOV_CAPTURE_BUFFER[i];\n190\t    USBSerial.print(\"NOV,t=\");\n191\t    USBSerial.print(sample.t_ms);\n192\t    USBSerial.print(\",emit=\");\n193\t    USBSerial.print(sample.emit_count);\n194\t    USBSerial.print(\",nov=\");\n195\t    ap_nov_capture_print_q16(sample.novelty_q16);\n196\t    USBSerial.print(\",nov_scaled=\");\n197\t    ap_nov_capture_print_q8_8(sample.scaled_novelty_q8_8);\n198\t    USBSerial.print(\",scale=\");\n199\t    ap_nov_capture_print_q8_8(sample.scale_q8_8);\n200\t    USBSerial.print(\",sil=\");\n201\t    USBSerial.print((sample.flags & 0x01) ? 1 : 0);\n202\t    USBSerial.print(\",acf=\");\n203\t    USBSerial.print((sample.flags & 0x02) ? 1 : 0);\n204\t    USBSerial.println(\",src=buf\");\n205\t  }\n206\t  USBSerial.print(\"NOV_CAPTURE_DONE,count=\");\n207\t  USBSerial.print(AP_NOV_CAPTURE_COUNT);\n208\t  USBSerial.print(\",dropped=\");\n209\t  USBSerial.println(AP_NOV_CAPTURE_DROPPED);\n210\t}\n211\t\n212\tuint16_t ap_capture_u16_sat(uint32_t value) {\n213\t  return value > 0xFFFFUL ? 0xFFFFU : (uint16_t)value;\n214\t}\n215\t\n216\tint16_t ap_capture_i16_sat(int32_t value) {\n217\t  if (value > 32767L) return 32767;\n218\t  if (value < -32768L) return -32768;\n219\t  return (int16_t)value;\n220\t}\n221\t\n222\tbool ap_cad_capture_ensure_buffer() {\n223\t  AP_CAD_CAPTURE_ALLOC_FAILED = false;\n224\t  if (AP_CAD_CAPTURE_BUFFER != nullptr) {\n225\t    return true;\n226\t  }\n227\t  AP_CAD_CAPTURE_BUFFER = (APCadenceCaptureSample*)heap_caps_malloc(\n228\t    sizeof(APCadenceCaptureSample) * AP_CAD_CAPTURE_CAPACITY,\n229\t    MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);\n230\t  if (AP_CAD_CAPTURE_BUFFER == nullptr) {\n231\t    AP_CAD_CAPTURE_BUFFER = (APCadenceCaptureSample*)heap_caps_malloc(\n232\t      sizeof(APCadenceCaptureSample) * AP_CAD_CAPTURE_CAPACITY,\n233\t      MALLOC_CAP_8BIT);\n234\t  }\n235\t  AP_CAD_CAPTURE_ALLOC_FAILED = (AP_CAD_CAPTURE_BUFFER == nullptr);\n236\t  return !AP_CAD_CAPTURE_ALLOC_FAILED;\n237\t}\n238\t\n239\tvoid ap_cad_capture_status() {\n240\t  tx_begin();\n241\t  USBSerial.print(\"APCAD_CAPTURE: active=\");\n242\t  USBSerial.print(vp_bool_text(AP_CAD_CAPTURE_ACTIVE));\n243\t  USBSerial.print(\" count=\");\n244\t  USBSerial.print(AP_CAD_CAPTURE_COUNT);\n245\t  USBSerial.print(\" capacity=\");\n246\t  USBSerial.print(AP_CAD_CAPTURE_CAPACITY);\n247\t  USBSerial.print(\" dropped=\");\n248\t  USBSerial.print(AP_CAD_CAPTURE_DROPPED);\n249\t  USBSerial.print(\" start_ms=\");\n250\t  USBSerial.print(AP_CAD_CAPTURE_START_MS);\n251\t  USBSerial.print(\" end_ms=\");\n252\t  USBSerial.print(AP_CAD_CAPTURE_END_MS);\n253\t  USBSerial.print(\" alloc=\");\n254\t  USBSerial.println(AP_CAD_CAPTURE_ALLOC_FAILED ? \"fail\" : (AP_CAD_CAPTURE_BUFFER ? \"ok\" : \"none\"));\n255\t  tx_end();\n256\t}\n257\t\n258\tvoid ap_cad_capture_clear() {\n259\t  AP_CAD_CAPTURE_ACTIVE = false;\n260\t  AP_CAD_CAPTURE_COUNT = 0;\n261\t  AP_CAD_CAPTURE_DROPPED = 0;\n262\t  AP_CAD_CAPTURE_START_MS = 0;\n263\t  AP_CAD_CAPTURE_END_MS = 0;\n264\t  K1TempoDebugSnapshot td = k1_tempo_debug_read();\n265\t  AP_CAD_CAPTURE_LAST_EMIT = td.emit_count;\n266\t  AP_CAD_CAPTURE_LAST_EMIT_MS = td.last_emit_ms;\n267\t}\n268\t\n269\tbool ap_cad_capture_arm(uint32_t duration_ms) {\n270\t  if (duration_ms == 0 || duration_ms > AP_CAD_CAPTURE_MAX_MS) {\n271\t    return false;\n272\t  }\n273\t  if (!ap_cad_capture_ensure_buffer()) {\n274\t    return false;\n275\t  }\n276\t  AP_CAD_CAPTURE_COUNT = 0;\n277\t  AP_CAD_CAPTURE_DROPPED = 0;\n278\t  AP_CAD_CAPTURE_START_MS = millis();\n279\t  AP_CAD_CAPTURE_END_MS = AP_CAD_CAPTURE_START_MS + duration_ms;\n280\t  K1TempoDebugSnapshot td = k1_tempo_debug_read();\n281\t  AP_CAD_CAPTURE_LAST_EMIT = td.emit_count;\n282\t  AP_CAD_CAPTURE_LAST_EMIT_MS = td.last_emit_ms;\n283\t  AP_CAD_CAPTURE_ACTIVE = true;\n284\t  return true;\n285\t}\n286\t\n287\tAPCadenceCaptureSample ap_cad_make_sample(const APCadenceFrameInput& frame, bool emitted, uint32_t emit_delta_ms) {\n288\t  APCadenceCaptureSample sample = {};\n289\t  sample.boot_ms = frame.boot_ms;\n290\t  sample.frame_index = frame.frame_index;\n291\t  sample.frame_ms = frame.frame_ms;\n292\t  sample.emit_count = frame.tempo.emit_count;\n293\t  sample.emit_ms = frame.tempo.last_emit_ms;\n294\t  sample.i2s_read_elapsed_us = frame.i2s.elapsed_us;\n295\t  sample.gdft_elapsed_us = frame.gdft_elapsed_us;\n296\t  sample.novelty_elapsed_us = frame.novelty_elapsed_us;\n297\t  sample.total_ap_loop_elapsed_us = frame.total_ap_loop_elapsed_us;\n298\t  sample.stage = frame.stage;\n299\t  sample.sample_rate = ap_capture_u16_sat(CONFIG.SAMPLE_RATE);\n300\t  sample.samples_per_chunk = ap_capture_u16_sat(CONFIG.SAMPLES_PER_CHUNK);\n301\t  sample.dma_frame_num = ap_capture_u16_sat(CONFIG.SAMPLES_PER_CHUNK);\n302\t  sample.bytes_requested = ap_capture_u16_sat(frame.i2s.bytes_requested);\n303\t  sample.bytes_read = ap_capture_u16_sat(frame.i2s.bytes_read);\n304\t  sample.emit_delta_ms = ap_capture_u16_sat(emit_delta_ms);\n305\t  sample.declared_ap_hz_q8_8 = ap_nov_capture_q8_8(frame.tempo.declared_ap_frame_hz);\n306\t  sample.declared_nov_hz_q8_8 = ap_nov_capture_q8_8(frame.tempo.declared_novelty_rate_hz);\n307\t  sample.novelty_q16 = ap_nov_capture_q16(frame.tempo.last_novelty);\n308\t  sample.scaled_novelty_q8_8 = ap_nov_capture_q8_8(frame.tempo.last_scaled_novelty);\n309\t  sample.winner_bpm_q8_8 = ap_nov_capture_q8_8(frame.tempo.winner_bpm);\n310\t  sample.top1_bpm_q8_8 = ap_nov_capture_q8_8(frame.tempo.top1_bpm);\n311\t  sample.v2_conf_ema_q16 = ap_nov_capture_q16(frame.tempo.v2_conf_ema);\n312\t  sample.v2_quality_q16 = ap_nov_capture_q16(frame.tempo.v2_quality);\n313\t  sample.v2_hist_share_q16 = ap_nov_capture_q16(frame.tempo.v2_hist_share_norm);\n314\t  sample.v2_prominence_q16 = ap_nov_capture_q16(frame.tempo.v2_prominence);\n315\t  sample.v2_periodicity_q16 = ap_nov_capture_q16(frame.tempo.v2_periodicity);\n316\t  sample.v2_peak_share_q16 = ap_nov_capture_q16(frame.tempo.v2_peak_share);\n317\t  sample.tempo_silence_elapsed_us = ap_capture_u16_sat(frame.tempo.silence_elapsed_us);\n318\t  sample.tempo_acf_elapsed_us = ap_capture_u16_sat(frame.tempo.acf_elapsed_us);\n319\t  sample.tempo_update_elapsed_us = ap_capture_u16_sat(frame.tempo.update_elapsed_us);\n320\t  sample.tempo_phase_elapsed_us = ap_capture_u16_sat(frame.tempo.phase_elapsed_us);\n321\t  sample.tempo_publish_elapsed_us = ap_capture_u16_sat(frame.tempo.publish_elapsed_us);\n322\t  sample.tempo_emit_elapsed_us = ap_capture_u16_sat(frame.tempo.emit_elapsed_us);\n323\t  sample.acf_lag_cursor = ap_capture_u16_sat(frame.tempo.acf_lag_cursor);\n324\t  sample.acf_publish_count = frame.tempo.acf_publish_count;\n325\t  sample.i2s_status = ap_capture_i16_sat(frame.i2s.status);\n326\t  sample.ap_core_id = frame.ap_core_id;\n327\t  sample.vp_core_id = frame.vp_core_id;\n328\t  sample.slot_bit_width = K1_I2S_SLOT_BIT_WIDTH_BITS;\n329\t  sample.slot_mode = K1_I2S_SLOT_MODE_STEREO;\n330\t  sample.dma_desc_num = K1_I2S_DMA_DESC_NUM;\n331\t  sample.k1_frame_ctr = (uint8_t)frame.tempo.frame_ctr;\n332\t  sample.tempo_decimation = (uint8_t)frame.tempo.novelty_decimation;\n333\t  sample.flags = (emitted ? 0x01 : 0x00)\n334\t    | (frame.tempo.silence_detected ? 0x02 : 0x00)\n335\t    | (frame.tempo.acf_valid ? 0x04 : 0x00)\n336\t    | (frame.i2s.status == 0 ? 0x08 : 0x00)\n337\t    | (frame.i2s.bytes_read == frame.i2s.bytes_requested ? 0x10 : 0x00)\n338\t    | ((frame.ap_core_id >= 0 && frame.vp_core_id >= 0 && frame.ap_core_id != frame.vp_core_id) ? 0x20 : 0x00)\n339\t    | (frame.tempo.v2_locked ? 0x40 : 0x00)\n340\t    | (frame.tempo.acf_spread_active ? 0x80 : 0x00);\n341\t  return sample;\n342\t}\n343\t\n344\tuint32_t ap_cad_active_work_us(const APCadenceCaptureSample& sample) {\n345\t  return (sample.total_ap_loop_elapsed_us >= sample.i2s_read_elapsed_us)\n346\t    ? (sample.total_ap_loop_elapsed_us - sample.i2s_read_elapsed_us)\n347\t    : sample.total_ap_loop_elapsed_us;\n348\t}\n349\t\n350\tvoid ap_cad_capture_tick(const APCadenceFrameInput& frame) {\n351\t  if (!AP_CAD_CAPTURE_ACTIVE) {\n352\t    return;\n353\t  }\n354\t  if ((int32_t)(frame.frame_ms - AP_CAD_CAPTURE_END_MS) >= 0) {\n355\t    AP_CAD_CAPTURE_ACTIVE = false;\n356\t    return;\n357\t  }\n358\t  if (AP_CAD_CAPTURE_BUFFER == nullptr || AP_CAD_CAPTURE_COUNT >= AP_CAD_CAPTURE_CAPACITY) {\n359\t    AP_CAD_CAPTURE_DROPPED++;\n360\t    return;\n361\t  }\n362\t\n363\t  const bool emitted = frame.tempo.emit_count != AP_CAD_CAPTURE_LAST_EMIT;\n364\t  uint32_t emit_delta_ms = 0;\n365\t  if (emitted) {\n366\t    emit_delta_ms = (frame.tempo.last_emit_ms >= AP_CAD_CAPTURE_LAST_EMIT_MS)\n367\t      ? (frame.tempo.last_emit_ms - AP_CAD_CAPTURE_LAST_EMIT_MS)\n368\t      : 0;\n369\t    AP_CAD_CAPTURE_LAST_EMIT = frame.tempo.emit_count;\n370\t    AP_CAD_CAPTURE_LAST_EMIT_MS = frame.tempo.last_emit_ms;\n371\t  }\n372\t\n373\t  AP_CAD_CAPTURE_BUFFER[AP_CAD_CAPTURE_COUNT++] = ap_cad_make_sample(frame, emitted, emit_delta_ms);\n374\t}\n375\t\n376\tvoid ap_cad_soak_reset() {\n377\t  AP_CAD_SOAK_ACTIVE = false;\n378\t  AP_CAD_SOAK_START_MS = 0;\n379\t  AP_CAD_SOAK_END_MS = 0;\n380\t  AP_CAD_SOAK_FIRST_FRAME_MS = 0;\n381\t  AP_CAD_SOAK_LAST_FRAME_MS = 0;\n382\t  AP_CAD_SOAK_FIRST_EMIT_MS = 0;\n383\t  AP_CAD_SOAK_LAST_EMIT_MS = 0;\n384\t  AP_CAD_SOAK_PREV_FRAME = 0;\n385\t  AP_CAD_SOAK_PREV_FRAME_MS = 0;\n386\t  AP_CAD_SOAK_ROW_COUNT = 0;\n387\t  AP_CAD_SOAK_EMITTED_COUNT = 0;\n388\t  AP_CAD_SOAK_I2S_NOT_OK = 0;\n389\t  AP_CAD_SOAK_BYTES_MISMATCH = 0;\n390\t  AP_CAD_SOAK_FRAME_GAPS = 0;\n391\t  AP_CAD_SOAK_TIMESTAMP_REGRESSIONS = 0;\n392\t  AP_CAD_SOAK_CORE_BAD = 0;\n393\t  AP_CAD_SOAK_ACTIVE_OVER_7500 = 0;\n394\t  AP_CAD_SOAK_EMITTED_ACTIVE_OVER_7500 = 0;\n395\t  AP_CAD_SOAK_ACTIVE_MAX_US = 0;\n396\t  AP_CAD_SOAK_WORST_USED = 0;\n397\t  AP_CAD_SOAK_HAVE_PREV = false;\n398\t  for (uint16_t i = 0; i < AP_CAD_SOAK_HIST_BUCKETS; i++) {\n399\t    AP_CAD_SOAK_ACTIVE_HIST[i] = 0;\n400\t  }\n401\t  K1TempoDebugSnapshot td = k1_tempo_debug_read();\n402\t  AP_CAD_SOAK_LAST_EMIT = td.emit_count;\n403\t  AP_CAD_SOAK_LAST_EMIT_MS = td.last_emit_ms;\n404\t}\n405\t\n406\tbool ap_cad_soak_arm(uint32_t duration_ms) {\n407\t  if (duration_ms == 0 || duration_ms > AP_CAD_SOAK_MAX_MS) {\n408\t    return false;\n409\t  }\n410\t  ap_cad_soak_reset();\n411\t  AP_CAD_SOAK_START_MS = millis();\n412\t  AP_CAD_SOAK_END_MS = AP_CAD_SOAK_START_MS + duration_ms;\n413\t  AP_CAD_SOAK_ACTIVE = true;\n414\t  return true;\n415\t}\n416\t\n417\tvoid ap_cad_soak_record_worst(const APCadenceCaptureSample& sample, uint32_t active_us) {\n418\t  uint16_t insert_at = AP_CAD_SOAK_WORST_USED;\n419\t  if (AP_CAD_SOAK_WORST_USED < AP_CAD_SOAK_WORST_COUNT) {\n420\t    AP_CAD_SOAK_WORST_USED++;\n421\t  } else {\n422\t    uint32_t smallest_us = ap_cad_active_work_us(AP_CAD_SOAK_WORST[0]);\n423\t    insert_at = 0;\n424\t    for (uint16_t i = 1; i < AP_CAD_SOAK_WORST_COUNT; i++) {\n425\t      uint32_t value = ap_cad_active_work_us(AP_CAD_SOAK_WORST[i]);\n426\t      if (value < smallest_us) {\n427\t        smallest_us = value;\n428\t        insert_at = i;\n429\t      }\n430\t    }\n431\t    if (active_us <= smallest_us) {\n432\t      return;\n433\t    }\n434\t  }\n435\t  AP_CAD_SOAK_WORST[insert_at] = sample;\n436\t}\n437\t\n438\tvoid ap_cad_soak_tick(const APCadenceFrameInput& frame) {\n439\t  if (!AP_CAD_SOAK_ACTIVE) {\n440\t    return;\n441\t  }\n442\t  if ((int32_t)(frame.frame_ms - AP_CAD_SOAK_END_MS) >= 0) {\n443\t    AP_CAD_SOAK_ACTIVE = false;\n444\t    return;\n445\t  }\n446\t\n447\t  const bool emitted = frame.tempo.emit_count != AP_CAD_SOAK_LAST_EMIT;\n448\t  uint32_t emit_delta_ms = 0;\n449\t  if (emitted) {\n450\t    emit_delta_ms = (frame.tempo.last_emit_ms >= AP_CAD_SOAK_LAST_EMIT_MS)\n451\t      ? (frame.tempo.last_emit_ms - AP_CAD_SOAK_LAST_EMIT_MS)\n452\t      : 0;\n453\t    if (AP_CAD_SOAK_EMITTED_COUNT == 0) {\n454\t      AP_CAD_SOAK_FIRST_EMIT_MS = frame.tempo.last_emit_ms;\n455\t    }\n456\t    AP_CAD_SOAK_LAST_EMIT = frame.tempo.emit_count;\n457\t    AP_CAD_SOAK_LAST_EMIT_MS = frame.tempo.last_emit_ms;\n458\t    AP_CAD_SOAK_EMITTED_COUNT++;\n459\t  }\n460\t\n461\t  const APCadenceCaptureSample sample = ap_cad_make_sample(frame, emitted, emit_delta_ms);\n462\t  const uint32_t active_us = ap_cad_active_work_us(sample);\n463\t  if (AP_CAD_SOAK_ROW_COUNT == 0) {\n464\t    AP_CAD_SOAK_FIRST_FRAME_MS = frame.frame_ms;\n465\t  }\n466\t  AP_CAD_SOAK_LAST_FRAME_MS = frame.frame_ms;\n467\t  if (AP_CAD_SOAK_HAVE_PREV) {\n468\t    if (frame.frame_index != AP_CAD_SOAK_PREV_FRAME + 1) {\n469\t      AP_CAD_SOAK_FRAME_GAPS++;\n470\t    }\n471\t    if (frame.frame_ms <= AP_CAD_SOAK_PREV_FRAME_MS) {\n472\t      AP_CAD_SOAK_TIMESTAMP_REGRESSIONS++;\n473\t    }\n474\t  }\n475\t  AP_CAD_SOAK_PREV_FRAME = frame.frame_index;\n476\t  AP_CAD_SOAK_PREV_FRAME_MS = frame.frame_ms;\n477\t  AP_CAD_SOAK_HAVE_PREV = true;\n478\t\n479\t  AP_CAD_SOAK_ROW_COUNT++;\n480\t  if ((sample.flags & 0x08) == 0) AP_CAD_SOAK_I2S_NOT_OK++;\n481\t  if ((sample.flags & 0x10) == 0) AP_CAD_SOAK_BYTES_MISMATCH++;\n482\t  if ((sample.flags & 0x20) == 0) AP_CAD_SOAK_CORE_BAD++;\n483\t  if (active_us > 7500UL) {\n484\t    AP_CAD_SOAK_ACTIVE_OVER_7500++;\n485\t    if (emitted) AP_CAD_SOAK_EMITTED_ACTIVE_OVER_7500++;\n486\t  }\n487\t  if (active_us > AP_CAD_SOAK_ACTIVE_MAX_US) {\n488\t    AP_CAD_SOAK_ACTIVE_MAX_US = active_us;\n489\t  }\n490\t  uint16_t bucket = (uint16_t)(active_us / AP_CAD_SOAK_HIST_BUCKET_US);\n491\t  if (bucket >= AP_CAD_SOAK_HIST_BUCKETS) {\n492\t    bucket = AP_CAD_SOAK_HIST_BUCKETS - 1;\n493\t  }\n494\t  AP_CAD_SOAK_ACTIVE_HIST[bucket]++;\n495\t  ap_cad_soak_record_worst(sample, active_us);\n496\t}\n497\t\n498\tuint32_t ap_cad_soak_hist_percentile(uint8_t percentile) {\n499\t  if (AP_CAD_SOAK_ROW_COUNT == 0) {\n500\t    return 0;\n501\t  }\n502\t  uint32_t target = (AP_CAD_SOAK_ROW_COUNT * (uint32_t)percentile + 99UL) / 100UL;\n503\t  if (target == 0) target = 1;\n504\t  uint32_t seen = 0;\n505\t  for (uint16_t i = 0; i < AP_CAD_SOAK_HIST_BUCKETS; i++) {\n506\t    seen += AP_CAD_SOAK_ACTIVE_HIST[i];\n507\t    if (seen >= target) {\n508\t      return ((uint32_t)i + 1UL) * AP_CAD_SOAK_HIST_BUCKET_US;\n509\t    }\n510\t  }\n511\t  return AP_CAD_SOAK_HIST_BUCKETS * AP_CAD_SOAK_HIST_BUCKET_US;\n512\t}\n513\t\n514\tvoid ap_cad_soak_print_worst_sample(uint8_t rank, const APCadenceCaptureSample& sample) {\n515\t  USBSerial.print(\"APCAD_SOAK_WORST,ver=1,rank=\");\n516\t  USBSerial.print(rank);\n517\t  USBSerial.print(\",frame=\");\n518\t  USBSerial.print(sample.frame_index);\n519\t  USBSerial.print(\",t=\");\n520\t  USBSerial.print(sample.frame_ms);\n521\t  USBSerial.print(\",active_us=\");\n522\t  USBSerial.print(ap_cad_active_work_us(sample));\n523\t  USBSerial.print(\",total_us=\");\n524\t  USBSerial.print(sample.total_ap_loop_elapsed_us);\n525\t  USBSerial.print(\",i2s_us=\");\n526\t  USBSerial.print(sample.i2s_read_elapsed_us);\n527\t  USBSerial.print(\",gdft_us=\");\n528\t  USBSerial.print(sample.gdft_elapsed_us);\n529\t  USBSerial.print(\",novelty_us=\");\n530\t  USBSerial.print(sample.novelty_elapsed_us);\n531\t  USBSerial.print(\",tempo_acf_us=\");\n532\t  USBSerial.print(sample.tempo_acf_elapsed_us);\n533\t  USBSerial.print(\",tempo_update_us=\");\n534\t  USBSerial.print(sample.tempo_update_elapsed_us);\n535\t  USBSerial.print(\",tempo_emit_us=\");\n536\t  USBSerial.print(sample.tempo_emit_elapsed_us);\n537\t  USBSerial.print(\",emitted=\");\n538\t  USBSerial.print((sample.flags & 0x01) ? 1 : 0);\n539\t  USBSerial.print(\",acf_spread=\");\n540\t  USBSerial.print((sample.flags & 0x80) ? 1 : 0);\n541\t  USBSerial.print(\",acf_lag_cursor=\");\n542\t  USBSerial.print(sample.acf_lag_cursor);\n543\t  USBSerial.print(\",acf_pub=\");\n544\t  USBSerial.print(sample.acf_publish_count);\n545\t  USBSerial.print(\",win_bpm=\");\n546\t  ap_nov_capture_print_q8_8(sample.winner_bpm_q8_8);\n547\t  USBSerial.print(\",top1_bpm=\");\n548\t  ap_nov_capture_print_q8_8(sample.top1_bpm_q8_8);\n549\t  USBSerial.println();\n550\t}\n551\t\n552\tvoid ap_cad_soak_status() {\n553\t  float measured_ap_hz = 0.0f;\n554\t  float measured_nov_hz = 0.0f;\n555\t  if (AP_CAD_SOAK_ROW_COUNT >= 2 && AP_CAD_SOAK_LAST_FRAME_MS > AP_CAD_SOAK_FIRST_FRAME_MS) {\n556\t    measured_ap_hz = 1000.0f * (float)(AP_CAD_SOAK_ROW_COUNT - 1) /\n557\t      (float)(AP_CAD_SOAK_LAST_FRAME_MS - AP_CAD_SOAK_FIRST_FRAME_MS);\n558\t  }\n559\t  if (AP_CAD_SOAK_EMITTED_COUNT >= 2 && AP_CAD_SOAK_LAST_EMIT_MS > AP_CAD_SOAK_FIRST_EMIT_MS) {\n560\t    measured_nov_hz = 1000.0f * (float)(AP_CAD_SOAK_EMITTED_COUNT - 1) /\n561\t      (float)(AP_CAD_SOAK_LAST_EMIT_MS - AP_CAD_SOAK_FIRST_EMIT_MS);\n562\t  }\n563\t\n564\t  USBSerial.print(\"APCAD_SOAK_DONE,ver=1,active=\");\n565\t  USBSerial.print(AP_CAD_SOAK_ACTIVE ? 1 : 0);\n566\t  USBSerial.print(\",rows=\");\n567\t  USBSerial.print(AP_CAD_SOAK_ROW_COUNT);\n568\t  USBSerial.print(\",emitted=\");\n569\t  USBSerial.print(AP_CAD_SOAK_EMITTED_COUNT);\n570\t  USBSerial.print(\",start_ms=\");\n571\t  USBSerial.print(AP_CAD_SOAK_START_MS);\n572\t  USBSerial.print(\",end_ms=\");\n573\t  USBSerial.print(AP_CAD_SOAK_END_MS);\n574\t  USBSerial.print(\",sample_rate=\");\n575\t  USBSerial.print(CONFIG.SAMPLE_RATE);\n576\t  USBSerial.print(\",samples_per_chunk=\");\n577\t  USBSerial.print(CONFIG.SAMPLES_PER_CHUNK);\n578\t  USBSerial.print(\",tempo_decim=\");\n579\t  USBSerial.print(K1_TEMPO_NOVELTY_DECIMATION);\n580\t  USBSerial.print(\",meas_ap_hz=\");\n581\t  USBSerial.print(measured_ap_hz, 3);\n582\t  USBSerial.print(\",meas_nov_hz=\");\n583\t  USBSerial.print(measured_nov_hz, 3);\n584\t  USBSerial.print(\",i2s_not_ok=\");\n585\t  USBSerial.print(AP_CAD_SOAK_I2S_NOT_OK);\n586\t  USBSerial.print(\",bytes_mismatch=\");\n587\t  USBSerial.print(AP_CAD_SOAK_BYTES_MISMATCH);\n588\t  USBSerial.print(\",frame_gap=\");\n589\t  USBSerial.print(AP_CAD_SOAK_FRAME_GAPS);\n590\t  USBSerial.print(\",timestamp_regression=\");\n591\t  USBSerial.print(AP_CAD_SOAK_TIMESTAMP_REGRESSIONS);\n592\t  USBSerial.print(\",core_bad=\");\n593\t  USBSerial.print(AP_CAD_SOAK_CORE_BAD);\n594\t  USBSerial.print(\",active_over_7500=\");\n595\t  USBSerial.print(AP_CAD_SOAK_ACTIVE_OVER_7500);\n596\t  USBSerial.print(\",emitted_active_over_7500=\");\n597\t  USBSerial.print(AP_CAD_SOAK_EMITTED_ACTIVE_OVER_7500);\n598\t  USBSerial.print(\",active_p95_us=\");\n599\t  USBSerial.print(ap_cad_soak_hist_percentile(95));\n600\t  USBSerial.print(\",active_max_us=\");\n601\t  USBSerial.print(AP_CAD_SOAK_ACTIVE_MAX_US);\n602\t  USBSerial.print(\",worst_count=\");\n603\t  USBSerial.println(AP_CAD_SOAK_WORST_USED);\n604\t\n605\t  for (uint16_t i = 0; i < AP_CAD_SOAK_WORST_USED; i++) {\n606\t    ap_cad_soak_print_worst_sample((uint8_t)i, AP_CAD_SOAK_WORST[i]);\n607\t  }\n608\t}\n609\t\n610\tfloat ap_cad_q8_8_to_float(uint16_t value) {\n611\t  return (float)value / 256.0f;\n612\t}\n613\t\n614\tbool ap_cad_rate_within_2pct(float measured_hz, float declared_hz) {\n615\t  if (measured_hz <= 0.0f || declared_hz <= 0.0f) {\n616\t    return false;\n617\t  }\n618\t  float ratio = measured_hz / declared_hz;\n619\t  if (ratio < 0.0f) ratio = -ratio;\n620\t  float drift = ratio - 1.0f;\n621\t  if (drift < 0.0f) drift = -drift;\n622\t  return drift <= 0.02f;\n623\t}\n624\t\n625\tvoid ap_cad_capture_print_health() {\n626\t  float measured_ap_hz = 0.0f;\n627\t  float measured_nov_hz = 0.0f;\n628\t  uint16_t emitted_rows = 0;\n629\t  uint32_t first_emit_ms = 0;\n630\t  uint32_t last_emit_ms = 0;\n631\t  bool core_ok = (AP_CAD_CAPTURE_COUNT > 0);\n632\t  bool i2s_ok = (AP_CAD_CAPTURE_COUNT > 0);\n633\t  bool bytes_ok = (AP_CAD_CAPTURE_COUNT > 0);\n634\t\n635\t  if (AP_CAD_CAPTURE_COUNT >= 2) {\n636\t    const APCadenceCaptureSample& first = AP_CAD_CAPTURE_BUFFER[0];\n637\t    const APCadenceCaptureSample& last = AP_CAD_CAPTURE_BUFFER[AP_CAD_CAPTURE_COUNT - 1];\n638\t    if (last.frame_ms > first.frame_ms) {\n639\t      measured_ap_hz = 1000.0f * (float)(AP_CAD_CAPTURE_COUNT - 1) / (float)(last.frame_ms - first.frame_ms);\n640\t    }\n641\t  }\n642\t\n643\t  for (uint16_t i = 0; i < AP_CAD_CAPTURE_COUNT; i++) {\n644\t    const APCadenceCaptureSample& sample = AP_CAD_CAPTURE_BUFFER[i];\n645\t    if ((sample.flags & 0x20) == 0) {\n646\t      core_ok = false;\n647\t    }\n648\t    if ((sample.flags & 0x08) == 0) {\n649\t      i2s_ok = false;\n650\t    }\n651\t    if ((sample.flags & 0x10) == 0) {\n652\t      bytes_ok = false;\n653\t    }\n654\t    if ((sample.flags & 0x01) != 0) {\n655\t      if (emitted_rows == 0) {\n656\t        first_emit_ms = sample.emit_ms;\n657\t      }\n658\t      last_emit_ms = sample.emit_ms;\n659\t      emitted_rows++;\n660\t    }\n661\t  }\n662\t  if (emitted_rows >= 2 && last_emit_ms > first_emit_ms) {\n663\t    measured_nov_hz = 1000.0f * (float)(emitted_rows - 1) / (float)(last_emit_ms - first_emit_ms);\n664\t  }\n665\t\n666\t  const APCadenceCaptureSample* ref = (AP_CAD_CAPTURE_COUNT > 0) ? &AP_CAD_CAPTURE_BUFFER[0] : nullptr;\n667\t  const float declared_ap_hz = (ref != nullptr) ? ap_cad_q8_8_to_float(ref->declared_ap_hz_q8_8) : 0.0f;\n668\t  const float declared_nov_hz = (ref != nullptr) ? ap_cad_q8_8_to_float(ref->declared_nov_hz_q8_8) : 0.0f;\n669\t  const bool ap_rate_ok = ap_cad_rate_within_2pct(measured_ap_hz, declared_ap_hz);\n670\t  const bool nov_rate_ok = ap_cad_rate_within_2pct(measured_nov_hz, declared_nov_hz);\n671\t  const bool health_ok = ap_rate_ok && nov_rate_ok && core_ok && i2s_ok && bytes_ok;\n672\t\n673\t  USBSerial.print(\"APCAD_HEALTH,ver=1,health_ok=\");\n674\t  USBSerial.print(health_ok ? 1 : 0);\n675\t  USBSerial.print(\",sample_rate=\");\n676\t  USBSerial.print(ref != nullptr ? ref->sample_rate : 0);\n677\t  USBSerial.print(\",samples_per_chunk=\");\n678\t  USBSerial.print(ref != nullptr ? ref->samples_per_chunk : 0);\n679\t  USBSerial.print(\",tempo_decim=\");\n680\t  USBSerial.print(ref != nullptr ? ref->tempo_decimation : 0);\n681\t  USBSerial.print(\",decl_ap_hz=\");\n682\t  USBSerial.print(declared_ap_hz, 3);\n683\t  USBSerial.print(\",decl_nov_hz=\");\n684\t  USBSerial.print(declared_nov_hz, 3);\n685\t  USBSerial.print(\",meas_ap_hz=\");\n686\t  USBSerial.print(measured_ap_hz, 3);\n687\t  USBSerial.print(\",meas_nov_hz=\");\n688\t  USBSerial.print(measured_nov_hz, 3);\n689\t  USBSerial.print(\",ap_rate_ok=\");\n690\t  USBSerial.print(ap_rate_ok ? 1 : 0);\n691\t  USBSerial.print(\",nov_rate_ok=\");\n692\t  USBSerial.print(nov_rate_ok ? 1 : 0);\n693\t  USBSerial.print(\",core_ok=\");\n694\t  USBSerial.print(core_ok ? 1 : 0);\n695\t  USBSerial.print(\",i2s_ok=\");\n696\t  USBSerial.print(i2s_ok ? 1 : 0);\n697\t  USBSerial.print(\",bytes_ok=\");\n698\t  USBSerial.print(bytes_ok ? 1 : 0);\n699\t  USBSerial.print(\",dma_desc=\");\n700\t  USBSerial.print(ref != nullptr ? ref->dma_desc_num : 0);\n701\t  USBSerial.print(\",ap_core=\");\n702\t  USBSerial.print(ref != nullptr ? ref->ap_core_id : -1);\n703\t  USBSerial.print(\",vp_core=\");\n704\t  USBSerial.println(ref != nullptr ? ref->vp_core_id : -1);\n705\t}\n706\t\n707\tvoid ap_cad_capture_dump() {\n708\t  AP_CAD_CAPTURE_ACTIVE = false;\n709\t  USBSerial.print(\"APCAD_CAPTURE_BEGIN,count=\");\n710\t  USBSerial.print(AP_CAD_CAPTURE_COUNT);\n711\t  USBSerial.print(\",capacity=\");\n712\t  USBSerial.print(AP_CAD_CAPTURE_CAPACITY);\n713\t  USBSerial.print(\",dropped=\");\n714\t  USBSerial.print(AP_CAD_CAPTURE_DROPPED);\n715\t  USBSerial.print(\",start_ms=\");\n716\t  USBSerial.print(AP_CAD_CAPTURE_START_MS);\n717\t  USBSerial.print(\",end_ms=\");\n718\t  USBSerial.println(AP_CAD_CAPTURE_END_MS);\n719\t  ap_cad_capture_print_health();\n720\t  for (uint16_t i = 0; i < AP_CAD_CAPTURE_COUNT; i++) {\n721\t    const APCadenceCaptureSample& sample = AP_CAD_CAPTURE_BUFFER[i];\n722\t    USBSerial.print(\"APCAD,boot_ms=\");\n723\t    USBSerial.print(sample.boot_ms);\n724\t    USBSerial.print(\",frame=\");\n725\t    USBSerial.print(sample.frame_index);\n726\t    USBSerial.print(\",t=\");\n727\t    USBSerial.print(sample.frame_ms);\n728\t    USBSerial.print(\",sample_rate=\");\n729\t    USBSerial.print(sample.sample_rate);\n730\t    USBSerial.print(\",samples_per_chunk=\");\n731\t    USBSerial.print(sample.samples_per_chunk);\n732\t    USBSerial.print(\",slot_bits=\");\n733\t    USBSerial.print(sample.slot_bit_width);\n734\t    USBSerial.print(\",slot_mode=\");\n735\t    USBSerial.print(sample.slot_mode);\n736\t    USBSerial.print(\",dma_desc=\");\n737\t    USBSerial.print(sample.dma_desc_num);\n738\t    USBSerial.print(\",dma_frame=\");\n739\t    USBSerial.print(sample.dma_frame_num);\n740\t    USBSerial.print(\",bytes_req=\");\n741\t    USBSerial.print(sample.bytes_requested);\n742\t    USBSerial.print(\",bytes_read=\");\n743\t    USBSerial.print(sample.bytes_read);\n744\t    USBSerial.print(\",i2s_status=\");\n745\t    USBSerial.print(sample.i2s_status);\n746\t    USBSerial.print(\",stage=\");\n747\t    USBSerial.print(sample.stage);\n748\t    USBSerial.print(\",ap_core=\");\n749\t    USBSerial.print(sample.ap_core_id);\n750\t    USBSerial.print(\",vp_core=\");\n751\t    USBSerial.print(sample.vp_core_id);\n752\t    USBSerial.print(\",i2s_us=\");\n753\t    USBSerial.print(sample.i2s_read_elapsed_us);\n754\t    USBSerial.print(\",gdft_us=\");\n755\t    USBSerial.print(sample.gdft_elapsed_us);\n756\t    USBSerial.print(\",novelty_us=\");\n757\t    USBSerial.print(sample.novelty_elapsed_us);\n758\t    USBSerial.print(\",total_us=\");\n759\t    USBSerial.print(sample.total_ap_loop_elapsed_us);\n760\t    USBSerial.print(\",k1_frame_ctr=\");\n761\t    USBSerial.print(sample.k1_frame_ctr);\n762\t    USBSerial.print(\",tempo_decim=\");\n763\t    USBSerial.print(sample.tempo_decimation);\n764\t    USBSerial.print(\",decl_ap_hz=\");\n765\t    ap_nov_capture_print_q8_8(sample.declared_ap_hz_q8_8);\n766\t    USBSerial.print(\",decl_nov_hz=\");\n767\t    ap_nov_capture_print_q8_8(sample.declared_nov_hz_q8_8);\n768\t    USBSerial.print(\",emit=\");\n769\t    USBSerial.print(sample.emit_count);\n770\t    USBSerial.print(\",emit_ms=\");\n771\t    USBSerial.print(sample.emit_ms);\n772\t    USBSerial.print(\",emit_dt=\");\n773\t    USBSerial.print(sample.emit_delta_ms);\n774\t    USBSerial.print(\",emitted=\");\n775\t    USBSerial.print((sample.flags & 0x01) ? 1 : 0);\n776\t    USBSerial.print(\",nov=\");\n777\t    ap_nov_capture_print_q16(sample.novelty_q16);\n778\t    USBSerial.print(\",nov_scaled=\");\n779\t    ap_nov_capture_print_q8_8(sample.scaled_novelty_q8_8);\n780\t    USBSerial.print(\",win_bpm=\");\n781\t    ap_nov_capture_print_q8_8(sample.winner_bpm_q8_8);\n782\t    USBSerial.print(\",top1_bpm=\");\n783\t    ap_nov_capture_print_q8_8(sample.top1_bpm_q8_8);\n784\t    USBSerial.print(\",v2_ema=\");\n785\t    ap_nov_capture_print_q16(sample.v2_conf_ema_q16);\n786\t    USBSerial.print(\",v2_q=\");\n787\t    ap_nov_capture_print_q16(sample.v2_quality_q16);\n788\t    USBSerial.print(\",v2_h=\");\n789\t    ap_nov_capture_print_q16(sample.v2_hist_share_q16);\n790\t    USBSerial.print(\",v2_pr=\");\n791\t    ap_nov_capture_print_q16(sample.v2_prominence_q16);\n792\t    USBSerial.print(\",v2_per=\");\n793\t    ap_nov_capture_print_q16(sample.v2_periodicity_q16);\n794\t    USBSerial.print(\",v2_ps=\");\n795\t    ap_nov_capture_print_q16(sample.v2_peak_share_q16);\n796\t    USBSerial.print(\",tempo_silence_us=\");\n797\t    USBSerial.print(sample.tempo_silence_elapsed_us);\n798\t    USBSerial.print(\",tempo_acf_us=\");\n799\t    USBSerial.print(sample.tempo_acf_elapsed_us);\n800\t    USBSerial.print(\",tempo_update_us=\");\n801\t    USBSerial.print(sample.tempo_update_elapsed_us);\n802\t    USBSerial.print(\",tempo_phase_us=\");\n803\t    USBSerial.print(sample.tempo_phase_elapsed_us);\n804\t    USBSerial.print(\",tempo_publish_us=\");\n805\t    USBSerial.print(sample.tempo_publish_elapsed_us);\n806\t    USBSerial.print(\",tempo_emit_us=\");\n807\t    USBSerial.print(sample.tempo_emit_elapsed_us);\n808\t    USBSerial.print(\",acf_spread=\");\n809\t    USBSerial.print((sample.flags & 0x80) ? 1 : 0);\n810\t    USBSerial.print(\",acf_lag_cursor=\");\n811\t    USBSerial.print(sample.acf_lag_cursor);\n812\t    USBSerial.print(\",acf_pub=\");\n813\t    USBSerial.print(sample.acf_publish_count);\n814\t    USBSerial.print(\",v2_lock=\");\n815\t    USBSerial.print((sample.flags & 0x40) ? 1 : 0);\n816\t    USBSerial.print(\",sil=\");\n817\t    USBSerial.print((sample.flags & 0x02) ? 1 : 0);\n818\t    USBSerial.print(\",acf=\");\n819\t    USBSerial.print((sample.flags & 0x04) ? 1 : 0);\n820\t    USBSerial.print(\",i2s_ok=\");\n821\t    USBSerial.print((sample.flags & 0x08) ? 1 : 0);\n822\t    USBSerial.print(\",bytes_ok=\");\n823\t    USBSerial.print((sample.flags & 0x10) ? 1 : 0);\n824\t    USBSerial.print(\",core_ok=\");\n825\t    USBSerial.print((sample.flags & 0x20) ? 1 : 0);\n826\t    USBSerial.println(\",src=buf\");\n827\t    if ((i & 0x0F) == 0x0F) {\n828\t      vTaskDelay(1);\n829\t    }\n830\t  }\n831\t  USBSerial.print(\"APCAD_CAPTURE_DONE,count=\");\n832\t  USBSerial.print(AP_CAD_CAPTURE_COUNT);\n833\t  USBSerial.print(\",dropped=\");\n834\t  USBSerial.println(AP_CAD_CAPTURE_DROPPED);\n835\t}\n836\t\n837\t// ---------------------------------------------------------------------------\n838\t// serial_diag_ap_dispatch — lifted verbatim from parse_command() Stage-B ladder.\n839\t// Handles the 11 AP-frontend-debug handlers (ENABLE_TEMPO_STREAM && ENABLE_AP_FRONTEND_DEBUG).\n840\t// tempo_stream is NOT here — it is ENABLE_TEMPO_STREAM-only (a broader gate) and\n841\t// stays inline in serial_menu.h so this dispatcher straddles a single gate level.\n842\t// The `if (false) {}` opener keeps every real branch as `else if (strcmp(...))`,\n843\t// statement-identical to the serial_menu.h@HEAD source. Returns true iff handled.\n844\t// ---------------------------------------------------------------------------\n845\tbool serial_diag_ap_dispatch(const char* command_type, char* command_data) {\n846\t    if (false) {}\n847\t\n848\t#if ENABLE_TEMPO_STREAM && ENABLE_AP_FRONTEND_DEBUG\n849\t    else if (strcmp(command_type, \"ap_frontend_debug\") == 0 || strcmp(command_type, \"apdbg\") == 0) {\n850\t      bool value = false;\n851\t      if (vp_parse_bool(command_data, &value)) {\n852\t        AP_FRONTEND_DEBUG_ENABLED = value;\n853\t        tx_begin();\n854\t        USBSerial.print(\"AP_FRONTEND_DEBUG: \");\n855\t        USBSerial.println(vp_bool_text(AP_FRONTEND_DEBUG_ENABLED));\n856\t        tx_end();\n857\t      } else {\n858\t        bad_command(command_type, command_data);\n859\t      }\n860\t    }\n861\t\n862\t    else if (strcmp(command_type, \"nov_capture\") == 0) {\n863\t      long ms = (command_data && command_data[0]) ? atol(command_data) : 0;\n864\t      if (ms > 0 && (uint32_t)ms <= AP_NOV_CAPTURE_MAX_MS && ap_nov_capture_arm((uint32_t)ms)) {\n865\t        tx_begin();\n866\t        USBSerial.print(\"NOV_CAPTURE: armed \");\n867\t        USBSerial.print(ms);\n868\t        USBSerial.print(\" ms capacity=\");\n869\t        USBSerial.println(AP_NOV_CAPTURE_CAPACITY);\n870\t        tx_end();\n871\t      } else {\n872\t        bad_command(command_type, command_data);\n873\t      }\n874\t    }\n875\t\n876\t    else if (strcmp(command_type, \"nov_dump\") == 0) {\n877\t      bool value = false;\n878\t      if (vp_parse_bool(command_data, &value) && value) {\n879\t        ap_nov_capture_dump();\n880\t      } else {\n881\t        bad_command(command_type, command_data);\n882\t      }\n883\t    }\n884\t\n885\t#ifdef ENABLE_K1EV_STREAM\n886\t    else if (strcmp(command_type, \"k1ev_dump\") == 0) {\n887\t      bool value = false;\n888\t      if (vp_parse_bool(command_data, &value) && value) {\n889\t        k1ev_capture_dump();   // decoupled [K1EV] dump: orchestrator sends `k1ev_dump=1` AFTER the nov flow\n890\t      } else {\n891\t        bad_command(command_type, command_data);\n892\t      }\n893\t    }\n894\t#endif\n895\t\n896\t    else if (strcmp(command_type, \"nov_clear\") == 0) {\n897\t      bool value = false;\n898\t      if (vp_parse_bool(command_data, &value) && value) {\n899\t        ap_nov_capture_clear();\n900\t        ap_nov_capture_status();\n901\t      } else {\n902\t        bad_command(command_type, command_data);\n903\t      }\n904\t    }\n905\t\n906\t    else if (strcmp(command_type, \"nov_status\") == 0) {\n907\t      bool value = false;\n908\t      if (vp_parse_bool(command_data, &value) && value) {\n909\t        ap_nov_capture_status();\n910\t      } else {\n911\t        bad_command(command_type, command_data);\n912\t      }\n913\t    }\n914\t\n915\t    else if (strcmp(command_type, \"apcad_capture\") == 0) {\n916\t      long ms = (command_data && command_data[0]) ? atol(command_data) : 0;\n917\t      if (ms > 0 && (uint32_t)ms <= AP_CAD_CAPTURE_MAX_MS && ap_cad_capture_arm((uint32_t)ms)) {\n918\t        tx_begin();\n919\t        USBSerial.print(\"APCAD_CAPTURE: armed \");\n920\t        USBSerial.print(ms);\n921\t        USBSerial.print(\" ms capacity=\");\n922\t        USBSerial.println(AP_CAD_CAPTURE_CAPACITY);\n923\t        tx_end();\n924\t      } else {\n925\t        bad_command(command_type, command_data);\n926\t      }\n927\t    }\n928\t\n929\t    else if (strcmp(command_type, \"apcad_dump\") == 0) {\n930\t      bool value = false;\n931\t      if (vp_parse_bool(command_data, &value) && value) {\n932\t        ap_cad_capture_dump();\n933\t      } else {\n934\t        bad_command(command_type, command_data);\n935\t      }\n936\t    }\n937\t\n938\t    else if (strcmp(command_type, \"apcad_clear\") == 0) {\n939\t      bool value = false;\n940\t      if (vp_parse_bool(command_data, &value) && value) {\n941\t        ap_cad_capture_clear();\n942\t        ap_cad_capture_status();\n943\t      } else {\n944\t        bad_command(command_type, command_data);\n945\t      }\n946\t    }\n947\t\n948\t    else if (strcmp(command_type, \"apcad_status\") == 0) {\n949\t      bool value = false;\n950\t      if (vp_parse_bool(command_data, &value) && value) {\n951\t        ap_cad_capture_status();\n952\t      } else {\n953\t        bad_command(command_type, command_data);\n954\t      }\n955\t    }\n956\t\n957\t    else if (strcmp(command_type, \"apcad_soak\") == 0) {\n958\t      long ms = (command_data && command_data[0]) ? atol(command_data) : 0;\n959\t      if (ms > 0 && (uint32_t)ms <= AP_CAD_SOAK_MAX_MS && ap_cad_soak_arm((uint32_t)ms)) {\n960\t        tx_begin();\n961\t        USBSerial.print(\"APCAD_SOAK: armed \");\n962\t        USBSerial.print(ms);\n963\t        USBSerial.println(\" ms compact=1\");\n964\t        tx_end();\n965\t      } else {\n966\t        bad_command(command_type, command_data);\n967\t      }\n968\t    }\n969\t\n970\t    else if (strcmp(command_type, \"apcad_soak_status\") == 0) {\n971\t      bool value = false;\n972\t      if (vp_parse_bool(command_data, &value) && value) {\n973\t        ap_cad_soak_status();\n974\t      } else {\n975\t        bad_command(command_type, command_data);\n976\t      }\n977\t    }\n978\t\n979\t    else if (strcmp(command_type, \"apcad_abort\") == 0) {\n980\t      bool value = false;\n981\t      if (vp_parse_bool(command_data, &value) && value) {\n982\t        AP_CAD_CAPTURE_ACTIVE = false;\n983\t        AP_CAD_SOAK_ACTIVE = false;\n984\t        tx_begin();\n985\t        USBSerial.println(\"APCAD_ABORT: stopped\");\n986\t        tx_end();\n987\t      } else {\n988\t        bad_command(command_type, command_data);\n989\t      }\n990\t    }\n991\t#endif  // ENABLE_TEMPO_STREAM && ENABLE_AP_FRONTEND_DEBUG\n992\t\n993\t    else {\n994\t      return false;  // not a diag-AP handler — let parse_command's ladder continue\n995\t    }\n996\t\n997\t    return true;\n998\t}\n999\t\n1000\t#endif  // ENABLE_TEMPO_STREAM && ENABLE_AP_FRONTEND_DEBUG\n1001\t"}]},"parent_tool_use_id":null,"session_id":"16a76e6c-f56d-436e-9309-aa9c7ce3989f","uuid":"baa9bbf7-08c2-4850-b117-ec8bfd6f82c7","timestamp":"2026-07-15T20:24:53.067Z","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/k1-ruflo-live/SPECTRASYNQ_K1_FIRMWARE/serial/k1_ap_capture_telemetry.cpp","content":"/*----------------------------------------\n  K1 AP CAPTURE / TELEMETRY (diagnostics) — implementation\n  ----------------------------------------\n  Bodies lifted verbatim from serial_menu.h (Phase A Lane 2, S1). The whole\n  unit is gated on `ENABLE_TEMPO_STREAM && ENABLE_AP_FRONTEND_DEBUG`, set only\n  in the non-shippable probe envs, so this TU compiles to NOTHING in\n  production. The capture buffers/counters (formerly file-scope `static` in the\n  single-include serial_menu.h) are defined here with external linkage and\n  declared `extern` in the header, so the call sites remaining in serial_menu.h\n  reference the same storage.\n*/\n\n// Gate FIRST, BEFORE any #include. In production (k1_hardware) the probe gate\n// is OFF, so this TU preprocesses to NOTHING — no \"globals.h\" pull-in, hence no\n// static-initialiser constructor (`_GLOBAL__sub_I_…`) added to the production\n// link. (Including the header unconditionally added +160 B of global-ctor code\n// to k1_hardware even with the body gated out — globals.h declares\n// non-trivially-constructed globals whose guard inits emit per-TU.)\n#if ENABLE_TEMPO_STREAM && ENABLE_AP_FRONTEND_DEBUG\n\n#include \"k1_ap_capture_telemetry.h\"\n#include \"serial_parse_helpers.h\"   // vp_parse_bool\n#include \"k1ev_capture.h\"           // buffered [K1EV] capture (piggybacked arm/dump; no-op unless ENABLE_K1EV_STREAM)\n#include <stdlib.h>                 // atol\n#include <string.h>                 // strcmp\n\n// ---- Capture state (external linkage; initialisers verbatim from serial_menu.h)\nbool AP_FRONTEND_DEBUG_ENABLED = false;\nAPNovCaptureSample AP_NOV_CAPTURE_BUFFER[AP_NOV_CAPTURE_CAPACITY];\nuint16_t AP_NOV_CAPTURE_COUNT = 0;\nuint32_t AP_NOV_CAPTURE_DROPPED = 0;\nuint32_t AP_NOV_CAPTURE_START_MS = 0;\nuint32_t AP_NOV_CAPTURE_END_MS = 0;\nuint32_t AP_NOV_CAPTURE_LAST_EMIT = 0;\nbool AP_NOV_CAPTURE_ACTIVE = false;\nAPCadenceCaptureSample* AP_CAD_CAPTURE_BUFFER = nullptr;\nuint16_t AP_CAD_CAPTURE_COUNT = 0;\nuint32_t AP_CAD_CAPTURE_DROPPED = 0;\nuint32_t AP_CAD_CAPTURE_START_MS = 0;\nuint32_t AP_CAD_CAPTURE_END_MS = 0;\nuint32_t AP_CAD_CAPTURE_LAST_EMIT = 0;\nuint32_t AP_CAD_CAPTURE_LAST_EMIT_MS = 0;\nbool AP_CAD_CAPTURE_ACTIVE = false;\nbool AP_CAD_CAPTURE_ALLOC_FAILED = false;\nbool AP_CAD_SOAK_ACTIVE = false;\nuint32_t AP_CAD_SOAK_START_MS = 0;\nuint32_t AP_CAD_SOAK_END_MS = 0;\nuint32_t AP_CAD_SOAK_FIRST_FRAME_MS = 0;\nuint32_t AP_CAD_SOAK_LAST_FRAME_MS = 0;\nuint32_t AP_CAD_SOAK_FIRST_EMIT_MS = 0;\nuint32_t AP_CAD_SOAK_LAST_EMIT_MS = 0;\nuint32_t AP_CAD_SOAK_LAST_EMIT = 0;\nuint32_t AP_CAD_SOAK_PREV_FRAME = 0;\nuint32_t AP_CAD_SOAK_PREV_FRAME_MS = 0;\nuint32_t AP_CAD_SOAK_ROW_COUNT = 0;\nuint32_t AP_CAD_SOAK_EMITTED_COUNT = 0;\nuint32_t AP_CAD_SOAK_I2S_NOT_OK = 0;\nuint32_t AP_CAD_SOAK_BYTES_MISMATCH = 0;\nuint32_t AP_CAD_SOAK_FRAME_GAPS = 0;\nuint32_t AP_CAD_SOAK_TIMESTAMP_REGRESSIONS = 0;\nuint32_t AP_CAD_SOAK_CORE_BAD = 0;\nuint32_t AP_CAD_SOAK_ACTIVE_OVER_7500 = 0;\nuint32_t AP_CAD_SOAK_EMITTED_ACTIVE_OVER_7500 = 0;\nuint32_t AP_CAD_SOAK_ACTIVE_MAX_US = 0;\nuint16_t AP_CAD_SOAK_WORST_USED = 0;\nbool AP_CAD_SOAK_HAVE_PREV = false;\nAPCadenceCaptureSample AP_CAD_SOAK_WORST[AP_CAD_SOAK_WORST_COUNT];\nuint32_t AP_CAD_SOAK_ACTIVE_HIST[AP_CAD_SOAK_HIST_BUCKETS];\n\n// ---- Capture handlers (verbatim from serial_menu.h 644-1397) ---------------\nuint16_t ap_nov_capture_q16(float value) {\n  if (!isfinite(value) || value <= 0.0f) {\n    return 0;\n  }\n  if (value >= 1.0f) {\n    return 65535U;\n  }\n  return (uint16_t)(value * 65535.0f + 0.5f);\n}\n\nuint16_t ap_nov_capture_q8_8(float value) {\n  if (!isfinite(value) || value <= 0.0f) {\n    return 0;\n  }\n  if (value >= 255.996f) {\n    return 65535U;\n  }\n  return (uint16_t)(value * 256.0f + 0.5f);\n}\n\nvoid ap_nov_capture_print_q16(uint16_t value) {\n  USBSerial.print((float)value / 65535.0f, 5);\n}\n\nvoid ap_nov_capture_print_q8_8(uint16_t value) {\n  USBSerial.print((float)value / 256.0f, 5);\n}\n\nvoid ap_nov_capture_status() {\n  tx_begin();\n  USBSerial.print(\"NOV_CAPTURE: active=\");\n  USBSerial.print(vp_bool_text(AP_NOV_CAPTURE_ACTIVE));\n  USBSerial.print(\" count=\");\n  USBSerial.print(AP_NOV_CAPTURE_COUNT);\n  USBSerial.print(\" capacity=\");\n  USBSerial.print(AP_NOV_CAPTURE_CAPACITY);\n  USBSerial.print(\" dropped=\");\n  USBSerial.print(AP_NOV_CAPTURE_DROPPED);\n  USBSerial.print(\" start_ms=\");\n  USBSerial.print(AP_NOV_CAPTURE_START_MS);\n  USBSerial.print(\" end_ms=\");\n  USBSerial.println(AP_NOV_CAPTURE_END_MS);\n  tx_end();\n}\n\nvoid ap_nov_capture_clear() {\n  AP_NOV_CAPTURE_ACTIVE = false;\n  AP_NOV_CAPTURE_COUNT = 0;\n  AP_NOV_CAPTURE_DROPPED = 0;\n  AP_NOV_CAPTURE_START_MS = 0;\n  AP_NOV_CAPTURE_END_MS = 0;\n  AP_NOV_CAPTURE_LAST_EMIT = k1_tempo_debug_read().emit_count;\n}\n\nbool ap_nov_capture_arm(uint32_t duration_ms) {\n  if (duration_ms == 0 || duration_ms > AP_NOV_CAPTURE_MAX_MS) {\n    return false;\n  }\n  AP_NOV_CAPTURE_COUNT = 0;\n  AP_NOV_CAPTURE_DROPPED = 0;\n  AP_NOV_CAPTURE_START_MS = millis();\n  AP_NOV_CAPTURE_END_MS = AP_NOV_CAPTURE_START_MS + duration_ms;\n  AP_NOV_CAPTURE_LAST_EMIT = k1_tempo_debug_read().emit_count;\n  AP_NOV_CAPTURE_ACTIVE = true;\n#ifdef ENABLE_K1EV_STREAM\n  // Piggyback: the same duration arms the buffered [K1EV] capture, so the existing\n  // `nov_capture=<ms>` serial command (device_novelty_buffer_capture.py) drives both\n  // with no new command and no tool edit. Non-fatal if the k1ev PSRAM alloc fails.\n  k1ev_capture_arm(duration_ms);\n#endif\n  return true;\n}\n\nvoid ap_nov_capture_tick(uint32_t t_now, const K1TempoDebugSnapshot& td) {\n  if (!AP_NOV_CAPTURE_ACTIVE) {\n    return;\n  }\n  if ((int32_t)(t_now - AP_NOV_CAPTURE_END_MS) >= 0) {\n    AP_NOV_CAPTURE_ACTIVE = false;\n    return;\n  }\n  if (td.emit_count == AP_NOV_CAPTURE_LAST_EMIT) {\n    return;\n  }\n  AP_NOV_CAPTURE_LAST_EMIT = td.emit_count;\n  if (AP_NOV_CAPTURE_COUNT >= AP_NOV_CAPTURE_CAPACITY) {\n    AP_NOV_CAPTURE_DROPPED++;\n    return;\n  }\n\n  APNovCaptureSample& sample = AP_NOV_CAPTURE_BUFFER[AP_NOV_CAPTURE_COUNT++];\n  sample.t_ms = td.last_emit_ms;\n  sample.emit_count = td.emit_count;\n  sample.novelty_q16 = ap_nov_capture_q16(td.last_novelty);\n  sample.scaled_novelty_q8_8 = ap_nov_capture_q8_8(td.last_scaled_novelty);\n  sample.scale_q8_8 = ap_nov_capture_q8_8(td.novelty_scale);\n  sample.flags = (td.silence_detected ? 0x01 : 0x00) | (td.acf_valid ? 0x02 : 0x00);\n  sample.reserved = 0;\n}\n\nvoid ap_nov_capture_dump() {\n  // NOTE: the [K1EV] buffered dump is DELIBERATELY NOT emitted here. Injecting the\n  // large k1ev block into this stream corrupts the capture tool's NOV/APCAD parse\n  // (device_novelty_buffer_capture.py expects a clean NOV dump). The k1ev buffer is\n  // dumped out-of-band by the decoupled `k1ev_dump=1` command (serial_diag_ap_dispatch),\n  // which an orchestrator sends AFTER the tool's capture completes, when serial is quiet.\n  AP_NOV_CAPTURE_ACTIVE = false;\n  USBSerial.print(\"NOV_CAPTURE_BEGIN,count=\");\n  USBSerial.print(AP_NOV_CAPTURE_COUNT);\n  USBSerial.print(\",capacity=\");\n  USBSerial.print(AP_NOV_CAPTURE_CAPACITY);\n  USBSerial.print(\",dropped=\");\n  USBSerial.print(AP_NOV_CAPTURE_DROPPED);\n  USBSerial.print(\",start_ms=\");\n  USBSerial.print(AP_NOV_CAPTURE_START_MS);\n  USBSerial.print(\",end_ms=\");\n  USBSerial.println(AP_NOV_CAPTURE_END_MS);\n  for (uint16_t i = 0; i < AP_NOV_CAPTURE_COUNT; i++) {\n    const APNovCaptureSample& sample = AP_NOV_CAPTURE_BUFFER[i];\n    USBSerial.print(\"NOV,t=\");\n    USBSerial.print(sample.t_ms);\n    USBSerial.print(\",emit=\");\n    USBSerial.print(sample.emit_count);\n    USBSerial.print(\",nov=\");\n    ap_nov_capture_print_q16(sample.novelty_q16);\n    USBSerial.print(\",nov_scaled=\");\n    ap_nov_capture_print_q8_8(sample.scaled_novelty_q8_8);\n    USBSerial.print(\",scale=\");\n    ap_nov_capture_print_q8_8(sample.scale_q8_8);\n    USBSerial.print(\",sil=\");\n    USBSerial.print((sample.flags & 0x01) ? 1 : 0);\n    USBSerial.print(\",acf=\");\n    USBSerial.print((sample.flags & 0x02) ? 1 : 0);\n    USBSerial.println(\",src=buf\");\n  }\n  USBSerial.print(\"NOV_CAPTURE_DONE,count=\");\n  USBSerial.print(AP_NOV_CAPTURE_COUNT);\n  USBSerial.print(\",dropped=\");\n  USBSerial.println(AP_NOV_CAPTURE_DROPPED);\n}\n\nuint16_t ap_capture_u16_sat(uint32_t value) {\n  return value > 0xFFFFUL ? 0xFFFFU : (uint16_t)value;\n}\n\nint16_t ap_capture_i16_sat(int32_t value) {\n  if (value > 32767L) return 32767;\n  if (value < -32768L) return -32768;\n  return (int16_t)value;\n}\n\nbool ap_cad_capture_ensure_buffer() {\n  AP_CAD_CAPTURE_ALLOC_FAILED = false;\n  if (AP_CAD_CAPTURE_BUFFER != nullptr) {\n    return true;\n  }\n  AP_CAD_CAPTURE_BUFFER = (APCadenceCaptureSample*)heap_caps_malloc(\n    sizeof(APCadenceCaptureSample) * AP_CAD_CAPTURE_CAPACITY,\n    MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);\n  if (AP_CAD_CAPTURE_BUFFER == nullptr) {\n    AP_CAD_CAPTURE_BUFFER = (APCadenceCaptureSample*)heap_caps_malloc(\n      sizeof(APCadenceCaptureSample) * AP_CAD_CAPTURE_CAPACITY,\n      MALLOC_CAP_8BIT);\n  }\n  AP_CAD_CAPTURE_ALLOC_FAILED = (AP_CAD_CAPTURE_BUFFER == nullptr);\n  return !AP_CAD_CAPTURE_ALLOC_FAILED;\n}\n\nvoid ap_cad_capture_status() {\n  tx_begin();\n  USBSerial.print(\"APCAD_CAPTURE: active=\");\n  USBSerial.print(vp_bool_text(AP_CAD_CAPTURE_ACTIVE));\n  USBSerial.print(\" count=\");\n  USBSerial.print(AP_CAD_CAPTURE_COUNT);\n  USBSerial.print(\" capacity=\");\n  USBSerial.print(AP_CAD_CAPTURE_CAPACITY);\n  USBSerial.print(\" dropped=\");\n  USBSerial.print(AP_CAD_CAPTURE_DROPPED);\n  USBSerial.print(\" start_ms=\");\n  USBSerial.print(AP_CAD_CAPTURE_START_MS);\n  USBSerial.print(\" end_ms=\");\n  USBSerial.print(AP_CAD_CAPTURE_END_MS);\n  USBSerial.print(\" alloc=\");\n  USBSerial.println(AP_CAD_CAPTURE_ALLOC_FAILED ? \"fail\" : (AP_CAD_CAPTURE_BUFFER ? \"ok\" : \"none\"));\n  tx_end();\n}\n\nvoid ap_cad_capture_clear() {\n  AP_CAD_CAPTURE_ACTIVE = false;\n  AP_CAD_CAPTURE_COUNT = 0;\n  AP_CAD_CAPTURE_DROPPED = 0;\n  AP_CAD_CAPTURE_START_MS = 0;\n  AP_CAD_CAPTURE_END_MS = 0;\n  K1TempoDebugSnapshot td = k1_tempo_debug_read();\n  AP_CAD_CAPTURE_LAST_EMIT = td.emit_count;\n  AP_CAD_CAPTURE_LAST_EMIT_MS = td.last_emit_ms;\n}\n\nbool ap_cad_capture_arm(uint32_t duration_ms) {\n  if (duration_ms == 0 || duration_ms > AP_CAD_CAPTURE_MAX_MS) {\n    return false;\n  }\n  if (!ap_cad_capture_ensure_buffer()) {\n    return false;\n  }\n  AP_CAD_CAPTURE_COUNT = 0;\n  AP_CAD_CAPTURE_DROPPED = 0;\n  AP_CAD_CAPTURE_START_MS = millis();\n  AP_CAD_CAPTURE_END_MS = AP_CAD_CAPTURE_START_MS + duration_ms;\n  K1TempoDebugSnapshot td = k1_tempo_debug_read();\n  AP_CAD_CAPTURE_LAST_EMIT = td.emit_count;\n  AP_CAD_CAPTURE_LAST_EMIT_MS = td.last_emit_ms;\n  AP_CAD_CAPTURE_ACTIVE = true;\n  return true;\n}\n\nAPCadenceCaptureSample ap_cad_make_sample(const APCadenceFrameInput& frame, bool emitted, uint32_t emit_delta_ms) {\n  APCadenceCaptureSample sample = {};\n  sample.boot_ms = frame.boot_ms;\n  sample.frame_index = frame.frame_index;\n  sample.frame_ms = frame.frame_ms;\n  sample.emit_count = frame.tempo.emit_count;\n  sample.emit_ms = frame.tempo.last_emit_ms;\n  sample.i2s_read_elapsed_us = frame.i2s.elapsed_us;\n  sample.gdft_elapsed_us = frame.gdft_elapsed_us;\n  sample.novelty_elapsed_us = frame.novelty_elapsed_us;\n  sample.total_ap_loop_elapsed_us = frame.total_ap_loop_elapsed_us;\n  sample.stage = frame.stage;\n  sample.sample_rate = ap_capture_u16_sat(CONFIG.SAMPLE_RATE);\n  sample.samples_per_chunk = ap_capture_u16_sat(CONFIG.SAMPLES_PER_CHUNK);\n  sample.dma_frame_num = ap_capture_u16_sat(CONFIG.SAMPLES_PER_CHUNK);\n  sample.bytes_requested = ap_capture_u16_sat(frame.i2s.bytes_requested);\n  sample.bytes_read = ap_capture_u16_sat(frame.i2s.bytes_read);\n  sample.emit_delta_ms = ap_capture_u16_sat(emit_delta_ms);\n  sample.declared_ap_hz_q8_8 = ap_nov_capture_q8_8(frame.tempo.declared_ap_frame_hz);\n  sample.declared_nov_hz_q8_8 = ap_nov_capture_q8_8(frame.tempo.declared_novelty_rate_hz);\n  sample.novelty_q16 = ap_nov_capture_q16(frame.tempo.last_novelty);\n  sample.scaled_novelty_q8_8 = ap_nov_capture_q8_8(frame.tempo.last_scaled_novelty);\n  sample.winner_bpm_q8_8 = ap_nov_capture_q8_8(frame.tempo.winner_bpm);\n  sample.top1_bpm_q8_8 = ap_nov_capture_q8_8(frame.tempo.top1_bpm);\n  sample.v2_conf_ema_q16 = ap_nov_capture_q16(frame.tempo.v2_conf_ema);\n  sample.v2_quality_q16 = ap_nov_capture_q16(frame.tempo.v2_quality);\n  sample.v2_hist_share_q16 = ap_nov_capture_q16(frame.tempo.v2_hist_share_norm);\n  sample.v2_prominence_q16 = ap_nov_capture_q16(frame.tempo.v2_prominence);\n  sample.v2_periodicity_q16 = ap_nov_capture_q16(frame.tempo.v2_periodicity);\n  sample.v2_peak_share_q16 = ap_nov_capture_q16(frame.tempo.v2_peak_share);\n  sample.tempo_silence_elapsed_us = ap_capture_u16_sat(frame.tempo.silence_elapsed_us);\n  sample.tempo_acf_elapsed_us = ap_capture_u16_sat(frame.tempo.acf_elapsed_us);\n  sample.tempo_update_elapsed_us = ap_capture_u16_sat(frame.tempo.update_elapsed_us);\n  sample.tempo_phase_elapsed_us = ap_capture_u16_sat(frame.tempo.phase_elapsed_us);\n  sample.tempo_publish_elapsed_us = ap_capture_u16_sat(frame.tempo.publish_elapsed_us);\n  sample.tempo_emit_elapsed_us = ap_capture_u16_sat(frame.tempo.emit_elapsed_us);\n  sample.acf_lag_cursor = ap_capture_u16_sat(frame.tempo.acf_lag_cursor);\n  sample.acf_publish_count = frame.tempo.acf_publish_count;\n  sample.i2s_status = ap_capture_i16_sat(frame.i2s.status);\n  sample.ap_core_id = frame.ap_core_id;\n  sample.vp_core_id = frame.vp_core_id;\n  sample.slot_bit_width = K1_I2S_SLOT_BIT_WIDTH_BITS;\n  sample.slot_mode = K1_I2S_SLOT_MODE_STEREO;\n  sample.dma_desc_num = K1_I2S_DMA_DESC_NUM;\n  sample.k1_frame_ctr = (uint8_t)frame.tempo.frame_ctr;\n  sample.tempo_decimation = (uint8_t)frame.tempo.novelty_decimation;\n  sample.flags = (emitted ? 0x01 : 0x00)\n    | (frame.tempo.silence_detected ? 0x02 : 0x00)\n    | (frame.tempo.acf_valid ? 0x04 : 0x00)\n    | (frame.i2s.status == 0 ? 0x08 : 0x00)\n    | (frame.i2s.bytes_read == frame.i2s.bytes_requested ? 0x10 : 0x00)\n    | ((frame.ap_core_id >= 0 && frame.vp_core_id >= 0 && frame.ap_core_id != frame.vp_core_id) ? 0x20 : 0x00)\n    | (frame.tempo.v2_locked ? 0x40 : 0x00)\n    | (frame.tempo.acf_spread_active ? 0x80 : 0x00);\n  return sample;\n}\n\nuint32_t ap_cad_active_work_us(const APCadenceCaptureSample& sample) {\n  return (sample.total_ap_loop_elapsed_us >= sample.i2s_read_elapsed_us)\n    ? (sample.total_ap_loop_elapsed_us - sample.i2s_read_elapsed_us)\n    : sample.total_ap_loop_elapsed_us;\n}\n\nvoid ap_cad_capture_tick(const APCadenceFrameInput& frame) {\n  if (!AP_CAD_CAPTURE_ACTIVE) {\n    return;\n  }\n  if ((int32_t)(frame.frame_ms - AP_CAD_CAPTURE_END_MS) >= 0) {\n    AP_CAD_CAPTURE_ACTIVE = false;\n    return;\n  }\n  if (AP_CAD_CAPTURE_BUFFER == nullptr || AP_CAD_CAPTURE_COUNT >= AP_CAD_CAPTURE_CAPACITY) {\n    AP_CAD_CAPTURE_DROPPED++;\n    return;\n  }\n\n  const bool emitted = frame.tempo.emit_count != AP_CAD_CAPTURE_LAST_EMIT;\n  uint32_t emit_delta_ms = 0;\n  if (emitted) {\n    emit_delta_ms = (frame.tempo.last_emit_ms >= AP_CAD_CAPTURE_LAST_EMIT_MS)\n      ? (frame.tempo.last_emit_ms - AP_CAD_CAPTURE_LAST_EMIT_MS)\n      : 0;\n    AP_CAD_CAPTURE_LAST_EMIT = frame.tempo.emit_count;\n    AP_CAD_CAPTURE_LAST_EMIT_MS = frame.tempo.last_emit_ms;\n  }\n\n  AP_CAD_CAPTURE_BUFFER[AP_CAD_CAPTURE_COUNT++] = ap_cad_make_sample(frame, emitted, emit_delta_ms);\n}\n\nvoid ap_cad_soak_reset() {\n  AP_CAD_SOAK_ACTIVE = false;\n  AP_CAD_SOAK_START_MS = 0;\n  AP_CAD_SOAK_END_MS = 0;\n  AP_CAD_SOAK_FIRST_FRAME_MS = 0;\n  AP_CAD_SOAK_LAST_FRAME_MS = 0;\n  AP_CAD_SOAK_FIRST_EMIT_MS = 0;\n  AP_CAD_SOAK_LAST_EMIT_MS = 0;\n  AP_CAD_SOAK_PREV_FRAME = 0;\n  AP_CAD_SOAK_PREV_FRAME_MS = 0;\n  AP_CAD_SOAK_ROW_COUNT = 0;\n  AP_CAD_SOAK_EMITTED_COUNT = 0;\n  AP_CAD_SOAK_I2S_NOT_OK = 0;\n  AP_CAD_SOAK_BYTES_MISMATCH = 0;\n  AP_CAD_SOAK_FRAME_GAPS = 0;\n  AP_CAD_SOAK_TIMESTAMP_REGRESSIONS = 0;\n  AP_CAD_SOAK_CORE_BAD = 0;\n  AP_CAD_SOAK_ACTIVE_OVER_7500 = 0;\n  AP_CAD_SOAK_EMITTED_ACTIVE_OVER_7500 = 0;\n  AP_CAD_SOAK_ACTIVE_MAX_US = 0;\n  AP_CAD_SOAK_WORST_USED = 0;\n  AP_CAD_SOAK_HAVE_PREV = false;\n  for (uint16_t i = 0; i < AP_CAD_SOAK_HIST_BUCKETS; i++) {\n    AP_CAD_SOAK_ACTIVE_HIST[i] = 0;\n  }\n  K1TempoDebugSnapshot td = k1_tempo_debug_read();\n  AP_CAD_SOAK_LAST_EMIT = td.emit_count;\n  AP_CAD_SOAK_LAST_EMIT_MS = td.last_emit_ms;\n}\n\nbool ap_cad_soak_arm(uint32_t duration_ms) {\n  if (duration_ms == 0 || duration_ms > AP_CAD_SOAK_MAX_MS) {\n    return false;\n  }\n  ap_cad_soak_reset();\n  AP_CAD_SOAK_START_MS = millis();\n  AP_CAD_SOAK_END_MS = AP_CAD_SOAK_START_MS + duration_ms;\n  AP_CAD_SOAK_ACTIVE = true;\n  return true;\n}\n\nvoid ap_cad_soak_record_worst(const APCadenceCaptureSample& sample, uint32_t active_us) {\n  uint16_t insert_at = AP_CAD_SOAK_WORST_USED;\n  if (AP_CAD_SOAK_WORST_USED < AP_CAD_SOAK_WORST_COUNT) {\n    AP_CAD_SOAK_WORST_USED++;\n  } else {\n    uint32_t smallest_us = ap_cad_active_work_us(AP_CAD_SOAK_WORST[0]);\n    insert_at = 0;\n    for (uint16_t i = 1; i < AP_CAD_SOAK_WORST_COUNT; i++) {\n      uint32_t value = ap_cad_active_work_us(AP_CAD_SOAK_WORST[i]);\n      if (value < smallest_us) {\n        smallest_us = value;\n        insert_at = i;\n      }\n    }\n    if (active_us <= smallest_us) {\n      return;\n    }\n  }\n  AP_CAD_SOAK_WORST[insert_at] = sample;\n}\n\nvoid ap_cad_soak_tick(const APCadenceFrameInput& frame) {\n  if (!AP_CAD_SOAK_ACTIVE) {\n    return;\n  }\n  if ((int32_t)(frame.frame_ms - AP_CAD_SOAK_END_MS) >= 0) {\n    AP_CAD_SOAK_ACTIVE = false;\n    return;\n  }\n\n  const bool emitted = frame.tempo.emit_count != AP_CAD_SOAK_LAST_EMIT;\n  uint32_t emit_delta_ms = 0;\n  if (emitted) {\n    emit_delta_ms = (frame.tempo.last_emit_ms >= AP_CAD_SOAK_LAST_EMIT_MS)\n      ? (frame.tempo.last_emit_ms - AP_CAD_SOAK_LAST_EMIT_MS)\n      : 0;\n    if (AP_CAD_SOAK_EMITTED_COUNT == 0) {\n      AP_CAD_SOAK_FIRST_EMIT_MS = frame.tempo.last_emit_ms;\n    }\n    AP_CAD_SOAK_LAST_EMIT = frame.tempo.emit_count;\n    AP_CAD_SOAK_LAST_EMIT_MS = frame.tempo.last_emit_ms;\n    AP_CAD_SOAK_EMITTED_COUNT++;\n  }\n\n  const APCadenceCaptureSample sample = ap_cad_make_sample(frame, emitted, emit_delta_ms);\n  const uint32_t active_us = ap_cad_active_work_us(sample);\n  if (AP_CAD_SOAK_ROW_COUNT == 0) {\n    AP_CAD_SOAK_FIRST_FRAME_MS = frame.frame_ms;\n  }\n  AP_CAD_SOAK_LAST_FRAME_MS = frame.frame_ms;\n  if (AP_CAD_SOAK_HAVE_PREV) {\n    if (frame.frame_index != AP_CAD_SOAK_PREV_FRAME + 1) {\n      AP_CAD_SOAK_FRAME_GAPS++;\n    }\n    if (frame.frame_ms <= AP_CAD_SOAK_PREV_FRAME_MS) {\n      AP_CAD_SOAK_TIMESTAMP_REGRESSIONS++;\n    }\n  }\n  AP_CAD_SOAK_PREV_FRAME = frame.frame_index;\n  AP_CAD_SOAK_PREV_FRAME_MS = frame.frame_ms;\n  AP_CAD_SOAK_HAVE_PREV = true;\n\n  AP_CAD_SOAK_ROW_COUNT++;\n  if ((sample.flags & 0x08) == 0) AP_CAD_SOAK_I2S_NOT_OK++;\n  if ((sample.flags & 0x10) == 0) AP_CAD_SOAK_BYTES_MISMATCH++;\n  if ((sample.flags & 0x20) == 0) AP_CAD_SOAK_CORE_BAD++;\n  if (active_us > 7500UL) {\n    AP_CAD_SOAK_ACTIVE_OVER_7500++;\n    if (emitted) AP_CAD_SOAK_EMITTED_ACTIVE_OVER_7500++;\n  }\n  if (active_us > AP_CAD_SOAK_ACTIVE_MAX_US) {\n    AP_CAD_SOAK_ACTIVE_MAX_US = active_us;\n  }\n  uint16_t bucket = (uint16_t)(active_us / AP_CAD_SOAK_HIST_BUCKET_US);\n  if (bucket >= AP_CAD_SOAK_HIST_BUCKETS) {\n    bucket = AP_CAD_SOAK_HIST_BUCKETS - 1;\n  }\n  AP_CAD_SOAK_ACTIVE_HIST[bucket]++;\n  ap_cad_soak_record_worst(sample, active_us);\n}\n\nuint32_t ap_cad_soak_hist_percentile(uint8_t percentile) {\n  if (AP_CAD_SOAK_ROW_COUNT == 0) {\n    return 0;\n  }\n  uint32_t target = (AP_CAD_SOAK_ROW_COUNT * (uint32_t)percentile + 99UL) / 100UL;\n  if (target == 0) target = 1;\n  uint32_t seen = 0;\n  for (uint16_t i = 0; i < AP_CAD_SOAK_HIST_BUCKETS; i++) {\n    seen += AP_CAD_SOAK_ACTIVE_HIST[i];\n    if (seen >= target) {\n      return ((uint32_t)i + 1UL) * AP_CAD_SOAK_HIST_BUCKET_US;\n    }\n  }\n  return AP_CAD_SOAK_HIST_BUCKETS * AP_CAD_SOAK_HIST_BUCKET_US;\n}\n\nvoid ap_cad_soak_print_worst_sample(uint8_t rank, const APCadenceCaptureSample& sample) {\n  USBSerial.print(\"APCAD_SOAK_WORST,ver=1,rank=\");\n  USBSerial.print(rank);\n  USBSerial.print(\",frame=\");\n  USBSerial.print(sample.frame_index);\n  USBSerial.print(\",t=\");\n  USBSerial.print(sample.frame_ms);\n  USBSerial.print(\",active_us=\");\n  USBSerial.print(ap_cad_active_work_us(sample));\n  USBSerial.print(\",total_us=\");\n  USBSerial.print(sample.total_ap_loop_elapsed_us);\n  USBSerial.print(\",i2s_us=\");\n  USBSerial.print(sample.i2s_read_elapsed_us);\n  USBSerial.print(\",gdft_us=\");\n  USBSerial.print(sample.gdft_elapsed_us);\n  USBSerial.print(\",novelty_us=\");\n  USBSerial.print(sample.novelty_elapsed_us);\n  USBSerial.print(\",tempo_acf_us=\");\n  USBSerial.print(sample.tempo_acf_elapsed_us);\n  USBSerial.print(\",tempo_update_us=\");\n  USBSerial.print(sample.tempo_update_elapsed_us);\n  USBSerial.print(\",tempo_emit_us=\");\n  USBSerial.print(sample.tempo_emit_elapsed_us);\n  USBSerial.print(\",emitted=\");\n  USBSerial.print((sample.flags & 0x01) ? 1 : 0);\n  USBSerial.print(\",acf_spread=\");\n  USBSerial.print((sample.flags & 0x80) ? 1 : 0);\n  USBSerial.print(\",acf_lag_cursor=\");\n  USBSerial.print(sample.acf_lag_cursor);\n  USBSerial.print(\",acf_pub=\");\n  USBSerial.print(sample.acf_publish_count);\n  USBSerial.print(\",win_bpm=\");\n  ap_nov_capture_print_q8_8(sample.winner_bpm_q8_8);\n  USBSerial.print(\",top1_bpm=\");\n  ap_nov_capture_print_q8_8(sample.top1_bpm_q8_8);\n  USBSerial.println();\n}\n\nvoid ap_cad_soak_status() {\n  float measured_ap_hz = 0.0f;\n  float measured_nov_hz = 0.0f;\n  if (AP_CAD_SOAK_ROW_COUNT >= 2 && AP_CAD_SOAK_LAST_FRAME_MS > AP_CAD_SOAK_FIRST_FRAME_MS) {\n    measured_ap_hz = 1000.0f * (float)(AP_CAD_SOAK_ROW_COUNT - 1) /\n      (float)(AP_CAD_SOAK_LAST_FRAME_MS - AP_CAD_SOAK_FIRST_FRAME_MS);\n  }\n  if (AP_CAD_SOAK_EMITTED_COUNT >= 2 && AP_CAD_SOAK_LAST_EMIT_MS > AP_CAD_SOAK_FIRST_EMIT_MS) {\n    measured_nov_hz = 1000.0f * (float)(AP_CAD_SOAK_EMITTED_COUNT - 1) /\n      (float)(AP_CAD_SOAK_LAST_EMIT_MS - AP_CAD_SOAK_FIRST_EMIT_MS);\n  }\n\n  USBSerial.print(\"APCAD_SOAK_DONE,ver=1,active=\");\n  USBSerial.print(AP_CAD_SOAK_ACTIVE ? 1 : 0);\n  USBSerial.print(\",rows=\");\n  USBSerial.print(AP_CAD_SOAK_ROW_COUNT);\n  USBSerial.print(\",emitted=\");\n  USBSerial.print(AP_CAD_SOAK_EMITTED_COUNT);\n  USBSerial.print(\",start_ms=\");\n  USBSerial.print(AP_CAD_SOAK_START_MS);\n  USBSerial.print(\",end_ms=\");\n  USBSerial.print(AP_CAD_SOAK_END_MS);\n  USBSerial.print(\",sample_rate=\");\n  USBSerial.print(CONFIG.SAMPLE_RATE);\n  USBSerial.print(\",samples_per_chunk=\");\n  USBSerial.print(CONFIG.SAMPLES_PER_CHUNK);\n  USBSerial.print(\",tempo_decim=\");\n  USBSerial.print(K1_TEMPO_NOVELTY_DECIMATION);\n  USBSerial.print(\",meas_ap_hz=\");\n  USBSerial.print(measured_ap_hz, 3);\n  USBSerial.print(\",meas_nov_hz=\");\n  USBSerial.print(measured_nov_hz, 3);\n  USBSerial.print(\",i2s_not_ok=\");\n  USBSerial.print(AP_CAD_SOAK_I2S_NOT_OK);\n  USBSerial.print(\",bytes_mismatch=\");\n  USBSerial.print(AP_CAD_SOAK_BYTES_MISMATCH);\n  USBSerial.print(\",frame_gap=\");\n  USBSerial.print(AP_CAD_SOAK_FRAME_GAPS);\n  USBSerial.print(\",timestamp_regression=\");\n  USBSerial.print(AP_CAD_SOAK_TIMESTAMP_REGRESSIONS);\n  USBSerial.print(\",core_bad=\");\n  USBSerial.print(AP_CAD_SOAK_CORE_BAD);\n  USBSerial.print(\",active_over_7500=\");\n  USBSerial.print(AP_CAD_SOAK_ACTIVE_OVER_7500);\n  USBSerial.print(\",emitted_active_over_7500=\");\n  USBSerial.print(AP_CAD_SOAK_EMITTED_ACTIVE_OVER_7500);\n  USBSerial.print(\",active_p95_us=\");\n  USBSerial.print(ap_cad_soak_hist_percentile(95));\n  USBSerial.print(\",active_max_us=\");\n  USBSerial.print(AP_CAD_SOAK_ACTIVE_MAX_US);\n  USBSerial.print(\",worst_count=\");\n  USBSerial.println(AP_CAD_SOAK_WORST_USED);\n\n  for (uint16_t i = 0; i < AP_CAD_SOAK_WORST_USED; i++) {\n    ap_cad_soak_print_worst_sample((uint8_t)i, AP_CAD_SOAK_WORST[i]);\n  }\n}\n\nfloat ap_cad_q8_8_to_float(uint16_t value) {\n  return (float)value / 256.0f;\n}\n\nbool ap_cad_rate_within_2pct(float measured_hz, float declared_hz) {\n  if (measured_hz <= 0.0f || declared_hz <= 0.0f) {\n    return false;\n  }\n  float ratio = measured_hz / declared_hz;\n  if (ratio < 0.0f) ratio = -ratio;\n  float drift = ratio - 1.0f;\n  if (drift < 0.0f) drift = -drift;\n  return drift <= 0.02f;\n}\n\nvoid ap_cad_capture_print_health() {\n  float measured_ap_hz = 0.0f;\n  float measured_nov_hz = 0.0f;\n  uint16_t emitted_rows = 0;\n  uint32_t first_emit_ms = 0;\n  uint32_t last_emit_ms = 0;\n  bool core_ok = (AP_CAD_CAPTURE_COUNT > 0);\n  bool i2s_ok = (AP_CAD_CAPTURE_COUNT > 0);\n  bool bytes_ok = (AP_CAD_CAPTURE_COUNT > 0);\n\n  if (AP_CAD_CAPTURE_COUNT >= 2) {\n    const APCadenceCaptureSample& first = AP_CAD_CAPTURE_BUFFER[0];\n    const APCadenceCaptureSample& last = AP_CAD_CAPTURE_BUFFER[AP_CAD_CAPTURE_COUNT - 1];\n    if (last.frame_ms > first.frame_ms) {\n      measured_ap_hz = 1000.0f * (float)(AP_CAD_CAPTURE_COUNT - 1) / (float)(last.frame_ms - first.frame_ms);\n    }\n  }\n\n  for (uint16_t i = 0; i < AP_CAD_CAPTURE_COUNT; i++) {\n    const APCadenceCaptureSample& sample = AP_CAD_CAPTURE_BUFFER[i];\n    if ((sample.flags & 0x20) == 0) {\n      core_ok = false;\n    }\n    if ((sample.flags & 0x08) == 0) {\n      i2s_ok = false;\n    }\n    if ((sample.flags & 0x10) == 0) {\n      bytes_ok = false;\n    }\n    if ((sample.flags & 0x01) != 0) {\n      if (emitted_rows == 0) {\n        first_emit_ms = sample.emit_ms;\n      }\n      last_emit_ms = sample.emit_ms;\n      emitted_rows++;\n    }\n  }\n  if (emitted_rows >= 2 && last_emit_ms > first_emit_ms) {\n    measured_nov_hz = 1000.0f * (float)(emitted_rows - 1) / (float)(last_emit_ms - first_emit_ms);\n  }\n\n  const APCadenceCaptureSample* ref = (AP_CAD_CAPTURE_COUNT > 0) ? &AP_CAD_CAPTURE_BUFFER[0] : nullptr;\n  const float declared_ap_hz = (ref != nullptr) ? ap_cad_q8_8_to_float(ref->declared_ap_hz_q8_8) : 0.0f;\n  const float declared_nov_hz = (ref != nullptr) ? ap_cad_q8_8_to_float(ref->declared_nov_hz_q8_8) : 0.0f;\n  const bool ap_rate_ok = ap_cad_rate_within_2pct(measured_ap_hz, declared_ap_hz);\n  const bool nov_rate_ok = ap_cad_rate_within_2pct(measured_nov_hz, declared_nov_hz);\n  const bool health_ok = ap_rate_ok && nov_rate_ok && core_ok && i2s_ok && bytes_ok;\n\n  USBSerial.print(\"APCAD_HEALTH,ver=1,health_ok=\");\n  USBSerial.print(health_ok ? 1 : 0);\n  USBSerial.print(\",sample_rate=\");\n  USBSerial.print(ref != nullptr ? ref->sample_rate : 0);\n  USBSerial.print(\",samples_per_chunk=\");\n  USBSerial.print(ref != nullptr ? ref->samples_per_chunk : 0);\n  USBSerial.print(\",tempo_decim=\");\n  USBSerial.print(ref != nullptr ? ref->tempo_decimation : 0);\n  USBSerial.print(\",decl_ap_hz=\");\n  USBSerial.print(declared_ap_hz, 3);\n  USBSerial.print(\",decl_nov_hz=\");\n  USBSerial.print(declared_nov_hz, 3);\n  USBSerial.print(\",meas_ap_hz=\");\n  USBSerial.print(measured_ap_hz, 3);\n  USBSerial.print(\",meas_nov_hz=\");\n  USBSerial.print(measured_nov_hz, 3);\n  USBSerial.print(\",ap_rate_ok=\");\n  USBSerial.print(ap_rate_ok ? 1 : 0);\n  USBSerial.print(\",nov_rate_ok=\");\n  USBSerial.print(nov_rate_ok ? 1 : 0);\n  USBSerial.print(\",core_ok=\");\n  USBSerial.print(core_ok ? 1 : 0);\n  USBSerial.print(\",i2s_ok=\");\n  USBSerial.print(i2s_ok ? 1 : 0);\n  USBSerial.print(\",bytes_ok=\");\n  USBSerial.print(bytes_ok ? 1 : 0);\n  USBSerial.print(\",dma_desc=\");\n  USBSerial.print(ref != nullptr ? ref->dma_desc_num : 0);\n  USBSerial.print(\",ap_core=\");\n  USBSerial.print(ref != nullptr ? ref->ap_core_id : -1);\n  USBSerial.print(\",vp_core=\");\n  USBSerial.println(ref != nullptr ? ref->vp_core_id : -1);\n}\n\nvoid ap_cad_capture_dump() {\n  AP_CAD_CAPTURE_ACTIVE = false;\n  USBSerial.print(\"APCAD_CAPTURE_BEGIN,count=\");\n  USBSerial.print(AP_CAD_CAPTURE_COUNT);\n  USBSerial.print(\",capacity=\");\n  USBSerial.print(AP_CAD_CAPTURE_CAPACITY);\n  USBSerial.print(\",dropped=\");\n  USBSerial.print(AP_CAD_CAPTURE_DROPPED);\n  USBSerial.print(\",start_ms=\");\n  USBSerial.print(AP_CAD_CAPTURE_START_MS);\n  USBSerial.print(\",end_ms=\");\n  USBSerial.println(AP_CAD_CAPTURE_END_MS);\n  ap_cad_capture_print_health();\n  for (uint16_t i = 0; i < AP_CAD_CAPTURE_COUNT; i++) {\n    const APCadenceCaptureSample& sample = AP_CAD_CAPTURE_BUFFER[i];\n    USBSerial.print(\"APCAD,boot_ms=\");\n    USBSerial.print(sample.boot_ms);\n    USBSerial.print(\",frame=\");\n    USBSerial.print(sample.frame_index);\n    USBSerial.print(\",t=\");\n    USBSerial.print(sample.frame_ms);\n    USBSerial.print(\",sample_rate=\");\n    USBSerial.print(sample.sample_rate);\n    USBSerial.print(\",samples_per_chunk=\");\n    USBSerial.print(sample.samples_per_chunk);\n    USBSerial.print(\",slot_bits=\");\n    USBSerial.print(sample.slot_bit_width);\n    USBSerial.print(\",slot_mode=\");\n    USBSerial.print(sample.slot_mode);\n    USBSerial.print(\",dma_desc=\");\n    USBSerial.print(sample.dma_desc_num);\n    USBSerial.print(\",dma_frame=\");\n    USBSerial.print(sample.dma_frame_num);\n    USBSerial.print(\",bytes_req=\");\n    USBSerial.print(sample.bytes_requested);\n    USBSerial.print(\",bytes_read=\");\n    USBSerial.print(sample.bytes_read);\n    USBSerial.print(\",i2s_status=\");\n    USBSerial.print(sample.i2s_status);\n    USBSerial.print(\",stage=\");\n    USBSerial.print(sample.stage);\n    USBSerial.print(\",ap_core=\");\n    USBSerial.print(sample.ap_core_id);\n    USBSerial.print(\",vp_core=\");\n    USBSerial.print(sample.vp_core_id);\n    USBSerial.print(\",i2s_us=\");\n    USBSerial.print(sample.i2s_read_elapsed_us);\n    USBSerial.print(\",gdft_us=\");\n    USBSerial.print(sample.gdft_elapsed_us);\n    USBSerial.print(\",novelty_us=\");\n    USBSerial.print(sample.novelty_elapsed_us);\n    USBSerial.print(\",total_us=\");\n    USBSerial.print(sample.total_ap_loop_elapsed_us);\n    USBSerial.print(\",k1_frame_ctr=\");\n    USBSerial.print(sample.k1_frame_ctr);\n    USBSerial.print(\",tempo_decim=\");\n    USBSerial.print(sample.tempo_decimation);\n    USBSerial.print(\",decl_ap_hz=\");\n    ap_nov_capture_print_q8_8(sample.declared_ap_hz_q8_8);\n    USBSerial.print(\",decl_nov_hz=\");\n    ap_nov_capture_print_q8_8(sample.declared_nov_hz_q8_8);\n    USBSerial.print(\",emit=\");\n    USBSerial.print(sample.emit_count);\n    USBSerial.print(\",emit_ms=\");\n    USBSerial.print(sample.emit_ms);\n    USBSerial.print(\",emit_dt=\");\n    USBSerial.print(sample.emit_delta_ms);\n    USBSerial.print(\",emitted=\");\n    USBSerial.print((sample.flags & 0x01) ? 1 : 0);\n    USBSerial.print(\",nov=\");\n    ap_nov_capture_print_q16(sample.novelty_q16);\n    USBSerial.print(\",nov_scaled=\");\n    ap_nov_capture_print_q8_8(sample.scaled_novelty_q8_8);\n    USBSerial.print(\",win_bpm=\");\n    ap_nov_capture_print_q8_8(sample.winner_bpm_q8_8);\n    USBSerial.print(\",top1_bpm=\");\n    ap_nov_capture_print_q8_8(sample.top1_bpm_q8_8);\n    USBSerial.print(\",v2_ema=\");\n    ap_nov_capture_print_q16(sample.v2_conf_ema_q16);\n    USBSerial.print(\",v2_q=\");\n    ap_nov_capture_print_q16(sample.v2_quality_q16);\n    USBSerial.print(\",v2_h=\");\n    ap_nov_capture_print_q16(sample.v2_hist_share_q16);\n    USBSerial.print(\",v2_pr=\");\n    ap_nov_capture_print_q16(sample.v2_prominence_q16);\n    USBSerial.print(\",v2_per=\");\n    ap_nov_capture_print_q16(sample.v2_periodicity_q16);\n    USBSerial.print(\",v2_ps=\");\n    ap_nov_capture_print_q16(sample.v2_peak_share_q16);\n    USBSerial.print(\",tempo_silence_us=\");\n    USBSerial.print(sample.tempo_silence_elapsed_us);\n    USBSerial.print(\",tempo_acf_us=\");\n    USBSerial.print(sample.tempo_acf_elapsed_us);\n    USBSerial.print(\",tempo_update_us=\");\n    USBSerial.print(sample.tempo_update_elapsed_us);\n    USBSerial.print(\",tempo_phase_us=\");\n    USBSerial.print(sample.tempo_phase_elapsed_us);\n    USBSerial.print(\",tempo_publish_us=\");\n    USBSerial.print(sample.tempo_publish_elapsed_us);\n    USBSerial.print(\",tempo_emit_us=\");\n    USBSerial.print(sample.tempo_emit_elapsed_us);\n    USBSerial.print(\",acf_spread=\");\n    USBSerial.print((sample.flags & 0x80) ? 1 : 0);\n    USBSerial.print(\",acf_lag_cursor=\");\n    USBSerial.print(sample.acf_lag_cursor);\n    USBSerial.print(\",acf_pub=\");\n    USBSerial.print(sample.acf_publish_count);\n    USBSerial.print(\",v2_lock=\");\n    USBSerial.print((sample.flags & 0x40) ? 1 : 0);\n    USBSerial.print(\",sil=\");\n    USBSerial.print((sample.flags & 0x02) ? 1 : 0);\n    USBSerial.print(\",acf=\");\n    USBSerial.print((sample.flags & 0x04) ? 1 : 0);\n    USBSerial.print(\",i2s_ok=\");\n    USBSerial.print((sample.flags & 0x08) ? 1 : 0);\n    USBSerial.print(\",bytes_ok=\");\n    USBSerial.print((sample.flags & 0x10) ? 1 : 0);\n    USBSerial.print(\",core_ok=\");\n    USBSerial.print((sample.flags & 0x20) ? 1 : 0);\n    USBSerial.println(\",src=buf\");\n    if ((i & 0x0F) == 0x0F) {\n      vTaskDelay(1);\n    }\n  }\n  USBSerial.print(\"APCAD_CAPTURE_DONE,count=\");\n  USBSerial.print(AP_CAD_CAPTURE_COUNT);\n  USBSerial.print(\",dropped=\");\n  USBSerial.println(AP_CAD_CAPTURE_DROPPED);\n}\n\n// ---------------------------------------------------------------------------\n// serial_diag_ap_dispatch — lifted verbatim from parse_command() Stage-B ladder.\n// Handles the 11 AP-frontend-debug handlers (ENABLE_TEMPO_STREAM && ENABLE_AP_FRONTEND_DEBUG).\n// tempo_stream is NOT here — it is ENABLE_TEMPO_STREAM-only (a broader gate) and\n// stays inline in serial_menu.h so this dispatcher straddles a single gate level.\n// The `if (false) {}` opener keeps every real branch as `else if (strcmp(...))`,\n// statement-identical to the serial_menu.h@HEAD source. Returns true iff handled.\n// ---------------------------------------------------------------------------\nbool serial_diag_ap_dispatch(const char* command_type, char* command_data) {\n    if (false) {}\n\n#if ENABLE_TEMPO_STREAM && ENABLE_AP_FRONTEND_DEBUG\n    else if (strcmp(command_type, \"ap_frontend_debug\") == 0 || strcmp(command_type, \"apdbg\") == 0) {\n      bool value = false;\n      if (vp_parse_bool(command_data, &value)) {\n        AP_FRONTEND_DEBUG_ENABLED = value;\n        tx_begin();\n        USBSerial.print(\"AP_FRONTEND_DEBUG: \");\n        USBSerial.println(vp_bool_text(AP_FRONTEND_DEBUG_ENABLED));\n        tx_end();\n      } else {\n        bad_command(command_type, command_data);\n      }\n    }\n\n    else if (strcmp(command_type, \"nov_capture\") == 0) {\n      long ms = (command_data && command_data[0]) ? atol(command_data) : 0;\n      if (ms > 0 && (uint32_t)ms <= AP_NOV_CAPTURE_MAX_MS && ap_nov_capture_arm((uint32_t)ms)) {\n        tx_begin();\n        USBSerial.print(\"NOV_CAPTURE: armed \");\n        USBSerial.print(ms);\n        USBSerial.print(\" ms capacity=\");\n        USBSerial.println(AP_NOV_CAPTURE_CAPACITY);\n        tx_end();\n      } else {\n        bad_command(command_type, command_data);\n      }\n    }\n\n    else if (strcmp(command_type, \"nov_dump\") == 0) {\n      bool value = false;\n      if (vp_parse_bool(command_data, &value) && value) {\n        ap_nov_capture_dump();\n      } else {\n        bad_command(command_type, command_data);\n      }\n    }\n\n#ifdef ENABLE_K1EV_STREAM\n    else if (strcmp(command_type, \"k1ev_dump\") == 0) {\n      bool value = false;\n      if (vp_parse_bool(command_data, &value) && value) {\n        k1ev_capture_dump();   // decoupled [K1EV] dump: orchestrator sends `k1ev_dump=1` AFTER the nov flow\n      } else {\n        bad_command(command_type, command_data);\n      }\n    }\n#endif\n\n    else if (strcmp(command_type, \"nov_clear\") == 0) {\n      bool value = false;\n      if (vp_parse_bool(command_data, &value) && value) {\n        ap_nov_capture_clear();\n        ap_nov_capture_status();\n      } else {\n        bad_command(command_type, command_data);\n      }\n    }\n\n    else if (strcmp(command_type, \"nov_status\") == 0) {\n      bool value = false;\n      if (vp_parse_bool(command_data, &value) && value) {\n        ap_nov_capture_status();\n      } else {\n        bad_command(command_type, command_data);\n      }\n    }\n\n    else if (strcmp(command_type, \"apcad_capture\") == 0) {\n      long ms = (command_data && command_data[0]) ? atol(command_data) : 0;\n      if (ms > 0 && (uint32_t)ms <= AP_CAD_CAPTURE_MAX_MS && ap_cad_capture_arm((uint32_t)ms)) {\n        tx_begin();\n        USBSerial.print(\"APCAD_CAPTURE: armed \");\n        USBSerial.print(ms);\n        USBSerial.print(\" ms capacity=\");\n        USBSerial.println(AP_CAD_CAPTURE_CAPACITY);\n        tx_end();\n      } else {\n        bad_command(command_type, command_data);\n      }\n    }\n\n    else if (strcmp(command_type, \"apcad_dump\") == 0) {\n      bool value = false;\n      if (vp_parse_bool(command_data, &value) && value) {\n        ap_cad_capture_dump();\n      } else {\n        bad_command(command_type, command_data);\n      }\n    }\n\n    else if (strcmp(command_type, \"apcad_clear\") == 0) {\n      bool value = false;\n      if (vp_parse_bool(command_data, &value) && value) {\n        ap_cad_capture_clear();\n        ap_cad_capture_status();\n      } else {\n        bad_command(command_type, command_data);\n      }\n    }\n\n    else if (strcmp(command_type, \"apcad_status\") == 0) {\n      bool value = false;\n      if (vp_parse_bool(command_data, &value) && value) {\n        ap_cad_capture_status();\n      } else {\n        bad_command(command_type, command_data);\n      }\n    }\n\n    else if (strcmp(command_type, \"apcad_soak\") == 0) {\n      long ms = (command_data && command_data[0]) ? atol(command_data) : 0;\n      if (ms > 0 && (uint32_t)ms <= AP_CAD_SOAK_MAX_MS && ap_cad_soak_arm((uint32_t)ms)) {\n        tx_begin();\n        USBSerial.print(\"APCAD_SOAK: armed \");\n        USBSerial.print(ms);\n        USBSerial.println(\" ms compact=1\");\n        tx_end();\n      } else {\n        bad_command(command_type, command_data);\n      }\n    }\n\n    else if (strcmp(command_type, \"apcad_soak_status\") == 0) {\n      bool value = false;\n      if (vp_parse_bool(command_data, &value) && value) {\n        ap_cad_soak_status();\n      } else {\n        bad_command(command_type, command_data);\n      }\n    }\n\n    else if (strcmp(command_type, \"apcad_abort\") == 0) {\n      bool value = false;\n      if (vp_parse_bool(command_data, &value) && value) {\n        AP_CAD_CAPTURE_ACTIVE = false;\n        AP_CAD_SOAK_ACTIVE = false;\n        tx_begin();\n        USBSerial.println(\"APCAD_ABORT: stopped\");\n        tx_end();\n      } else {\n        bad_command(command_type, command_data);\n      }\n    }\n#endif  // ENABLE_TEMPO_STREAM && ENABLE_AP_FRONTEND_DEBUG\n\n    else {\n      return false;  // not a diag-AP handler — let parse_command's ladder continue\n    }\n\n    return true;\n}\n\n#endif  // ENABLE_TEMPO_STREAM && ENABLE_AP_FRONTEND_DEBUG\n","numLines":1001,"startLine":1,"totalLines":1001}}}
