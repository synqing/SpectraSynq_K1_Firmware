{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VuyYJDZCMPAceqUMSUuEfu","type":"tool_result","content":"1\t#pragma once\n2\t// ─────────────────────────────────────────────────────────────────────────────\n3\t// Mode-A `[K1EV]` BUFFERED telemetry capture  (K1 Offline Analysis Pairing).\n4\t// Contract: k1-analysis-harness/capture/CAPTURE_CONTRACT.md v0.2.\n5\t//\n6\t// Supersedes the live per-frame emit in serial/k1ev_stream.h. That tap formatted\n7\t// and wrote ~200 chars over USBSerial EVERY audio frame from the loop() post-tempo\n8\t// call site, which perturbed the very pipeline it measures (measured active_p95\n9\t// 8448 us against a 7500 us budget; the shipping DSP already sits ~7040 us p95).\n10\t//\n11\t// This unit instead APPENDS a compact fixed-point struct per frame (sub-us, no\n12\t// printf, no USB) into a PSRAM ring, then formats + emits the WHOLE run AFTER it,\n13\t// off the hot path — exactly like ap_nov_capture / ap_cad_capture. The dump\n14\t// reproduces the FROZEN `[K1EV]` wire format byte-for-byte (see k1ev_capture.cpp),\n15\t// so capture/parse_capture.py is unchanged.\n16\t//\n17\t// ADDITIVE + gated: nothing here compiles unless ENABLE_K1EV_STREAM is defined\n18\t// (only [env:k1_bench_ap_frontend_probe]); k1_prod_im73d / k1_hardware stay\n19\t// byte-identical.\n20\t//\n21\t// Field notes (see CAPTURE_CONTRACT.md §v0.2 / k1ev_stream.h history):\n22\t//  * t_ms   = snap.frame_ms  — FRESH every frame (NOT event.event_ms, stale between\n23\t//             onsets; carried separately as event_ms).\n24\t//  * beat=  = tempo beat_tick (k1_tempo_read), NOT the onset event's beat flag.\n25\t//  * croot / chroma are A-ORIGIN (bin 0 = A); the harness rotates +9 to C-origin.\n26\t//  * croot  = -1 synthesised when chord.type == NONE (0 would collide with A).\n27\t//  * ctype  enum: 0=NONE,1=MAJOR,2=MINOR,3=DIMINISHED,4=AUGMENTED.\n28\t// ─────────────────────────────────────────────────────────────────────────────\n29\t#ifdef ENABLE_K1EV_STREAM\n30\t#include <stdint.h>\n31\t#include \"k1_audio_snapshot.h\"   // K1AudioSnapshot, K1OnsetBeatEvent, K1ChordType, K1_CHROMA_PC_BINS\n32\t\n33\t#ifndef K1EV_STREAM_DECIMATE\n34\t#define K1EV_STREAM_DECIMATE 3   // heavy (chroma) sample cadence: every Nth in-window\n35\t#endif                           // frame. 3 -> 44.4 Hz at the 133 Hz AP rate. Onset\n36\t                                 // frames ALWAYS append (chroma optional to the parser).\n37\t#ifndef K1EV_CAPTURE_CAPACITY\n38\t#define K1EV_CAPTURE_CAPACITY 65536   // 65536 * 64 B = 4 MiB PSRAM (of 8 MiB N16R8). Sized for\n39\t#endif                                // the longest corpus track (Sgadi Li Mi 300.6 s) at the\n40\t                                      // MEASURED 107 samples/s (48,231 w/ 1.5 safety) AND the\n41\t                                      // absolute every-frame-@133Hz worst case (60,118) -> both\n42\t                                      // < 65,536. 32,768 (2 MiB) overflowed both. Alloc fails\n43\t                                      // safe (arm returns false) if 4 MiB PSRAM is unavailable.\n44\t#ifndef K1EV_CAPTURE_MAX_MS\n45\t#define K1EV_CAPTURE_MAX_MS 180000UL  // mirror AP_NOV_CAPTURE_MAX_MS (the piggyback arm\n46\t#endif                                // duration comes straight from nov_capture=<ms>).\n47\t\n48\t// Compact per-frame record (64 B, naturally aligned; sizeof == 64 — static_assert'd\n49\t// in the .cpp). Floats are scaled to int16 with a saturating helper and re-expanded\n50\t// in the dump to the exact %.3f/%.1f the live emit produced (round(x*S)/S == %.Nf(x)).\n51\t// photons is stored full-precision (float) because the director scalar has no bounded\n52\t// range, so a fixed 16-bit scale would risk overflow / clipping.\n53\tstruct K1EVCaptureSample {\n54\t  uint32_t t_ms;            // snap.frame_ms                (always)\n55\t  uint32_t event_ms;        // ev.event_ms                  (always)\n56\t  uint32_t event_id;        // ev.event_id                  (always)\n57\t  uint32_t kick_event_id;   // ev.kick_event_id             (always)\n58\t  uint32_t snare_event_id;  // ev.snare_event_id            (always)\n59\t  uint32_t hihat_event_id;  // ev.hihat_event_id            (always)\n60\t  float    photons;         // photons_scalar (%.3f)        (sample frame)\n61\t  int16_t  bphase_q;        // phase01           * 1000 (%.3f)  (always)\n62\t  int16_t  bconf_q;         // confidence        * 1000 (%.3f)  (always)\n63\t  int16_t  bpm_q10;         // bpm               * 10   (%.1f)  (always)\n64\t  int16_t  cconf_q;         // chord.confidence  * 1000 (%.3f)  (sample frame)\n65\t  int16_t  chroma_q[12];    // chroma_pc[c]      * 1000 (%.3f)  (sample frame)\n66\t  uint8_t  flags;           // b0 onset|b1 bass|b2 kick|b3 snare|b4 hihat|b5 beat_tick|b6 has_chroma\n67\t  int8_t   croot;           // A-origin root; -1 on NONE        (sample frame)\n68\t  uint8_t  ctype;           // 0=NONE..4=AUG                    (sample frame)\n69\t  uint8_t  mode;            // applied_mode                     (sample frame)\n70\t};\n71\t\n72\t// State (external linkage; defined in k1ev_capture.cpp). Shared between the loop()\n73\t// tick call site (.ino) and the arm/dump piggyback in k1_ap_capture_telemetry.cpp.\n74\textern K1EVCaptureSample* K1EV_CAPTURE_BUFFER;\n75\textern uint32_t K1EV_CAPTURE_COUNT;\n76\textern uint32_t K1EV_CAPTURE_DROPPED;\n77\textern uint32_t K1EV_CAPTURE_FRAME_N;\n78\textern uint32_t K1EV_CAPTURE_START_MS;\n79\textern uint32_t K1EV_CAPTURE_END_MS;\n80\textern bool     K1EV_CAPTURE_ACTIVE;\n81\textern bool     K1EV_CAPTURE_ALLOC_FAILED;\n82\t\n83\tbool k1ev_capture_ensure_buffer();                 // lazy PSRAM alloc (internal fallback)\n84\tbool k1ev_capture_arm(uint32_t duration_ms);       // reset + window; piggybacked by nov arm\n85\tvoid k1ev_capture_tick(const K1AudioSnapshot& snap, const K1OnsetBeatEvent& ev);  // hot path: append only\n86\tvoid k1ev_capture_dump();                          // off hot path; piggybacked by nov dump\n87\t\n88\t#endif  // ENABLE_K1EV_STREAM\n89\t"}]},"parent_tool_use_id":null,"session_id":"16a76e6c-f56d-436e-9309-aa9c7ce3989f","uuid":"26ccd9f5-775e-4220-8a07-cb6f4508d559","timestamp":"2026-07-15T20:24:41.559Z","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/k1-ruflo-live/SPECTRASYNQ_K1_FIRMWARE/serial/k1ev_capture.h","content":"#pragma once\n// ─────────────────────────────────────────────────────────────────────────────\n// Mode-A `[K1EV]` BUFFERED telemetry capture  (K1 Offline Analysis Pairing).\n// Contract: k1-analysis-harness/capture/CAPTURE_CONTRACT.md v0.2.\n//\n// Supersedes the live per-frame emit in serial/k1ev_stream.h. That tap formatted\n// and wrote ~200 chars over USBSerial EVERY audio frame from the loop() post-tempo\n// call site, which perturbed the very pipeline it measures (measured active_p95\n// 8448 us against a 7500 us budget; the shipping DSP already sits ~7040 us p95).\n//\n// This unit instead APPENDS a compact fixed-point struct per frame (sub-us, no\n// printf, no USB) into a PSRAM ring, then formats + emits the WHOLE run AFTER it,\n// off the hot path — exactly like ap_nov_capture / ap_cad_capture. The dump\n// reproduces the FROZEN `[K1EV]` wire format byte-for-byte (see k1ev_capture.cpp),\n// so capture/parse_capture.py is unchanged.\n//\n// ADDITIVE + gated: nothing here compiles unless ENABLE_K1EV_STREAM is defined\n// (only [env:k1_bench_ap_frontend_probe]); k1_prod_im73d / k1_hardware stay\n// byte-identical.\n//\n// Field notes (see CAPTURE_CONTRACT.md §v0.2 / k1ev_stream.h history):\n//  * t_ms   = snap.frame_ms  — FRESH every frame (NOT event.event_ms, stale between\n//             onsets; carried separately as event_ms).\n//  * beat=  = tempo beat_tick (k1_tempo_read), NOT the onset event's beat flag.\n//  * croot / chroma are A-ORIGIN (bin 0 = A); the harness rotates +9 to C-origin.\n//  * croot  = -1 synthesised when chord.type == NONE (0 would collide with A).\n//  * ctype  enum: 0=NONE,1=MAJOR,2=MINOR,3=DIMINISHED,4=AUGMENTED.\n// ─────────────────────────────────────────────────────────────────────────────\n#ifdef ENABLE_K1EV_STREAM\n#include <stdint.h>\n#include \"k1_audio_snapshot.h\"   // K1AudioSnapshot, K1OnsetBeatEvent, K1ChordType, K1_CHROMA_PC_BINS\n\n#ifndef K1EV_STREAM_DECIMATE\n#define K1EV_STREAM_DECIMATE 3   // heavy (chroma) sample cadence: every Nth in-window\n#endif                           // frame. 3 -> 44.4 Hz at the 133 Hz AP rate. Onset\n                                 // frames ALWAYS append (chroma optional to the parser).\n#ifndef K1EV_CAPTURE_CAPACITY\n#define K1EV_CAPTURE_CAPACITY 65536   // 65536 * 64 B = 4 MiB PSRAM (of 8 MiB N16R8). Sized for\n#endif                                // the longest corpus track (Sgadi Li Mi 300.6 s) at the\n                                      // MEASURED 107 samples/s (48,231 w/ 1.5 safety) AND the\n                                      // absolute every-frame-@133Hz worst case (60,118) -> both\n                                      // < 65,536. 32,768 (2 MiB) overflowed both. Alloc fails\n                                      // safe (arm returns false) if 4 MiB PSRAM is unavailable.\n#ifndef K1EV_CAPTURE_MAX_MS\n#define K1EV_CAPTURE_MAX_MS 180000UL  // mirror AP_NOV_CAPTURE_MAX_MS (the piggyback arm\n#endif                                // duration comes straight from nov_capture=<ms>).\n\n// Compact per-frame record (64 B, naturally aligned; sizeof == 64 — static_assert'd\n// in the .cpp). Floats are scaled to int16 with a saturating helper and re-expanded\n// in the dump to the exact %.3f/%.1f the live emit produced (round(x*S)/S == %.Nf(x)).\n// photons is stored full-precision (float) because the director scalar has no bounded\n// range, so a fixed 16-bit scale would risk overflow / clipping.\nstruct K1EVCaptureSample {\n  uint32_t t_ms;            // snap.frame_ms                (always)\n  uint32_t event_ms;        // ev.event_ms                  (always)\n  uint32_t event_id;        // ev.event_id                  (always)\n  uint32_t kick_event_id;   // ev.kick_event_id             (always)\n  uint32_t snare_event_id;  // ev.snare_event_id            (always)\n  uint32_t hihat_event_id;  // ev.hihat_event_id            (always)\n  float    photons;         // photons_scalar (%.3f)        (sample frame)\n  int16_t  bphase_q;        // phase01           * 1000 (%.3f)  (always)\n  int16_t  bconf_q;         // confidence        * 1000 (%.3f)  (always)\n  int16_t  bpm_q10;         // bpm               * 10   (%.1f)  (always)\n  int16_t  cconf_q;         // chord.confidence  * 1000 (%.3f)  (sample frame)\n  int16_t  chroma_q[12];    // chroma_pc[c]      * 1000 (%.3f)  (sample frame)\n  uint8_t  flags;           // b0 onset|b1 bass|b2 kick|b3 snare|b4 hihat|b5 beat_tick|b6 has_chroma\n  int8_t   croot;           // A-origin root; -1 on NONE        (sample frame)\n  uint8_t  ctype;           // 0=NONE..4=AUG                    (sample frame)\n  uint8_t  mode;            // applied_mode                     (sample frame)\n};\n\n// State (external linkage; defined in k1ev_capture.cpp). Shared between the loop()\n// tick call site (.ino) and the arm/dump piggyback in k1_ap_capture_telemetry.cpp.\nextern K1EVCaptureSample* K1EV_CAPTURE_BUFFER;\nextern uint32_t K1EV_CAPTURE_COUNT;\nextern uint32_t K1EV_CAPTURE_DROPPED;\nextern uint32_t K1EV_CAPTURE_FRAME_N;\nextern uint32_t K1EV_CAPTURE_START_MS;\nextern uint32_t K1EV_CAPTURE_END_MS;\nextern bool     K1EV_CAPTURE_ACTIVE;\nextern bool     K1EV_CAPTURE_ALLOC_FAILED;\n\nbool k1ev_capture_ensure_buffer();                 // lazy PSRAM alloc (internal fallback)\nbool k1ev_capture_arm(uint32_t duration_ms);       // reset + window; piggybacked by nov arm\nvoid k1ev_capture_tick(const K1AudioSnapshot& snap, const K1OnsetBeatEvent& ev);  // hot path: append only\nvoid k1ev_capture_dump();                          // off hot path; piggybacked by nov dump\n\n#endif  // ENABLE_K1EV_STREAM\n","numLines":89,"startLine":1,"totalLines":89}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P4KQzK36KukXNS2CJjXEDn","type":"tool_result","content":"1\t/*----------------------------------------\n2\t  K1 `[K1EV]` BUFFERED telemetry capture — implementation\n3\t  ----------------------------------------\n4\t  Mode-A read-only analysis tap, buffered edition. Supersedes the live per-frame\n5\t  emit in serial/k1ev_stream.h (see that header + k1ev_capture.h for the WHY: the\n6\t  live USBSerial write per frame perturbed the pipeline it measures).\n7\t\n8\t  The whole unit is gated on ENABLE_K1EV_STREAM, defined ONLY in the non-shippable\n9\t  [env:k1_bench_ap_frontend_probe]. As with k1_ap_capture_telemetry.cpp, the gate\n10\t  is applied FIRST — BEFORE any #include — so that in production (k1_hardware /\n11\t  k1_prod_im73d) this TU preprocesses to NOTHING: no header pull-in, no globals,\n12\t  no static-initialiser ctor, hence zero bytes added to the release link (the\n13\t  binary stays byte-identical).\n14\t*/\n15\t\n16\t#ifdef ENABLE_K1EV_STREAM\n17\t\n18\t#include \"k1ev_capture.h\"\n19\t#include \"globals.h\"             // USBSerial, millis, vTaskDelay (Arduino/FreeRTOS)\n20\t#include \"k1_tempo.h\"            // K1TempoEvent, k1_tempo_read()\n21\t#include \"k1_mode_selection.h\"   // k1_mode_selection_read_state()\n22\t#include \"k1_smart_director.h\"   // k1_smart_director_read_output()\n23\t#include <esp_heap_caps.h>       // heap_caps_malloc / MALLOC_CAP_SPIRAM\n24\t#include <math.h>                // lroundf, isfinite\n25\t\n26\t// One record is exactly 64 B; assert it so the PSRAM budget claim can't silently\n27\t// drift, and pin the chroma width to the pitch-class bin count.\n28\tstatic_assert(sizeof(K1EVCaptureSample) == 64, \"K1EVCaptureSample must stay 64 B\");\n29\tstatic_assert(K1_CHROMA_PC_BINS == 12, \"dump chroma loop assumes 12 pitch-class bins\");\n30\t\n31\t// ---- State (external linkage) ----------------------------------------------\n32\tK1EVCaptureSample* K1EV_CAPTURE_BUFFER = nullptr;\n33\tuint32_t K1EV_CAPTURE_COUNT = 0;\n34\tuint32_t K1EV_CAPTURE_DROPPED = 0;\n35\tuint32_t K1EV_CAPTURE_FRAME_N = 0;\n36\tuint32_t K1EV_CAPTURE_START_MS = 0;\n37\tuint32_t K1EV_CAPTURE_END_MS = 0;\n38\tbool     K1EV_CAPTURE_ACTIVE = false;\n39\tbool     K1EV_CAPTURE_ALLOC_FAILED = false;\n40\t\n41\t// Saturating fixed-point quantiser (semantics of ap_capture_i16_sat, kept local so\n42\t// this TU stays independent of the ENABLE_AP_FRONTEND_DEBUG gate). round(v*scale)\n43\t// then clamp to int16 — re-expanded /scale it reproduces the exact %.Nf the live\n44\t// emit printed for the bounded fields (phase01/confidence 0..1, bpm to 0.1).\n45\tstatic inline int16_t k1ev_i16_scale(float v, float scale) {\n46\t  if (!isfinite(v)) {\n47\t    return 0;\n48\t  }\n49\t  long q = lroundf(v * scale);\n50\t  if (q > 32767L) return 32767;\n51\t  if (q < -32768L) return -32768;\n52\t  return (int16_t)q;\n53\t}\n54\t\n55\tbool k1ev_capture_ensure_buffer() {\n56\t  K1EV_CAPTURE_ALLOC_FAILED = false;\n57\t  if (K1EV_CAPTURE_BUFFER != nullptr) {\n58\t    return true;\n59\t  }\n60\t  K1EV_CAPTURE_BUFFER = (K1EVCaptureSample*)heap_caps_malloc(\n61\t    sizeof(K1EVCaptureSample) * (size_t)K1EV_CAPTURE_CAPACITY,\n62\t    MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);\n63\t  if (K1EV_CAPTURE_BUFFER == nullptr) {\n64\t    // Internal fallback (2 MiB will not fit internal RAM; this just yields a clean\n65\t    // null -> alloc_failed -> arm returns false, never a crash). Mirrors ap_cad.\n66\t    K1EV_CAPTURE_BUFFER = (K1EVCaptureSample*)heap_caps_malloc(\n67\t      sizeof(K1EVCaptureSample) * (size_t)K1EV_CAPTURE_CAPACITY,\n68\t      MALLOC_CAP_8BIT);\n69\t  }\n70\t  K1EV_CAPTURE_ALLOC_FAILED = (K1EV_CAPTURE_BUFFER == nullptr);\n71\t  return !K1EV_CAPTURE_ALLOC_FAILED;\n72\t}\n73\t\n74\tbool k1ev_capture_arm(uint32_t duration_ms) {\n75\t  if (duration_ms == 0 || duration_ms > K1EV_CAPTURE_MAX_MS) {\n76\t    return false;\n77\t  }\n78\t  if (!k1ev_capture_ensure_buffer()) {\n79\t    return false;\n80\t  }\n81\t  K1EV_CAPTURE_COUNT = 0;\n82\t  K1EV_CAPTURE_DROPPED = 0;\n83\t  K1EV_CAPTURE_FRAME_N = 0;\n84\t  K1EV_CAPTURE_START_MS = millis();\n85\t  K1EV_CAPTURE_END_MS = K1EV_CAPTURE_START_MS + duration_ms;\n86\t  K1EV_CAPTURE_ACTIVE = true;\n87\t  return true;\n88\t}\n89\t\n90\t// Hot path. Runs once per audio frame from loop() (post k1_tempo_update). MUST be\n91\t// minimal: append a struct, no printf, no USB. Append rule mirrors the retired\n92\t// k1ev_stream.h::k1ev_emit — append on any onset/beat frame OR every K1EV_STREAM_DECIMATE\n93\t// sample frame; heavy chroma/chord/mode/photons only on sample frames (has_chroma).\n94\tvoid k1ev_capture_tick(const K1AudioSnapshot& snap, const K1OnsetBeatEvent& ev) {\n95\t  if (!K1EV_CAPTURE_ACTIVE) {\n96\t    return;\n97\t  }\n98\t  // snap.frame_ms is the same millis()-domain clock ap_cad compares against.\n99\t  if ((int32_t)(snap.frame_ms - K1EV_CAPTURE_END_MS) >= 0) {\n100\t    K1EV_CAPTURE_ACTIVE = false;\n101\t    return;\n102\t  }\n103\t\n104\t  const bool onset_frame  = ev.onset || ev.bass_onset || ev.kick || ev.snare || ev.hihat || ev.beat;\n105\t  const bool sample_frame = ((K1EV_CAPTURE_FRAME_N++) % (uint32_t)K1EV_STREAM_DECIMATE) == 0;\n106\t  if (!onset_frame && !sample_frame) {\n107\t    return;\n108\t  }\n109\t  if (K1EV_CAPTURE_BUFFER == nullptr || K1EV_CAPTURE_COUNT >= (uint32_t)K1EV_CAPTURE_CAPACITY) {\n110\t    K1EV_CAPTURE_DROPPED++;\n111\t    return;\n112\t  }\n113\t\n114\t  const K1TempoEvent tev = k1_tempo_read();   // fresh: post k1_tempo_update\n115\t  K1EVCaptureSample& s = K1EV_CAPTURE_BUFFER[K1EV_CAPTURE_COUNT++];\n116\t\n117\t  // Always-present prefix fields.\n118\t  s.t_ms = snap.frame_ms;\n119\t  s.event_ms = ev.event_ms;\n120\t  s.event_id = ev.event_id;\n121\t  s.kick_event_id = ev.kick_event_id;\n122\t  s.snare_event_id = ev.snare_event_id;\n123\t  s.hihat_event_id = ev.hihat_event_id;\n124\t  s.bphase_q = k1ev_i16_scale(tev.phase01, 1000.0f);\n125\t  s.bconf_q  = k1ev_i16_scale(tev.confidence, 1000.0f);\n126\t  s.bpm_q10  = k1ev_i16_scale(tev.bpm, 10.0f);\n127\t\n128\t  uint8_t flags = 0;\n129\t  if (ev.onset)      flags |= 0x01;\n130\t  if (ev.bass_onset) flags |= 0x02;\n131\t  if (ev.kick)       flags |= 0x04;\n132\t  if (ev.snare)      flags |= 0x08;\n133\t  if (ev.hihat)      flags |= 0x10;\n134\t  if (tev.beat_tick) flags |= 0x20;   // printed as beat=  (tempo tick, not ev.beat)\n135\t\n136\t  if (sample_frame) {\n137\t    flags |= 0x40;                     // has_chroma\n138\t    const bool have_chord = (snap.chord.type != K1ChordType::NONE);\n139\t    s.croot = have_chord ? (int8_t)snap.chord.rootNote : (int8_t)-1;\n140\t    s.ctype = (uint8_t)snap.chord.type;\n141\t    s.cconf_q = k1ev_i16_scale(snap.chord.confidence, 1000.0f);\n142\t    for (int c = 0; c < K1_CHROMA_PC_BINS; c++) {\n143\t      s.chroma_q[c] = k1ev_i16_scale(snap.chroma_pc[c], 1000.0f);\n144\t    }\n145\t    s.mode = k1_mode_selection_read_state().applied_mode;\n146\t    s.photons = k1_smart_director_read_output().photons_scalar;\n147\t  }\n148\t  // On onset-only frames the heavy fields are intentionally left unwritten (kept\n149\t  // minimal); the dump reads them ONLY when the has_chroma bit is set.\n150\t  s.flags = flags;\n151\t}\n152\t\n153\t// Off the hot path. Piggybacked from the START of ap_nov_capture_dump() so this\n154\t// whole block lands BEFORE the NOV_CAPTURE_DONE marker the capture tool's\n155\t// read_until_done() stops on (device_novelty_buffer_capture.py) — the unmodified\n156\t// --capture-ap-stream flow therefore captures it with no tool edits. Reproduces the\n157\t// FROZEN [K1EV] wire format byte-for-byte so capture/parse_capture.py is unchanged.\n158\tvoid k1ev_capture_dump() {\n159\t  K1EV_CAPTURE_ACTIVE = false;\n160\t  USBSerial.print(\"K1EV_CAPTURE_BEGIN,count=\");\n161\t  USBSerial.print(K1EV_CAPTURE_COUNT);\n162\t  USBSerial.print(\",capacity=\");\n163\t  USBSerial.print((uint32_t)K1EV_CAPTURE_CAPACITY);\n164\t  USBSerial.print(\",dropped=\");\n165\t  USBSerial.println(K1EV_CAPTURE_DROPPED);\n166\t\n167\t  char b[384];\n168\t  for (uint32_t i = 0; i < K1EV_CAPTURE_COUNT; i++) {\n169\t    const K1EVCaptureSample& s = K1EV_CAPTURE_BUFFER[i];\n170\t    const bool onset = (s.flags & 0x01) != 0;\n171\t    const bool bass  = (s.flags & 0x02) != 0;\n172\t    const bool kick  = (s.flags & 0x04) != 0;\n173\t    const bool snare = (s.flags & 0x08) != 0;\n174\t    const bool hihat = (s.flags & 0x10) != 0;\n175\t    const bool beat  = (s.flags & 0x20) != 0;\n176\t\n177\t    int p = snprintf(b, sizeof(b),\n178\t      \"[K1EV] t_ms=%lu event_ms=%lu ev=%lu onset=%d bass=%d kick=%d snare=%d hihat=%d \"\n179\t      \"kid=%lu sid=%lu hid=%lu beat=%d bphase=%.3f bconf=%.3f bpm=%.1f\",\n180\t      (unsigned long)s.t_ms, (unsigned long)s.event_ms, (unsigned long)s.event_id,\n181\t      onset ? 1 : 0, bass ? 1 : 0, kick ? 1 : 0, snare ? 1 : 0, hihat ? 1 : 0,\n182\t      (unsigned long)s.kick_event_id, (unsigned long)s.snare_event_id, (unsigned long)s.hihat_event_id,\n183\t      beat ? 1 : 0,\n184\t      (double)s.bphase_q / 1000.0, (double)s.bconf_q / 1000.0, (double)s.bpm_q10 / 10.0);\n185\t\n186\t    if (s.flags & 0x40) {   // has_chroma: heavy fields present (sample frame)\n187\t      p += snprintf(b + p, sizeof(b) - p, \" croot=%d ctype=%d cconf=%.3f chroma=\",\n188\t                    (int)s.croot, (int)s.ctype, (double)s.cconf_q / 1000.0);\n189\t      for (int c = 0; c < K1_CHROMA_PC_BINS && p < (int)sizeof(b) - 12; c++) {\n190\t        p += snprintf(b + p, sizeof(b) - p, c ? \";%.3f\" : \"%.3f\", (double)s.chroma_q[c] / 1000.0);\n191\t      }\n192\t      p += snprintf(b + p, sizeof(b) - p, \" mode=%u photons=%.3f\", (unsigned)s.mode, (double)s.photons);\n193\t    }\n194\t    if (p < (int)sizeof(b) - 1) {\n195\t      b[p++] = '\\n';\n196\t    }\n197\t    USBSerial.write((const uint8_t*)b, (size_t)p);\n198\t    if ((i & 0x3F) == 0x3F) {   // yield every 64 lines (buffer holds up to 32768)\n199\t      vTaskDelay(1);\n200\t    }\n201\t  }\n202\t\n203\t  USBSerial.print(\"K1EV_CAPTURE_DONE,count=\");\n204\t  USBSerial.print(K1EV_CAPTURE_COUNT);\n205\t  USBSerial.print(\",dropped=\");\n206\t  USBSerial.println(K1EV_CAPTURE_DROPPED);\n207\t}\n208\t\n209\t#endif  // ENABLE_K1EV_STREAM\n210\t"}]},"parent_tool_use_id":null,"session_id":"16a76e6c-f56d-436e-9309-aa9c7ce3989f","uuid":"75f5a2ba-b170-4048-a23c-e075b3aa168a","timestamp":"2026-07-15T20:24:41.719Z","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/k1-ruflo-live/SPECTRASYNQ_K1_FIRMWARE/serial/k1ev_capture.cpp","content":"/*----------------------------------------\n  K1 `[K1EV]` BUFFERED telemetry capture — implementation\n  ----------------------------------------\n  Mode-A read-only analysis tap, buffered edition. Supersedes the live per-frame\n  emit in serial/k1ev_stream.h (see that header + k1ev_capture.h for the WHY: the\n  live USBSerial write per frame perturbed the pipeline it measures).\n\n  The whole unit is gated on ENABLE_K1EV_STREAM, defined ONLY in the non-shippable\n  [env:k1_bench_ap_frontend_probe]. As with k1_ap_capture_telemetry.cpp, the gate\n  is applied FIRST — BEFORE any #include — so that in production (k1_hardware /\n  k1_prod_im73d) this TU preprocesses to NOTHING: no header pull-in, no globals,\n  no static-initialiser ctor, hence zero bytes added to the release link (the\n  binary stays byte-identical).\n*/\n\n#ifdef ENABLE_K1EV_STREAM\n\n#include \"k1ev_capture.h\"\n#include \"globals.h\"             // USBSerial, millis, vTaskDelay (Arduino/FreeRTOS)\n#include \"k1_tempo.h\"            // K1TempoEvent, k1_tempo_read()\n#include \"k1_mode_selection.h\"   // k1_mode_selection_read_state()\n#include \"k1_smart_director.h\"   // k1_smart_director_read_output()\n#include <esp_heap_caps.h>       // heap_caps_malloc / MALLOC_CAP_SPIRAM\n#include <math.h>                // lroundf, isfinite\n\n// One record is exactly 64 B; assert it so the PSRAM budget claim can't silently\n// drift, and pin the chroma width to the pitch-class bin count.\nstatic_assert(sizeof(K1EVCaptureSample) == 64, \"K1EVCaptureSample must stay 64 B\");\nstatic_assert(K1_CHROMA_PC_BINS == 12, \"dump chroma loop assumes 12 pitch-class bins\");\n\n// ---- State (external linkage) ----------------------------------------------\nK1EVCaptureSample* K1EV_CAPTURE_BUFFER = nullptr;\nuint32_t K1EV_CAPTURE_COUNT = 0;\nuint32_t K1EV_CAPTURE_DROPPED = 0;\nuint32_t K1EV_CAPTURE_FRAME_N = 0;\nuint32_t K1EV_CAPTURE_START_MS = 0;\nuint32_t K1EV_CAPTURE_END_MS = 0;\nbool     K1EV_CAPTURE_ACTIVE = false;\nbool     K1EV_CAPTURE_ALLOC_FAILED = false;\n\n// Saturating fixed-point quantiser (semantics of ap_capture_i16_sat, kept local so\n// this TU stays independent of the ENABLE_AP_FRONTEND_DEBUG gate). round(v*scale)\n// then clamp to int16 — re-expanded /scale it reproduces the exact %.Nf the live\n// emit printed for the bounded fields (phase01/confidence 0..1, bpm to 0.1).\nstatic inline int16_t k1ev_i16_scale(float v, float scale) {\n  if (!isfinite(v)) {\n    return 0;\n  }\n  long q = lroundf(v * scale);\n  if (q > 32767L) return 32767;\n  if (q < -32768L) return -32768;\n  return (int16_t)q;\n}\n\nbool k1ev_capture_ensure_buffer() {\n  K1EV_CAPTURE_ALLOC_FAILED = false;\n  if (K1EV_CAPTURE_BUFFER != nullptr) {\n    return true;\n  }\n  K1EV_CAPTURE_BUFFER = (K1EVCaptureSample*)heap_caps_malloc(\n    sizeof(K1EVCaptureSample) * (size_t)K1EV_CAPTURE_CAPACITY,\n    MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);\n  if (K1EV_CAPTURE_BUFFER == nullptr) {\n    // Internal fallback (2 MiB will not fit internal RAM; this just yields a clean\n    // null -> alloc_failed -> arm returns false, never a crash). Mirrors ap_cad.\n    K1EV_CAPTURE_BUFFER = (K1EVCaptureSample*)heap_caps_malloc(\n      sizeof(K1EVCaptureSample) * (size_t)K1EV_CAPTURE_CAPACITY,\n      MALLOC_CAP_8BIT);\n  }\n  K1EV_CAPTURE_ALLOC_FAILED = (K1EV_CAPTURE_BUFFER == nullptr);\n  return !K1EV_CAPTURE_ALLOC_FAILED;\n}\n\nbool k1ev_capture_arm(uint32_t duration_ms) {\n  if (duration_ms == 0 || duration_ms > K1EV_CAPTURE_MAX_MS) {\n    return false;\n  }\n  if (!k1ev_capture_ensure_buffer()) {\n    return false;\n  }\n  K1EV_CAPTURE_COUNT = 0;\n  K1EV_CAPTURE_DROPPED = 0;\n  K1EV_CAPTURE_FRAME_N = 0;\n  K1EV_CAPTURE_START_MS = millis();\n  K1EV_CAPTURE_END_MS = K1EV_CAPTURE_START_MS + duration_ms;\n  K1EV_CAPTURE_ACTIVE = true;\n  return true;\n}\n\n// Hot path. Runs once per audio frame from loop() (post k1_tempo_update). MUST be\n// minimal: append a struct, no printf, no USB. Append rule mirrors the retired\n// k1ev_stream.h::k1ev_emit — append on any onset/beat frame OR every K1EV_STREAM_DECIMATE\n// sample frame; heavy chroma/chord/mode/photons only on sample frames (has_chroma).\nvoid k1ev_capture_tick(const K1AudioSnapshot& snap, const K1OnsetBeatEvent& ev) {\n  if (!K1EV_CAPTURE_ACTIVE) {\n    return;\n  }\n  // snap.frame_ms is the same millis()-domain clock ap_cad compares against.\n  if ((int32_t)(snap.frame_ms - K1EV_CAPTURE_END_MS) >= 0) {\n    K1EV_CAPTURE_ACTIVE = false;\n    return;\n  }\n\n  const bool onset_frame  = ev.onset || ev.bass_onset || ev.kick || ev.snare || ev.hihat || ev.beat;\n  const bool sample_frame = ((K1EV_CAPTURE_FRAME_N++) % (uint32_t)K1EV_STREAM_DECIMATE) == 0;\n  if (!onset_frame && !sample_frame) {\n    return;\n  }\n  if (K1EV_CAPTURE_BUFFER == nullptr || K1EV_CAPTURE_COUNT >= (uint32_t)K1EV_CAPTURE_CAPACITY) {\n    K1EV_CAPTURE_DROPPED++;\n    return;\n  }\n\n  const K1TempoEvent tev = k1_tempo_read();   // fresh: post k1_tempo_update\n  K1EVCaptureSample& s = K1EV_CAPTURE_BUFFER[K1EV_CAPTURE_COUNT++];\n\n  // Always-present prefix fields.\n  s.t_ms = snap.frame_ms;\n  s.event_ms = ev.event_ms;\n  s.event_id = ev.event_id;\n  s.kick_event_id = ev.kick_event_id;\n  s.snare_event_id = ev.snare_event_id;\n  s.hihat_event_id = ev.hihat_event_id;\n  s.bphase_q = k1ev_i16_scale(tev.phase01, 1000.0f);\n  s.bconf_q  = k1ev_i16_scale(tev.confidence, 1000.0f);\n  s.bpm_q10  = k1ev_i16_scale(tev.bpm, 10.0f);\n\n  uint8_t flags = 0;\n  if (ev.onset)      flags |= 0x01;\n  if (ev.bass_onset) flags |= 0x02;\n  if (ev.kick)       flags |= 0x04;\n  if (ev.snare)      flags |= 0x08;\n  if (ev.hihat)      flags |= 0x10;\n  if (tev.beat_tick) flags |= 0x20;   // printed as beat=  (tempo tick, not ev.beat)\n\n  if (sample_frame) {\n    flags |= 0x40;                     // has_chroma\n    const bool have_chord = (snap.chord.type != K1ChordType::NONE);\n    s.croot = have_chord ? (int8_t)snap.chord.rootNote : (int8_t)-1;\n    s.ctype = (uint8_t)snap.chord.type;\n    s.cconf_q = k1ev_i16_scale(snap.chord.confidence, 1000.0f);\n    for (int c = 0; c < K1_CHROMA_PC_BINS; c++) {\n      s.chroma_q[c] = k1ev_i16_scale(snap.chroma_pc[c], 1000.0f);\n    }\n    s.mode = k1_mode_selection_read_state().applied_mode;\n    s.photons = k1_smart_director_read_output().photons_scalar;\n  }\n  // On onset-only frames the heavy fields are intentionally left unwritten (kept\n  // minimal); the dump reads them ONLY when the has_chroma bit is set.\n  s.flags = flags;\n}\n\n// Off the hot path. Piggybacked from the START of ap_nov_capture_dump() so this\n// whole block lands BEFORE the NOV_CAPTURE_DONE marker the capture tool's\n// read_until_done() stops on (device_novelty_buffer_capture.py) — the unmodified\n// --capture-ap-stream flow therefore captures it with no tool edits. Reproduces the\n// FROZEN [K1EV] wire format byte-for-byte so capture/parse_capture.py is unchanged.\nvoid k1ev_capture_dump() {\n  K1EV_CAPTURE_ACTIVE = false;\n  USBSerial.print(\"K1EV_CAPTURE_BEGIN,count=\");\n  USBSerial.print(K1EV_CAPTURE_COUNT);\n  USBSerial.print(\",capacity=\");\n  USBSerial.print((uint32_t)K1EV_CAPTURE_CAPACITY);\n  USBSerial.print(\",dropped=\");\n  USBSerial.println(K1EV_CAPTURE_DROPPED);\n\n  char b[384];\n  for (uint32_t i = 0; i < K1EV_CAPTURE_COUNT; i++) {\n    const K1EVCaptureSample& s = K1EV_CAPTURE_BUFFER[i];\n    const bool onset = (s.flags & 0x01) != 0;\n    const bool bass  = (s.flags & 0x02) != 0;\n    const bool kick  = (s.flags & 0x04) != 0;\n    const bool snare = (s.flags & 0x08) != 0;\n    const bool hihat = (s.flags & 0x10) != 0;\n    const bool beat  = (s.flags & 0x20) != 0;\n\n    int p = snprintf(b, sizeof(b),\n      \"[K1EV] t_ms=%lu event_ms=%lu ev=%lu onset=%d bass=%d kick=%d snare=%d hihat=%d \"\n      \"kid=%lu sid=%lu hid=%lu beat=%d bphase=%.3f bconf=%.3f bpm=%.1f\",\n      (unsigned long)s.t_ms, (unsigned long)s.event_ms, (unsigned long)s.event_id,\n      onset ? 1 : 0, bass ? 1 : 0, kick ? 1 : 0, snare ? 1 : 0, hihat ? 1 : 0,\n      (unsigned long)s.kick_event_id, (unsigned long)s.snare_event_id, (unsigned long)s.hihat_event_id,\n      beat ? 1 : 0,\n      (double)s.bphase_q / 1000.0, (double)s.bconf_q / 1000.0, (double)s.bpm_q10 / 10.0);\n\n    if (s.flags & 0x40) {   // has_chroma: heavy fields present (sample frame)\n      p += snprintf(b + p, sizeof(b) - p, \" croot=%d ctype=%d cconf=%.3f chroma=\",\n                    (int)s.croot, (int)s.ctype, (double)s.cconf_q / 1000.0);\n      for (int c = 0; c < K1_CHROMA_PC_BINS && p < (int)sizeof(b) - 12; c++) {\n        p += snprintf(b + p, sizeof(b) - p, c ? \";%.3f\" : \"%.3f\", (double)s.chroma_q[c] / 1000.0);\n      }\n      p += snprintf(b + p, sizeof(b) - p, \" mode=%u photons=%.3f\", (unsigned)s.mode, (double)s.photons);\n    }\n    if (p < (int)sizeof(b) - 1) {\n      b[p++] = '\\n';\n    }\n    USBSerial.write((const uint8_t*)b, (size_t)p);\n    if ((i & 0x3F) == 0x3F) {   // yield every 64 lines (buffer holds up to 32768)\n      vTaskDelay(1);\n    }\n  }\n\n  USBSerial.print(\"K1EV_CAPTURE_DONE,count=\");\n  USBSerial.print(K1EV_CAPTURE_COUNT);\n  USBSerial.print(\",dropped=\");\n  USBSerial.println(K1EV_CAPTURE_DROPPED);\n}\n\n#endif  // ENABLE_K1EV_STREAM\n","numLines":210,"startLine":1,"totalLines":210}}}
