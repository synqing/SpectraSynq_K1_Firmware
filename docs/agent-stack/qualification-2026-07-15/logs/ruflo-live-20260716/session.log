{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cd4UQheECeWSLBvmzcHLx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EF77KPCkuQsAAZkHUMDf4r","name":"Write","input":{"file_path":"/private/tmp/k1-ruflo-live/scripts/regression-harness/k1ev_capture_parse.py","content":"#!/usr/bin/env python3\n\"\"\"k1ev_capture_parse.py — host-side parser/validator for the buffered [K1EV]\nMode-A telemetry capture wire format.\n\nWire format (frozen, verified against k1ev_capture.cpp snprintf/println call\nsites, not just header comments):\n\nWrapper lines (USBSerial.println, generic line-split tolerant):\n  K1EV_CAPTURE_BEGIN,count=<u32>,capacity=<u32>,dropped=<u32>\n  K1EV_CAPTURE_DONE,count=<u32>,dropped=<u32>          (no capacity field)\n\nPer-sample base line, always prefixed \"[K1EV] \":\n  [K1EV] t_ms=%lu event_ms=%lu ev=%lu onset=%d bass=%d kick=%d snare=%d\n         hihat=%d kid=%lu sid=%lu hid=%lu beat=%d bphase=%.3f bconf=%.3f\n         bpm=%.1f\n\n  - t_ms/event_ms/ev/kid/sid/hid: unsigned (uint32 domain), parsed as int.\n  - onset/bass/kick/snare/hihat/beat: 0/1 flags. NOTE: `beat` here is the\n    tempo flywheel beat_tick, NOT ev.beat -- no parser-visible difference,\n    it's a firmware-source distinction only.\n  - bphase/bconf: floats, always printed with exactly 3 decimals (%.3f).\n  - bpm: float, always printed with exactly 1 decimal (%.1f).\n\nOptional has_chroma suffix -- present only on decimated \"sample_frame\" rows,\ndetected by the literal substring \" croot=\" (never inferred from onset/beat,\nsince a row can be onset AND sample_frame simultaneously):\n  croot=%d ctype=%d cconf=%.3f chroma=<v0>;...;<v11> mode=%u photons=%.3f\n\n  - croot: int, -1 (NONE sentinel) or 0..11 (A-origin pitch class).\n  - ctype: int 0..4 enum (0=NONE,1=MAJOR,2=MINOR,3=DIMINISHED,4=AUGMENTED).\n  - cconf: float, 3 decimals.\n  - chroma: exactly 12 semicolon-separated floats (3 decimals each), A-origin.\n  - mode: unsigned int (applied_mode).\n  - photons: float, 3 decimals (pinned precision, not default printf).\n\nSemantic invariant: croot == -1 iff ctype == ChordType.NONE (0). A capture\nrow where these disagree is a data-integrity bug, not a parse error --\nvalidate_chord_invariant() flags it without raising.\n\nSample-line count must equal K1EV_CAPTURE_DONE's count= field exactly.\n`dropped` reports frames that hit ring capacity and were never appended, so\nno adjustment against the emitted line count is needed.\n\"\"\"\nfrom __future__ import annotations\n\nimport re\nfrom dataclasses import dataclass, field\nfrom typing import Optional\n\n\nclass K1EVCaptureParseError(RuntimeError):\n    \"\"\"Raised when a K1EV capture wrapper or sample line cannot be parsed.\"\"\"\n\n\n# ---------------------------------------------------------------------------\n# Data model\n# ---------------------------------------------------------------------------\n\n\nclass ChordType:\n    \"\"\"ctype enum values, mirroring firmware ChordType.\"\"\"\n\n    NONE = 0\n    MAJOR = 1\n    MINOR = 2\n    DIMINISHED = 3\n    AUGMENTED = 4\n\n\n@dataclass\nclass K1EVSample:\n    \"\"\"One parsed [K1EV] sample line.\"\"\"\n\n    t_ms: int\n    event_ms: int\n    ev: int\n    onset: int\n    bass: int\n    kick: int\n    snare: int\n    hihat: int\n    kid: int\n    sid: int\n    hid: int\n    beat: int\n    bphase: float\n    bconf: float\n    bpm: float\n\n    # has_chroma fields; None when the row has no \" croot=\" suffix.\n    croot: Optional[int] = None\n    ctype: Optional[int] = None\n    cconf: Optional[float] = None\n    chroma: Optional[list] = field(default=None)\n    mode: Optional[int] = None\n    photons: Optional[float] = None\n\n    @property\n    def has_chroma(self) -> bool:\n        return self.croot is not None\n\n\n@dataclass\nclass K1EVCaptureRun:\n    \"\"\"A full parsed capture: wrapper metadata + all sample rows.\"\"\"\n\n    begin_count: int\n    begin_capacity: int\n    begin_dropped: int\n    done_count: int\n    done_dropped: int\n    samples: list\n\n\n# ---------------------------------------------------------------------------\n# Wrapper-line parsing\n# ---------------------------------------------------------------------------\n\n_BEGIN_RE = re.compile(\n    r\"^K1EV_CAPTURE_BEGIN,count=(?P<count>\\d+),capacity=(?P<capacity>\\d+),\"\n    r\"dropped=(?P<dropped>\\d+)\\s*$\"\n)\n_DONE_RE = re.compile(\n    r\"^K1EV_CAPTURE_DONE,count=(?P<count>\\d+),dropped=(?P<dropped>\\d+)\\s*$\"\n)\n\n\ndef parse_begin_line(line: str) -> dict:\n    \"\"\"Parse a K1EV_CAPTURE_BEGIN wrapper line into {count, capacity, dropped}.\"\"\"\n    m = _BEGIN_RE.match(line.strip())\n    if not m:\n        raise K1EVCaptureParseError(f\"malformed K1EV_CAPTURE_BEGIN line: {line!r}\")\n    return {\n        \"count\": int(m.group(\"count\")),\n        \"capacity\": int(m.group(\"capacity\")),\n        \"dropped\": int(m.group(\"dropped\")),\n    }\n\n\ndef parse_done_line(line: str) -> dict:\n    \"\"\"Parse a K1EV_CAPTURE_DONE wrapper line into {count, dropped}.\"\"\"\n    m = _DONE_RE.match(line.strip())\n    if not m:\n        raise K1EVCaptureParseError(f\"malformed K1EV_CAPTURE_DONE line: {line!r}\")\n    return {\n        \"count\": int(m.group(\"count\")),\n        \"dropped\": int(m.group(\"dropped\")),\n    }\n\n\n# ---------------------------------------------------------------------------\n# Sample-line parsing\n# ---------------------------------------------------------------------------\n\n_SAMPLE_PREFIX = \"[K1EV] \"\n\n_BASE_FIELD_ORDER = [\n    \"t_ms\",\n    \"event_ms\",\n    \"ev\",\n    \"onset\",\n    \"bass\",\n    \"kick\",\n    \"snare\",\n    \"hihat\",\n    \"kid\",\n    \"sid\",\n    \"hid\",\n    \"beat\",\n    \"bphase\",\n    \"bconf\",\n    \"bpm\",\n]\n\n_INT_FIELDS = {\n    \"t_ms\",\n    \"event_ms\",\n    \"ev\",\n    \"onset\",\n    \"bass\",\n    \"kick\",\n    \"snare\",\n    \"hihat\",\n    \"kid\",\n    \"sid\",\n    \"hid\",\n    \"beat\",\n}\n_FLOAT_FIELDS = {\"bphase\", \"bconf\", \"bpm\"}\n\n_CHROMA_FIELD_ORDER = [\"croot\", \"ctype\", \"cconf\", \"chroma\", \"mode\", \"photons\"]\n_CHROMA_INT_FIELDS = {\"croot\", \"ctype\", \"mode\"}\n_CHROMA_FLOAT_FIELDS = {\"cconf\", \"photons\"}\n\n\ndef _tokenize_kv(text: str) -> dict:\n    \"\"\"Split a space-separated `key=value` run into a dict, preserving order\n    is not required since callers look fields up by name.\"\"\"\n    out = {}\n    for tok in text.split(\" \"):\n        if not tok:\n            continue\n        if \"=\" not in tok:\n            raise K1EVCaptureParseError(f\"malformed key=value token: {tok!r}\")\n        k, v = tok.split(\"=\", 1)\n        out[k] = v\n    return out\n\n\ndef parse_sample_line(line: str) -> K1EVSample:\n    \"\"\"Parse one `[K1EV] ...` sample line into a K1EVSample.\n\n    Raises K1EVCaptureParseError on any malformed/truncated line (missing\n    prefix, missing required field, non-numeric value, malformed chroma\n    vector, etc.) -- never returns None or a partially-populated record.\n    \"\"\"\n    stripped = line.rstrip(\"\\r\\n\")\n    if not stripped.startswith(_SAMPLE_PREFIX):\n        raise K1EVCaptureParseError(f\"sample line missing '[K1EV] ' prefix: {line!r}\")\n\n    body = stripped[len(_SAMPLE_PREFIX):]\n    has_chroma = \" croot=\" in (\" \" + body)\n\n    if has_chroma:\n        # Split off the chroma suffix at the croot= boundary.\n        idx = body.index(\"croot=\")\n        base_part = body[:idx].strip()\n        chroma_part = body[idx:].strip()\n    else:\n        base_part = body.strip()\n        chroma_part = None\n\n    base_kv = _tokenize_kv(base_part)\n    missing = [f for f in _BASE_FIELD_ORDER if f not in base_kv]\n    if missing:\n        raise K1EVCaptureParseError(\n            f\"sample line missing required field(s) {missing}: {line!r}\"\n        )\n\n    parsed = {}\n    for f in _BASE_FIELD_ORDER:\n        raw_val = base_kv[f]\n        try:\n            if f in _INT_FIELDS:\n                parsed[f] = int(raw_val)\n            else:\n                parsed[f] = float(raw_val)\n        except ValueError as exc:\n            raise K1EVCaptureParseError(\n                f\"field {f!r} not numeric ({raw_val!r}) in line: {line!r}\"\n            ) from exc\n\n    chroma_kv = {}\n    croot = ctype_ = cconf = chroma = mode = photons = None\n    if chroma_part is not None:\n        # chroma is itself a \"chroma=<v0>;...;<v11>\" token, incompatible with\n        # naive whitespace tokenizing of the other key=value pairs since its\n        # value has no spaces -- safe to tokenize the whole thing by space.\n        chroma_tokens = chroma_part.split(\" \")\n        for tok in chroma_tokens:\n            if not tok:\n                continue\n            if \"=\" not in tok:\n                raise K1EVCaptureParseError(f\"malformed chroma token: {tok!r}\")\n            k, v = tok.split(\"=\", 1)\n            chroma_kv[k] = v\n\n        missing_c = [f for f in _CHROMA_FIELD_ORDER if f not in chroma_kv]\n        if missing_c:\n            raise K1EVCaptureParseError(\n                f\"has_chroma line missing field(s) {missing_c}: {line!r}\"\n            )\n\n        try:\n            croot = int(chroma_kv[\"croot\"])\n            ctype_ = int(chroma_kv[\"ctype\"])\n            mode = int(chroma_kv[\"mode\"])\n            cconf = float(chroma_kv[\"cconf\"])\n            photons = float(chroma_kv[\"photons\"])\n        except ValueError as exc:\n            raise K1EVCaptureParseError(\n                f\"non-numeric chord/photons field in line: {line!r}\"\n            ) from exc\n\n        chroma_raw = chroma_kv[\"chroma\"].split(\";\")\n        if len(chroma_raw) != 12:\n            raise K1EVCaptureParseError(\n                f\"chroma vector must have exactly 12 values, got \"\n                f\"{len(chroma_raw)}: {line!r}\"\n            )\n        try:\n            chroma = [float(v) for v in chroma_raw]\n        except ValueError as exc:\n            raise K1EVCaptureParseError(\n                f\"non-numeric chroma value in line: {line!r}\"\n            ) from exc\n\n    return K1EVSample(\n        t_ms=parsed[\"t_ms\"],\n        event_ms=parsed[\"event_ms\"],\n        ev=parsed[\"ev\"],\n        onset=parsed[\"onset\"],\n        bass=parsed[\"bass\"],\n        kick=parsed[\"kick\"],\n        snare=parsed[\"snare\"],\n        hihat=parsed[\"hihat\"],\n        kid=parsed[\"kid\"],\n        sid=parsed[\"sid\"],\n        hid=parsed[\"hid\"],\n        beat=parsed[\"beat\"],\n        bphase=parsed[\"bphase\"],\n        bconf=parsed[\"bconf\"],\n        bpm=parsed[\"bpm\"],\n        croot=croot,\n        ctype=ctype_,\n        cconf=cconf,\n        chroma=chroma,\n        mode=mode,\n        photons=photons,\n    )\n\n\n# ---------------------------------------------------------------------------\n# Whole-capture parsing\n# ---------------------------------------------------------------------------\n\n\ndef parse_k1ev_capture(text: str) -> K1EVCaptureRun:\n    \"\"\"Parse a full buffered K1EV capture (BEGIN wrapper, sample lines, DONE\n    wrapper) into a K1EVCaptureRun.\n\n    Raises K1EVCaptureParseError if BEGIN/DONE wrappers are missing or\n    malformed, or if any [K1EV] sample line is malformed.\n    \"\"\"\n    lines = text.splitlines()\n\n    begin_info = None\n    done_info = None\n    samples = []\n\n    for raw in lines:\n        line = raw.strip()\n        if not line:\n            continue\n        if line.startswith(\"K1EV_CAPTURE_BEGIN\"):\n            begin_info = parse_begin_line(line)\n        elif line.startswith(\"K1EV_CAPTURE_DONE\"):\n            done_info = parse_done_line(line)\n        elif line.startswith(_SAMPLE_PREFIX.strip()):\n            samples.append(parse_sample_line(raw))\n        # else: ignore unrelated lines (other harness output interleaved).\n\n    if begin_info is None:\n        raise K1EVCaptureParseError(\"capture text missing K1EV_CAPTURE_BEGIN line\")\n    if done_info is None:\n        raise K1EVCaptureParseError(\"capture text missing K1EV_CAPTURE_DONE line\")\n\n    return K1EVCaptureRun(\n        begin_count=begin_info[\"count\"],\n        begin_capacity=begin_info[\"capacity\"],\n        begin_dropped=begin_info[\"dropped\"],\n        done_count=done_info[\"count\"],\n        done_dropped=done_info[\"dropped\"],\n        samples=samples,\n    )\n\n\n# ---------------------------------------------------------------------------\n# Semantic validators\n# ---------------------------------------------------------------------------\n\n\ndef validate_chord_invariant(sample: K1EVSample) -> Optional[str]:\n    \"\"\"Check the croot/ctype consistency invariant for a has_chroma sample.\n\n    croot == -1 iff ctype == ChordType.NONE. Returns None if consistent (or\n    if the sample has no chroma data at all), otherwise a human-readable\n    description of the violation. Does not raise -- callers decide whether\n    to treat a violation as fatal.\n    \"\"\"\n    if not sample.has_chroma:\n        return None\n\n    is_none_root = sample.croot == -1\n    is_none_type = sample.ctype == ChordType.NONE\n    if is_none_root != is_none_type:\n        return (\n            f\"croot/ctype invariant violated: croot={sample.croot} \"\n            f\"ctype={sample.ctype} (expected croot==-1 iff ctype==NONE)\"\n        )\n    return None\n\n\ndef validate_capture_run(run: K1EVCaptureRun) -> list:\n    \"\"\"Validate an entire parsed capture run.\n\n    Returns a list of human-readable violation strings (empty if clean).\n    Checks:\n      - sample count equals K1EV_CAPTURE_DONE's count= field\n      - croot/ctype invariant on every has_chroma sample\n    \"\"\"\n    violations = []\n\n    if len(run.samples) != run.done_count:\n        violations.append(\n            f\"sample count mismatch: parsed {len(run.samples)} sample lines, \"\n            f\"DONE reported count={run.done_count}\"\n        )\n\n    for i, sample in enumerate(run.samples):\n        msg = validate_chord_invariant(sample)\n        if msg:\n            violations.append(f\"sample[{i}] (t_ms={sample.t_ms}): {msg}\")\n\n    return violations\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1284,"cache_read_input_tokens":122322,"cache_creation":{"ephemeral_5m_input_tokens":1284,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_013N9Y1C3fbUG1Hgeccu4BBw","session_id":"16a76e6c-f56d-436e-9309-aa9c7ce3989f","uuid":"ba3d2d5f-b7c2-4290-9cef-80f413bf4c22","request_id":"req_011Cd4UQgHcyFckKMVCr8wnn","subagent_type":"general-purpose","task_description":"K1EV parser/validator implementation"}
