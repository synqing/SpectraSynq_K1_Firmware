{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0189awDAei2gssWhqDQvAmxt","type":"tool_result","content":"1\t/*----------------------------------------\n2\t  K1 `[K1EV]` BUFFERED telemetry capture — implementation\n3\t  ----------------------------------------\n4\t  Mode-A read-only analysis tap, buffered edition. Supersedes the live per-frame\n5\t  emit in serial/k1ev_stream.h (see that header + k1ev_capture.h for the WHY: the\n6\t  live USBSerial write per frame perturbed the pipeline it measures).\n7\t\n8\t  The whole unit is gated on ENABLE_K1EV_STREAM, defined ONLY in the non-shippable\n9\t  [env:k1_bench_ap_frontend_probe]. As with k1_ap_capture_telemetry.cpp, the gate\n10\t  is applied FIRST — BEFORE any #include — so that in production (k1_hardware /\n11\t  k1_prod_im73d) this TU preprocesses to NOTHING: no header pull-in, no globals,\n12\t  no static-initialiser ctor, hence zero bytes added to the release link (the\n13\t  binary stays byte-identical).\n14\t*/\n15\t\n16\t#ifdef ENABLE_K1EV_STREAM\n17\t\n18\t#include \"k1ev_capture.h\"\n19\t#include \"globals.h\"             // USBSerial, millis, vTaskDelay (Arduino/FreeRTOS)\n20\t#include \"k1_tempo.h\"            // K1TempoEvent, k1_tempo_read()\n21\t#include \"k1_mode_selection.h\"   // k1_mode_selection_read_state()\n22\t#include \"k1_smart_director.h\"   // k1_smart_director_read_output()\n23\t#include <esp_heap_caps.h>       // heap_caps_malloc / MALLOC_CAP_SPIRAM\n24\t#include <math.h>                // lroundf, isfinite\n25\t\n26\t// One record is exactly 64 B; assert it so the PSRAM budget claim can't silently\n27\t// drift, and pin the chroma width to the pitch-class bin count.\n28\tstatic_assert(sizeof(K1EVCaptureSample) == 64, \"K1EVCaptureSample must stay 64 B\");\n29\tstatic_assert(K1_CHROMA_PC_BINS == 12, \"dump chroma loop assumes 12 pitch-class bins\");\n30\t\n31\t// ---- State (external linkage) ----------------------------------------------\n32\tK1EVCaptureSample* K1EV_CAPTURE_BUFFER = nullptr;\n33\tuint32_t K1EV_CAPTURE_COUNT = 0;\n34\tuint32_t K1EV_CAPTURE_DROPPED = 0;\n35\tuint32_t K1EV_CAPTURE_FRAME_N = 0;\n36\tuint32_t K1EV_CAPTURE_START_MS = 0;\n37\tuint32_t K1EV_CAPTURE_END_MS = 0;\n38\tbool     K1EV_CAPTURE_ACTIVE = false;\n39\tbool     K1EV_CAPTURE_ALLOC_FAILED = false;\n40\t\n41\t// Saturating fixed-point quantiser (semantics of ap_capture_i16_sat, kept local so\n42\t// this TU stays independent of the ENABLE_AP_FRONTEND_DEBUG gate). round(v*scale)\n43\t// then clamp to int16 — re-expanded /scale it reproduces the exact %.Nf the live\n44\t// emit printed for the bounded fields (phase01/confidence 0..1, bpm to 0.1).\n45\tstatic inline int16_t k1ev_i16_scale(float v, float scale) {\n46\t  if (!isfinite(v)) {\n47\t    return 0;\n48\t  }\n49\t  long q = lroundf(v * scale);\n50\t  if (q > 32767L) return 32767;\n51\t  if (q < -32768L) return -32768;\n52\t  return (int16_t)q;\n53\t}\n54\t\n55\tbool k1ev_capture_ensure_buffer() {\n56\t  K1EV_CAPTURE_ALLOC_FAILED = false;\n57\t  if (K1EV_CAPTURE_BUFFER != nullptr) {\n58\t    return true;\n59\t  }\n60\t  K1EV_CAPTURE_BUFFER = (K1EVCaptureSample*)heap_caps_malloc(\n61\t    sizeof(K1EVCaptureSample) * (size_t)K1EV_CAPTURE_CAPACITY,\n62\t    MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);\n63\t  if (K1EV_CAPTURE_BUFFER == nullptr) {\n64\t    // Internal fallback (2 MiB will not fit internal RAM; this just yields a clean\n65\t    // null -> alloc_failed -> arm returns false, never a crash). Mirrors ap_cad.\n66\t    K1EV_CAPTURE_BUFFER = (K1EVCaptureSample*)heap_caps_malloc(\n67\t      sizeof(K1EVCaptureSample) * (size_t)K1EV_CAPTURE_CAPACITY,\n68\t      MALLOC_CAP_8BIT);\n69\t  }\n70\t  K1EV_CAPTURE_ALLOC_FAILED = (K1EV_CAPTURE_BUFFER == nullptr);\n71\t  return !K1EV_CAPTURE_ALLOC_FAILED;\n72\t}\n73\t\n74\tbool k1ev_capture_arm(uint32_t duration_ms) {\n75\t  if (duration_ms == 0 || duration_ms > K1EV_CAPTURE_MAX_MS) {\n76\t    return false;\n77\t  }\n78\t  if (!k1ev_capture_ensure_buffer()) {\n79\t    return false;\n80\t  }\n81\t  K1EV_CAPTURE_COUNT = 0;\n82\t  K1EV_CAPTURE_DROPPED = 0;\n83\t  K1EV_CAPTURE_FRAME_N = 0;\n84\t  K1EV_CAPTURE_START_MS = millis();\n85\t  K1EV_CAPTURE_END_MS = K1EV_CAPTURE_START_MS + duration_ms;\n86\t  K1EV_CAPTURE_ACTIVE = true;\n87\t  return true;\n88\t}\n89\t\n90\t// Hot path. Runs once per audio frame from loop() (post k1_tempo_update). MUST be\n91\t// minimal: append a struct, no printf, no USB. Append rule mirrors the retired\n92\t// k1ev_stream.h::k1ev_emit — append on any onset/beat frame OR every K1EV_STREAM_DECIMATE\n93\t// sample frame; heavy chroma/chord/mode/photons only on sample frames (has_chroma).\n94\tvoid k1ev_capture_tick(const K1AudioSnapshot& snap, const K1OnsetBeatEvent& ev) {\n95\t  if (!K1EV_CAPTURE_ACTIVE) {\n96\t    return;\n97\t  }\n98\t  // snap.frame_ms is the same millis()-domain clock ap_cad compares against.\n99\t  if ((int32_t)(snap.frame_ms - K1EV_CAPTURE_END_MS) >= 0) {\n100\t    K1EV_CAPTURE_ACTIVE = false;\n101\t    return;\n102\t  }\n103\t\n104\t  const bool onset_frame  = ev.onset || ev.bass_onset || ev.kick || ev.snare || ev.hihat || ev.beat;\n105\t  const bool sample_frame = ((K1EV_CAPTURE_FRAME_N++) % (uint32_t)K1EV_STREAM_DECIMATE) == 0;\n106\t  if (!onset_frame && !sample_frame) {\n107\t    return;\n108\t  }\n109\t  if (K1EV_CAPTURE_BUFFER == nullptr || K1EV_CAPTURE_COUNT >= (uint32_t)K1EV_CAPTURE_CAPACITY) {\n110\t    K1EV_CAPTURE_DROPPED++;\n111\t    return;\n112\t  }\n113\t\n114\t  const K1TempoEvent tev = k1_tempo_read();   // fresh: post k1_tempo_update\n115\t  K1EVCaptureSample& s = K1EV_CAPTURE_BUFFER[K1EV_CAPTURE_COUNT++];\n116\t\n117\t  // Always-present prefix fields.\n118\t  s.t_ms = snap.frame_ms;\n119\t  s.event_ms = ev.event_ms;\n120\t  s.event_id = ev.event_id;\n121\t  s.kick_event_id = ev.kick_event_id;\n122\t  s.snare_event_id = ev.snare_event_id;\n123\t  s.hihat_event_id = ev.hihat_event_id;\n124\t  s.bphase_q = k1ev_i16_scale(tev.phase01, 1000.0f);\n125\t  s.bconf_q  = k1ev_i16_scale(tev.confidence, 1000.0f);\n126\t  s.bpm_q10  = k1ev_i16_scale(tev.bpm, 10.0f);\n127\t\n128\t  uint8_t flags = 0;\n129\t  if (ev.onset)      flags |= 0x01;\n130\t  if (ev.bass_onset) flags |= 0x02;\n131\t  if (ev.kick)       flags |= 0x04;\n132\t  if (ev.snare)      flags |= 0x08;\n133\t  if (ev.hihat)      flags |= 0x10;\n134\t  if (tev.beat_tick) flags |= 0x20;   // printed as beat=  (tempo tick, not ev.beat)\n135\t\n136\t  if (sample_frame) {\n137\t    flags |= 0x40;                     // has_chroma\n138\t    const bool have_chord = (snap.chord.type != K1ChordType::NONE);\n139\t    s.croot = have_chord ? (int8_t)snap.chord.rootNote : (int8_t)-1;\n140\t    s.ctype = (uint8_t)snap.chord.type;\n141\t    s.cconf_q = k1ev_i16_scale(snap.chord.confidence, 1000.0f);\n142\t    for (int c = 0; c < K1_CHROMA_PC_BINS; c++) {\n143\t      s.chroma_q[c] = k1ev_i16_scale(snap.chroma_pc[c], 1000.0f);\n144\t    }\n145\t    s.mode = k1_mode_selection_read_state().applied_mode;\n146\t    s.photons = k1_smart_director_read_output().photons_scalar;\n147\t  }\n148\t  // On onset-only frames the heavy fields are intentionally left unwritten (kept\n149\t  // minimal); the dump reads them ONLY when the has_chroma bit is set.\n150\t  s.flags = flags;\n151\t}\n152\t\n153\t// Off the hot path. Piggybacked from the START of ap_nov_capture_dump() so this\n154\t// whole block lands BEFORE the NOV_CAPTURE_DONE marker the capture tool's\n155\t// read_until_done() stops on (device_novelty_buffer_capture.py) — the unmodified\n156\t// --capture-ap-stream flow therefore captures it with no tool edits. Reproduces the\n157\t// FROZEN [K1EV] wire format byte-for-byte so capture/parse_capture.py is unchanged.\n158\tvoid k1ev_capture_dump() {\n159\t  K1EV_CAPTURE_ACTIVE = false;\n160\t  USBSerial.print(\"K1EV_CAPTURE_BEGIN,count=\");\n161\t  USBSerial.print(K1EV_CAPTURE_COUNT);\n162\t  USBSerial.print(\",capacity=\");\n163\t  USBSerial.print((uint32_t)K1EV_CAPTURE_CAPACITY);\n164\t  USBSerial.print(\",dropped=\");\n165\t  USBSerial.println(K1EV_CAPTURE_DROPPED);\n166\t\n167\t  char b[384];\n168\t  for (uint32_t i = 0; i < K1EV_CAPTURE_COUNT; i++) {\n169\t    const K1EVCaptureSample& s = K1EV_CAPTURE_BUFFER[i];\n170\t    const bool onset = (s.flags & 0x01) != 0;\n171\t    const bool bass  = (s.flags & 0x02) != 0;\n172\t    const bool kick  = (s.flags & 0x04) != 0;\n173\t    const bool snare = (s.flags & 0x08) != 0;\n174\t    const bool hihat = (s.flags & 0x10) != 0;\n175\t    const bool beat  = (s.flags & 0x20) != 0;\n176\t\n177\t    int p = snprintf(b, sizeof(b),\n178\t      \"[K1EV] t_ms=%lu event_ms=%lu ev=%lu onset=%d bass=%d kick=%d snare=%d hihat=%d \"\n179\t      \"kid=%lu sid=%lu hid=%lu beat=%d bphase=%.3f bconf=%.3f bpm=%.1f\",\n180\t      (unsigned long)s.t_ms, (unsigned long)s.event_ms, (unsigned long)s.event_id,\n181\t      onset ? 1 : 0, bass ? 1 : 0, kick ? 1 : 0, snare ? 1 : 0, hihat ? 1 : 0,\n182\t      (unsigned long)s.kick_event_id, (unsigned long)s.snare_event_id, (unsigned long)s.hihat_event_id,\n183\t      beat ? 1 : 0,\n184\t      (double)s.bphase_q / 1000.0, (double)s.bconf_q / 1000.0, (double)s.bpm_q10 / 10.0);\n185\t\n186\t    if (s.flags & 0x40) {   // has_chroma: heavy fields present (sample frame)\n187\t      p += snprintf(b + p, sizeof(b) - p, \" croot=%d ctype=%d cconf=%.3f chroma=\",\n188\t                    (int)s.croot, (int)s.ctype, (double)s.cconf_q / 1000.0);\n189\t      for (int c = 0; c < K1_CHROMA_PC_BINS && p < (int)sizeof(b) - 12; c++) {\n190\t        p += snprintf(b + p, sizeof(b) - p, c ? \";%.3f\" : \"%.3f\", (double)s.chroma_q[c] / 1000.0);\n191\t      }\n192\t      p += snprintf(b + p, sizeof(b) - p, \" mode=%u photons=%.3f\", (unsigned)s.mode, (double)s.photons);\n193\t    }\n194\t    if (p < (int)sizeof(b) - 1) {\n195\t      b[p++] = '\\n';\n196\t    }\n197\t    USBSerial.write((const uint8_t*)b, (size_t)p);\n198\t    if ((i & 0x3F) == 0x3F) {   // yield every 64 lines (buffer holds up to 32768)\n199\t      vTaskDelay(1);\n200\t    }\n201\t  }\n202\t\n203\t  USBSerial.print(\"K1EV_CAPTURE_DONE,count=\");\n204\t  USBSerial.print(K1EV_CAPTURE_COUNT);\n205\t  USBSerial.print(\",dropped=\");\n206\t  USBSerial.println(K1EV_CAPTURE_DROPPED);\n207\t}\n208\t\n209\t#endif  // ENABLE_K1EV_STREAM\n210\t"}]},"parent_tool_use_id":"toolu_019hSTdbYSrDRtayTkVr2QNF","session_id":"16a76e6c-f56d-436e-9309-aa9c7ce3989f","uuid":"f619f79c-e36b-4669-aa81-37cf124b083d","timestamp":"2026-07-15T20:25:50.177Z","subagent_type":"general-purpose","task_description":"K1EV test design (read-only)"}
