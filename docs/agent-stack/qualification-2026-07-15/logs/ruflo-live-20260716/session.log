{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017YGQv7Zduqd85awKcGAzEF","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"k1ev_capture_parse.py — host-side parser/validator for the buffered [K1EV]\n3\tMode-A telemetry capture wire format.\n4\t\n5\tWire format (frozen, verified against k1ev_capture.cpp snprintf/println call\n6\tsites, not just header comments):\n7\t\n8\tWrapper lines (USBSerial.println, generic line-split tolerant):\n9\t  K1EV_CAPTURE_BEGIN,count=<u32>,capacity=<u32>,dropped=<u32>\n10\t  K1EV_CAPTURE_DONE,count=<u32>,dropped=<u32>          (no capacity field)\n11\t\n12\tPer-sample base line, always prefixed \"[K1EV] \":\n13\t  [K1EV] t_ms=%lu event_ms=%lu ev=%lu onset=%d bass=%d kick=%d snare=%d\n14\t         hihat=%d kid=%lu sid=%lu hid=%lu beat=%d bphase=%.3f bconf=%.3f\n15\t         bpm=%.1f\n16\t\n17\t  - t_ms/event_ms/ev/kid/sid/hid: unsigned (uint32 domain), parsed as int.\n18\t  - onset/bass/kick/snare/hihat/beat: 0/1 flags. NOTE: `beat` here is the\n19\t    tempo flywheel beat_tick, NOT ev.beat -- no parser-visible difference,\n20\t    it's a firmware-source distinction only.\n21\t  - bphase/bconf: floats, always printed with exactly 3 decimals (%.3f).\n22\t  - bpm: float, always printed with exactly 1 decimal (%.1f).\n23\t\n24\tOptional has_chroma suffix -- present only on decimated \"sample_frame\" rows,\n25\tdetected by the literal substring \" croot=\" (never inferred from onset/beat,\n26\tsince a row can be onset AND sample_frame simultaneously):\n27\t  croot=%d ctype=%d cconf=%.3f chroma=<v0>;...;<v11> mode=%u photons=%.3f\n28\t\n29\t  - croot: int, -1 (NONE sentinel) or 0..11 (A-origin pitch class).\n30\t  - ctype: int 0..4 enum (0=NONE,1=MAJOR,2=MINOR,3=DIMINISHED,4=AUGMENTED).\n31\t  - cconf: float, 3 decimals.\n32\t  - chroma: exactly 12 semicolon-separated floats (3 decimals each), A-origin.\n33\t  - mode: unsigned int (applied_mode).\n34\t  - photons: float, 3 decimals (pinned precision, not default printf).\n35\t\n36\tSemantic invariant: croot == -1 iff ctype == ChordType.NONE (0). A capture\n37\trow where these disagree is a data-integrity bug, not a parse error --\n38\tvalidate_chord_invariant() flags it without raising.\n39\t\n40\tSample-line count must equal K1EV_CAPTURE_DONE's count= field exactly.\n41\t`dropped` reports frames that hit ring capacity and were never appended, so\n42\tno adjustment against the emitted line count is needed.\n43\t\"\"\"\n44\tfrom __future__ import annotations\n45\t\n46\timport re\n47\tfrom dataclasses import dataclass, field\n48\tfrom typing import Optional\n49\t\n50\t\n51\tclass K1EVCaptureParseError(RuntimeError):\n52\t    \"\"\"Raised when a K1EV capture wrapper or sample line cannot be parsed.\"\"\"\n53\t\n54\t\n55\t# ---------------------------------------------------------------------------\n56\t# Data model\n57\t# ---------------------------------------------------------------------------\n58\t\n59\t\n60\tclass ChordType:\n61\t    \"\"\"ctype enum values, mirroring firmware ChordType.\"\"\"\n62\t\n63\t    NONE = 0\n64\t    MAJOR = 1\n65\t    MINOR = 2\n66\t    DIMINISHED = 3\n67\t    AUGMENTED = 4\n68\t\n69\t\n70\t@dataclass\n71\tclass K1EVSample:\n72\t    \"\"\"One parsed [K1EV] sample line.\"\"\"\n73\t\n74\t    t_ms: int\n75\t    event_ms: int\n76\t    ev: int\n77\t    onset: int\n78\t    bass: int\n79\t    kick: int\n80\t    snare: int\n81\t    hihat: int\n82\t    kid: int\n83\t    sid: int\n84\t    hid: int\n85\t    beat: int\n86\t    bphase: float\n87\t    bconf: float\n88\t    bpm: float\n89\t\n90\t    # has_chroma fields; None when the row has no \" croot=\" suffix.\n91\t    croot: Optional[int] = None\n92\t    ctype: Optional[int] = None\n93\t    cconf: Optional[float] = None\n94\t    chroma: Optional[list] = field(default=None)\n95\t    mode: Optional[int] = None\n96\t    photons: Optional[float] = None\n97\t\n98\t    @property\n99\t    def has_chroma(self) -> bool:\n100\t        return self.croot is not None\n101\t\n102\t\n103\t@dataclass\n104\tclass K1EVCaptureRun:\n105\t    \"\"\"A full parsed capture: wrapper metadata + all sample rows.\"\"\"\n106\t\n107\t    begin_count: int\n108\t    begin_capacity: int\n109\t    begin_dropped: int\n110\t    done_count: int\n111\t    done_dropped: int\n112\t    samples: list\n113\t\n114\t\n115\t# ---------------------------------------------------------------------------\n116\t# Wrapper-line parsing\n117\t# ---------------------------------------------------------------------------\n118\t\n119\t_BEGIN_RE = re.compile(\n120\t    r\"^K1EV_CAPTURE_BEGIN,count=(?P<count>\\d+),capacity=(?P<capacity>\\d+),\"\n121\t    r\"dropped=(?P<dropped>\\d+)\\s*$\"\n122\t)\n123\t_DONE_RE = re.compile(\n124\t    r\"^K1EV_CAPTURE_DONE,count=(?P<count>\\d+),dropped=(?P<dropped>\\d+)\\s*$\"\n125\t)\n126\t\n127\t\n128\tdef parse_begin_line(line: str) -> dict:\n129\t    \"\"\"Parse a K1EV_CAPTURE_BEGIN wrapper line into {count, capacity, dropped}.\"\"\"\n130\t    m = _BEGIN_RE.match(line.strip())\n131\t    if not m:\n132\t        raise K1EVCaptureParseError(f\"malformed K1EV_CAPTURE_BEGIN line: {line!r}\")\n133\t    return {\n134\t        \"count\": int(m.group(\"count\")),\n135\t        \"capacity\": int(m.group(\"capacity\")),\n136\t        \"dropped\": int(m.group(\"dropped\")),\n137\t    }\n138\t\n139\t\n140\tdef parse_done_line(line: str) -> dict:\n141\t    \"\"\"Parse a K1EV_CAPTURE_DONE wrapper line into {count, dropped}.\"\"\"\n142\t    m = _DONE_RE.match(line.strip())\n143\t    if not m:\n144\t        raise K1EVCaptureParseError(f\"malformed K1EV_CAPTURE_DONE line: {line!r}\")\n145\t    return {\n146\t        \"count\": int(m.group(\"count\")),\n147\t        \"dropped\": int(m.group(\"dropped\")),\n148\t    }\n149\t\n150\t\n151\t# ---------------------------------------------------------------------------\n152\t# Sample-line parsing\n153\t# ---------------------------------------------------------------------------\n154\t\n155\t_SAMPLE_PREFIX = \"[K1EV] \"\n156\t\n157\t_BASE_FIELD_ORDER = [\n158\t    \"t_ms\",\n159\t    \"event_ms\",\n160\t    \"ev\",\n161\t    \"onset\",\n162\t    \"bass\",\n163\t    \"kick\",\n164\t    \"snare\",\n165\t    \"hihat\",\n166\t    \"kid\",\n167\t    \"sid\",\n168\t    \"hid\",\n169\t    \"beat\",\n170\t    \"bphase\",\n171\t    \"bconf\",\n172\t    \"bpm\",\n173\t]\n174\t\n175\t_INT_FIELDS = {\n176\t    \"t_ms\",\n177\t    \"event_ms\",\n178\t    \"ev\",\n179\t    \"onset\",\n180\t    \"bass\",\n181\t    \"kick\",\n182\t    \"snare\",\n183\t    \"hihat\",\n184\t    \"kid\",\n185\t    \"sid\",\n186\t    \"hid\",\n187\t    \"beat\",\n188\t}\n189\t_FLOAT_FIELDS = {\"bphase\", \"bconf\", \"bpm\"}\n190\t\n191\t_CHROMA_FIELD_ORDER = [\"croot\", \"ctype\", \"cconf\", \"chroma\", \"mode\", \"photons\"]\n192\t_CHROMA_INT_FIELDS = {\"croot\", \"ctype\", \"mode\"}\n193\t_CHROMA_FLOAT_FIELDS = {\"cconf\", \"photons\"}\n194\t\n195\t\n196\tdef _tokenize_kv(text: str) -> dict:\n197\t    \"\"\"Split a space-separated `key=value` run into a dict, preserving order\n198\t    is not required since callers look fields up by name.\"\"\"\n199\t    out = {}\n200\t    for tok in text.split(\" \"):\n201\t        if not tok:\n202\t            continue\n203\t        if \"=\" not in tok:\n204\t            raise K1EVCaptureParseError(f\"malformed key=value token: {tok!r}\")\n205\t        k, v = tok.split(\"=\", 1)\n206\t        out[k] = v\n207\t    return out\n208\t\n209\t\n210\tdef parse_sample_line(line: str) -> K1EVSample:\n211\t    \"\"\"Parse one `[K1EV] ...` sample line into a K1EVSample.\n212\t\n213\t    Raises K1EVCaptureParseError on any malformed/truncated line (missing\n214\t    prefix, missing required field, non-numeric value, malformed chroma\n215\t    vector, etc.) -- never returns None or a partially-populated record.\n216\t    \"\"\"\n217\t    stripped = line.rstrip(\"\\r\\n\")\n218\t    if not stripped.startswith(_SAMPLE_PREFIX):\n219\t        raise K1EVCaptureParseError(f\"sample line missing '[K1EV] ' prefix: {line!r}\")\n220\t\n221\t    body = stripped[len(_SAMPLE_PREFIX):]\n222\t    has_chroma = \" croot=\" in (\" \" + body)\n223\t\n224\t    if has_chroma:\n225\t        # Split off the chroma suffix at the croot= boundary.\n226\t        idx = body.index(\"croot=\")\n227\t        base_part = body[:idx].strip()\n228\t        chroma_part = body[idx:].strip()\n229\t    else:\n230\t        base_part = body.strip()\n231\t        chroma_part = None\n232\t\n233\t    base_kv = _tokenize_kv(base_part)\n234\t    missing = [f for f in _BASE_FIELD_ORDER if f not in base_kv]\n235\t    if missing:\n236\t        raise K1EVCaptureParseError(\n237\t            f\"sample line missing required field(s) {missing}: {line!r}\"\n238\t        )\n239\t\n240\t    parsed = {}\n241\t    for f in _BASE_FIELD_ORDER:\n242\t        raw_val = base_kv[f]\n243\t        try:\n244\t            if f in _INT_FIELDS:\n245\t                parsed[f] = int(raw_val)\n246\t            else:\n247\t                parsed[f] = float(raw_val)\n248\t        except ValueError as exc:\n249\t            raise K1EVCaptureParseError(\n250\t                f\"field {f!r} not numeric ({raw_val!r}) in line: {line!r}\"\n251\t            ) from exc\n252\t\n253\t    chroma_kv = {}\n254\t    croot = ctype_ = cconf = chroma = mode = photons = None\n255\t    if chroma_part is not None:\n256\t        # chroma is itself a \"chroma=<v0>;...;<v11>\" token, incompatible with\n257\t        # naive whitespace tokenizing of the other key=value pairs since its\n258\t        # value has no spaces -- safe to tokenize the whole thing by space.\n259\t        chroma_tokens = chroma_part.split(\" \")\n260\t        for tok in chroma_tokens:\n261\t            if not tok:\n262\t                continue\n263\t            if \"=\" not in tok:\n264\t                raise K1EVCaptureParseError(f\"malformed chroma token: {tok!r}\")\n265\t            k, v = tok.split(\"=\", 1)\n266\t            chroma_kv[k] = v\n267\t\n268\t        missing_c = [f for f in _CHROMA_FIELD_ORDER if f not in chroma_kv]\n269\t        if missing_c:\n270\t            raise K1EVCaptureParseError(\n271\t                f\"has_chroma line missing field(s) {missing_c}: {line!r}\"\n272\t            )\n273\t\n274\t        try:\n275\t            croot = int(chroma_kv[\"croot\"])\n276\t            ctype_ = int(chroma_kv[\"ctype\"])\n277\t            mode = int(chroma_kv[\"mode\"])\n278\t            cconf = float(chroma_kv[\"cconf\"])\n279\t            photons = float(chroma_kv[\"photons\"])\n280\t        except ValueError as exc:\n281\t            raise K1EVCaptureParseError(\n282\t                f\"non-numeric chord/photons field in line: {line!r}\"\n283\t            ) from exc\n284\t\n285\t        chroma_raw = chroma_kv[\"chroma\"].split(\";\")\n286\t        if len(chroma_raw) != 12:\n287\t            raise K1EVCaptureParseError(\n288\t                f\"chroma vector must have exactly 12 values, got \"\n289\t                f\"{len(chroma_raw)}: {line!r}\"\n290\t            )\n291\t        try:\n292\t            chroma = [float(v) for v in chroma_raw]\n293\t        except ValueError as exc:\n294\t            raise K1EVCaptureParseError(\n295\t                f\"non-numeric chroma value in line: {line!r}\"\n296\t            ) from exc\n297\t\n298\t    return K1EVSample(\n299\t        t_ms=parsed[\"t_ms\"],\n300\t        event_ms=parsed[\"event_ms\"],\n301\t        ev=parsed[\"ev\"],\n302\t        onset=parsed[\"onset\"],\n303\t        bass=parsed[\"bass\"],\n304\t        kick=parsed[\"kick\"],\n305\t        snare=parsed[\"snare\"],\n306\t        hihat=parsed[\"hihat\"],\n307\t        kid=parsed[\"kid\"],\n308\t        sid=parsed[\"sid\"],\n309\t        hid=parsed[\"hid\"],\n310\t        beat=parsed[\"beat\"],\n311\t        bphase=parsed[\"bphase\"],\n312\t        bconf=parsed[\"bconf\"],\n313\t        bpm=parsed[\"bpm\"],\n314\t        croot=croot,\n315\t        ctype=ctype_,\n316\t        cconf=cconf,\n317\t        chroma=chroma,\n318\t        mode=mode,\n319\t        photons=photons,\n320\t    )\n321\t\n322\t\n323\t# ---------------------------------------------------------------------------\n324\t# Whole-capture parsing\n325\t# ---------------------------------------------------------------------------\n326\t\n327\t\n328\tdef parse_k1ev_capture(text: str) -> K1EVCaptureRun:\n329\t    \"\"\"Parse a full buffered K1EV capture (BEGIN wrapper, sample lines, DONE\n330\t    wrapper) into a K1EVCaptureRun.\n331\t\n332\t    Raises K1EVCaptureParseError if BEGIN/DONE wrappers are missing or\n333\t    malformed, or if any [K1EV] sample line is malformed.\n334\t    \"\"\"\n335\t    lines = text.splitlines()\n336\t\n337\t    begin_info = None\n338\t    done_info = None\n339\t    samples = []\n340\t\n341\t    for raw in lines:\n342\t        line = raw.strip()\n343\t        if not line:\n344\t            continue\n345\t        if line.startswith(\"K1EV_CAPTURE_BEGIN\"):\n346\t            begin_info = parse_begin_line(line)\n347\t        elif line.startswith(\"K1EV_CAPTURE_DONE\"):\n348\t            done_info = parse_done_line(line)\n349\t        elif line.startswith(_SAMPLE_PREFIX.strip()):\n350\t            samples.append(parse_sample_line(raw))\n351\t        # else: ignore unrelated lines (other harness output interleaved).\n352\t\n353\t    if begin_info is None:\n354\t        raise K1EVCaptureParseError(\"capture text missing K1EV_CAPTURE_BEGIN line\")\n355\t    if done_info is None:\n356\t        raise K1EVCaptureParseError(\"capture text missing K1EV_CAPTURE_DONE line\")\n357\t\n358\t    return K1EVCaptureRun(\n359\t        begin_count=begin_info[\"count\"],\n360\t        begin_capacity=begin_info[\"capacity\"],\n361\t        begin_dropped=begin_info[\"dropped\"],\n362\t        done_count=done_info[\"count\"],\n363\t        done_dropped=done_info[\"dropped\"],\n364\t        samples=samples,\n365\t    )\n366\t\n367\t\n368\t# ---------------------------------------------------------------------------\n369\t# Semantic validators\n370\t# ---------------------------------------------------------------------------\n371\t\n372\t\n373\tdef validate_chord_invariant(sample: K1EVSample) -> Optional[str]:\n374\t    \"\"\"Check the croot/ctype consistency invariant for a has_chroma sample.\n375\t\n376\t    croot == -1 iff ctype == ChordType.NONE. Returns None if consistent (or\n377\t    if the sample has no chroma data at all), otherwise a human-readable\n378\t    description of the violation. Does not raise -- callers decide whether\n379\t    to treat a violation as fatal.\n380\t    \"\"\"\n381\t    if not sample.has_chroma:\n382\t        return None\n383\t\n384\t    is_none_root = sample.croot == -1\n385\t    is_none_type = sample.ctype == ChordType.NONE\n386\t    if is_none_root != is_none_type:\n387\t        return (\n388\t            f\"croot/ctype invariant violated: croot={sample.croot} \"\n389\t            f\"ctype={sample.ctype} (expected croot==-1 iff ctype==NONE)\"\n390\t        )\n391\t    return None\n392\t\n393\t\n394\tdef validate_capture_run(run: K1EVCaptureRun) -> list:\n395\t    \"\"\"Validate an entire parsed capture run.\n396\t\n397\t    Returns a list of human-readable violation strings (empty if clean).\n398\t    Checks:\n399\t      - sample count equals K1EV_CAPTURE_DONE's count= field\n400\t      - croot/ctype invariant on every has_chroma sample\n401\t    \"\"\"\n402\t    violations = []\n403\t\n404\t    if len(run.samples) != run.done_count:\n405\t        violations.append(\n406\t            f\"sample count mismatch: parsed {len(run.samples)} sample lines, \"\n407\t            f\"DONE reported count={run.done_count}\"\n408\t        )\n409\t\n410\t    for i, sample in enumerate(run.samples):\n411\t        msg = validate_chord_invariant(sample)\n412\t        if msg:\n413\t            violations.append(f\"sample[{i}] (t_ms={sample.t_ms}): {msg}\")\n414\t\n415\t    return violations\n416\t"}]},"parent_tool_use_id":null,"session_id":"16a76e6c-f56d-436e-9309-aa9c7ce3989f","uuid":"1f03e293-6989-4f4d-a9f9-e3fc56e8daf8","timestamp":"2026-07-15T20:29:46.215Z","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/k1-ruflo-live/scripts/regression-harness/k1ev_capture_parse.py","content":"#!/usr/bin/env python3\n\"\"\"k1ev_capture_parse.py — host-side parser/validator for the buffered [K1EV]\nMode-A telemetry capture wire format.\n\nWire format (frozen, verified against k1ev_capture.cpp snprintf/println call\nsites, not just header comments):\n\nWrapper lines (USBSerial.println, generic line-split tolerant):\n  K1EV_CAPTURE_BEGIN,count=<u32>,capacity=<u32>,dropped=<u32>\n  K1EV_CAPTURE_DONE,count=<u32>,dropped=<u32>          (no capacity field)\n\nPer-sample base line, always prefixed \"[K1EV] \":\n  [K1EV] t_ms=%lu event_ms=%lu ev=%lu onset=%d bass=%d kick=%d snare=%d\n         hihat=%d kid=%lu sid=%lu hid=%lu beat=%d bphase=%.3f bconf=%.3f\n         bpm=%.1f\n\n  - t_ms/event_ms/ev/kid/sid/hid: unsigned (uint32 domain), parsed as int.\n  - onset/bass/kick/snare/hihat/beat: 0/1 flags. NOTE: `beat` here is the\n    tempo flywheel beat_tick, NOT ev.beat -- no parser-visible difference,\n    it's a firmware-source distinction only.\n  - bphase/bconf: floats, always printed with exactly 3 decimals (%.3f).\n  - bpm: float, always printed with exactly 1 decimal (%.1f).\n\nOptional has_chroma suffix -- present only on decimated \"sample_frame\" rows,\ndetected by the literal substring \" croot=\" (never inferred from onset/beat,\nsince a row can be onset AND sample_frame simultaneously):\n  croot=%d ctype=%d cconf=%.3f chroma=<v0>;...;<v11> mode=%u photons=%.3f\n\n  - croot: int, -1 (NONE sentinel) or 0..11 (A-origin pitch class).\n  - ctype: int 0..4 enum (0=NONE,1=MAJOR,2=MINOR,3=DIMINISHED,4=AUGMENTED).\n  - cconf: float, 3 decimals.\n  - chroma: exactly 12 semicolon-separated floats (3 decimals each), A-origin.\n  - mode: unsigned int (applied_mode).\n  - photons: float, 3 decimals (pinned precision, not default printf).\n\nSemantic invariant: croot == -1 iff ctype == ChordType.NONE (0). A capture\nrow where these disagree is a data-integrity bug, not a parse error --\nvalidate_chord_invariant() flags it without raising.\n\nSample-line count must equal K1EV_CAPTURE_DONE's count= field exactly.\n`dropped` reports frames that hit ring capacity and were never appended, so\nno adjustment against the emitted line count is needed.\n\"\"\"\nfrom __future__ import annotations\n\nimport re\nfrom dataclasses import dataclass, field\nfrom typing import Optional\n\n\nclass K1EVCaptureParseError(RuntimeError):\n    \"\"\"Raised when a K1EV capture wrapper or sample line cannot be parsed.\"\"\"\n\n\n# ---------------------------------------------------------------------------\n# Data model\n# ---------------------------------------------------------------------------\n\n\nclass ChordType:\n    \"\"\"ctype enum values, mirroring firmware ChordType.\"\"\"\n\n    NONE = 0\n    MAJOR = 1\n    MINOR = 2\n    DIMINISHED = 3\n    AUGMENTED = 4\n\n\n@dataclass\nclass K1EVSample:\n    \"\"\"One parsed [K1EV] sample line.\"\"\"\n\n    t_ms: int\n    event_ms: int\n    ev: int\n    onset: int\n    bass: int\n    kick: int\n    snare: int\n    hihat: int\n    kid: int\n    sid: int\n    hid: int\n    beat: int\n    bphase: float\n    bconf: float\n    bpm: float\n\n    # has_chroma fields; None when the row has no \" croot=\" suffix.\n    croot: Optional[int] = None\n    ctype: Optional[int] = None\n    cconf: Optional[float] = None\n    chroma: Optional[list] = field(default=None)\n    mode: Optional[int] = None\n    photons: Optional[float] = None\n\n    @property\n    def has_chroma(self) -> bool:\n        return self.croot is not None\n\n\n@dataclass\nclass K1EVCaptureRun:\n    \"\"\"A full parsed capture: wrapper metadata + all sample rows.\"\"\"\n\n    begin_count: int\n    begin_capacity: int\n    begin_dropped: int\n    done_count: int\n    done_dropped: int\n    samples: list\n\n\n# ---------------------------------------------------------------------------\n# Wrapper-line parsing\n# ---------------------------------------------------------------------------\n\n_BEGIN_RE = re.compile(\n    r\"^K1EV_CAPTURE_BEGIN,count=(?P<count>\\d+),capacity=(?P<capacity>\\d+),\"\n    r\"dropped=(?P<dropped>\\d+)\\s*$\"\n)\n_DONE_RE = re.compile(\n    r\"^K1EV_CAPTURE_DONE,count=(?P<count>\\d+),dropped=(?P<dropped>\\d+)\\s*$\"\n)\n\n\ndef parse_begin_line(line: str) -> dict:\n    \"\"\"Parse a K1EV_CAPTURE_BEGIN wrapper line into {count, capacity, dropped}.\"\"\"\n    m = _BEGIN_RE.match(line.strip())\n    if not m:\n        raise K1EVCaptureParseError(f\"malformed K1EV_CAPTURE_BEGIN line: {line!r}\")\n    return {\n        \"count\": int(m.group(\"count\")),\n        \"capacity\": int(m.group(\"capacity\")),\n        \"dropped\": int(m.group(\"dropped\")),\n    }\n\n\ndef parse_done_line(line: str) -> dict:\n    \"\"\"Parse a K1EV_CAPTURE_DONE wrapper line into {count, dropped}.\"\"\"\n    m = _DONE_RE.match(line.strip())\n    if not m:\n        raise K1EVCaptureParseError(f\"malformed K1EV_CAPTURE_DONE line: {line!r}\")\n    return {\n        \"count\": int(m.group(\"count\")),\n        \"dropped\": int(m.group(\"dropped\")),\n    }\n\n\n# ---------------------------------------------------------------------------\n# Sample-line parsing\n# ---------------------------------------------------------------------------\n\n_SAMPLE_PREFIX = \"[K1EV] \"\n\n_BASE_FIELD_ORDER = [\n    \"t_ms\",\n    \"event_ms\",\n    \"ev\",\n    \"onset\",\n    \"bass\",\n    \"kick\",\n    \"snare\",\n    \"hihat\",\n    \"kid\",\n    \"sid\",\n    \"hid\",\n    \"beat\",\n    \"bphase\",\n    \"bconf\",\n    \"bpm\",\n]\n\n_INT_FIELDS = {\n    \"t_ms\",\n    \"event_ms\",\n    \"ev\",\n    \"onset\",\n    \"bass\",\n    \"kick\",\n    \"snare\",\n    \"hihat\",\n    \"kid\",\n    \"sid\",\n    \"hid\",\n    \"beat\",\n}\n_FLOAT_FIELDS = {\"bphase\", \"bconf\", \"bpm\"}\n\n_CHROMA_FIELD_ORDER = [\"croot\", \"ctype\", \"cconf\", \"chroma\", \"mode\", \"photons\"]\n_CHROMA_INT_FIELDS = {\"croot\", \"ctype\", \"mode\"}\n_CHROMA_FLOAT_FIELDS = {\"cconf\", \"photons\"}\n\n\ndef _tokenize_kv(text: str) -> dict:\n    \"\"\"Split a space-separated `key=value` run into a dict, preserving order\n    is not required since callers look fields up by name.\"\"\"\n    out = {}\n    for tok in text.split(\" \"):\n        if not tok:\n            continue\n        if \"=\" not in tok:\n            raise K1EVCaptureParseError(f\"malformed key=value token: {tok!r}\")\n        k, v = tok.split(\"=\", 1)\n        out[k] = v\n    return out\n\n\ndef parse_sample_line(line: str) -> K1EVSample:\n    \"\"\"Parse one `[K1EV] ...` sample line into a K1EVSample.\n\n    Raises K1EVCaptureParseError on any malformed/truncated line (missing\n    prefix, missing required field, non-numeric value, malformed chroma\n    vector, etc.) -- never returns None or a partially-populated record.\n    \"\"\"\n    stripped = line.rstrip(\"\\r\\n\")\n    if not stripped.startswith(_SAMPLE_PREFIX):\n        raise K1EVCaptureParseError(f\"sample line missing '[K1EV] ' prefix: {line!r}\")\n\n    body = stripped[len(_SAMPLE_PREFIX):]\n    has_chroma = \" croot=\" in (\" \" + body)\n\n    if has_chroma:\n        # Split off the chroma suffix at the croot= boundary.\n        idx = body.index(\"croot=\")\n        base_part = body[:idx].strip()\n        chroma_part = body[idx:].strip()\n    else:\n        base_part = body.strip()\n        chroma_part = None\n\n    base_kv = _tokenize_kv(base_part)\n    missing = [f for f in _BASE_FIELD_ORDER if f not in base_kv]\n    if missing:\n        raise K1EVCaptureParseError(\n            f\"sample line missing required field(s) {missing}: {line!r}\"\n        )\n\n    parsed = {}\n    for f in _BASE_FIELD_ORDER:\n        raw_val = base_kv[f]\n        try:\n            if f in _INT_FIELDS:\n                parsed[f] = int(raw_val)\n            else:\n                parsed[f] = float(raw_val)\n        except ValueError as exc:\n            raise K1EVCaptureParseError(\n                f\"field {f!r} not numeric ({raw_val!r}) in line: {line!r}\"\n            ) from exc\n\n    chroma_kv = {}\n    croot = ctype_ = cconf = chroma = mode = photons = None\n    if chroma_part is not None:\n        # chroma is itself a \"chroma=<v0>;...;<v11>\" token, incompatible with\n        # naive whitespace tokenizing of the other key=value pairs since its\n        # value has no spaces -- safe to tokenize the whole thing by space.\n        chroma_tokens = chroma_part.split(\" \")\n        for tok in chroma_tokens:\n            if not tok:\n                continue\n            if \"=\" not in tok:\n                raise K1EVCaptureParseError(f\"malformed chroma token: {tok!r}\")\n            k, v = tok.split(\"=\", 1)\n            chroma_kv[k] = v\n\n        missing_c = [f for f in _CHROMA_FIELD_ORDER if f not in chroma_kv]\n        if missing_c:\n            raise K1EVCaptureParseError(\n                f\"has_chroma line missing field(s) {missing_c}: {line!r}\"\n            )\n\n        try:\n            croot = int(chroma_kv[\"croot\"])\n            ctype_ = int(chroma_kv[\"ctype\"])\n            mode = int(chroma_kv[\"mode\"])\n            cconf = float(chroma_kv[\"cconf\"])\n            photons = float(chroma_kv[\"photons\"])\n        except ValueError as exc:\n            raise K1EVCaptureParseError(\n                f\"non-numeric chord/photons field in line: {line!r}\"\n            ) from exc\n\n        chroma_raw = chroma_kv[\"chroma\"].split(\";\")\n        if len(chroma_raw) != 12:\n            raise K1EVCaptureParseError(\n                f\"chroma vector must have exactly 12 values, got \"\n                f\"{len(chroma_raw)}: {line!r}\"\n            )\n        try:\n            chroma = [float(v) for v in chroma_raw]\n        except ValueError as exc:\n            raise K1EVCaptureParseError(\n                f\"non-numeric chroma value in line: {line!r}\"\n            ) from exc\n\n    return K1EVSample(\n        t_ms=parsed[\"t_ms\"],\n        event_ms=parsed[\"event_ms\"],\n        ev=parsed[\"ev\"],\n        onset=parsed[\"onset\"],\n        bass=parsed[\"bass\"],\n        kick=parsed[\"kick\"],\n        snare=parsed[\"snare\"],\n        hihat=parsed[\"hihat\"],\n        kid=parsed[\"kid\"],\n        sid=parsed[\"sid\"],\n        hid=parsed[\"hid\"],\n        beat=parsed[\"beat\"],\n        bphase=parsed[\"bphase\"],\n        bconf=parsed[\"bconf\"],\n        bpm=parsed[\"bpm\"],\n        croot=croot,\n        ctype=ctype_,\n        cconf=cconf,\n        chroma=chroma,\n        mode=mode,\n        photons=photons,\n    )\n\n\n# ---------------------------------------------------------------------------\n# Whole-capture parsing\n# ---------------------------------------------------------------------------\n\n\ndef parse_k1ev_capture(text: str) -> K1EVCaptureRun:\n    \"\"\"Parse a full buffered K1EV capture (BEGIN wrapper, sample lines, DONE\n    wrapper) into a K1EVCaptureRun.\n\n    Raises K1EVCaptureParseError if BEGIN/DONE wrappers are missing or\n    malformed, or if any [K1EV] sample line is malformed.\n    \"\"\"\n    lines = text.splitlines()\n\n    begin_info = None\n    done_info = None\n    samples = []\n\n    for raw in lines:\n        line = raw.strip()\n        if not line:\n            continue\n        if line.startswith(\"K1EV_CAPTURE_BEGIN\"):\n            begin_info = parse_begin_line(line)\n        elif line.startswith(\"K1EV_CAPTURE_DONE\"):\n            done_info = parse_done_line(line)\n        elif line.startswith(_SAMPLE_PREFIX.strip()):\n            samples.append(parse_sample_line(raw))\n        # else: ignore unrelated lines (other harness output interleaved).\n\n    if begin_info is None:\n        raise K1EVCaptureParseError(\"capture text missing K1EV_CAPTURE_BEGIN line\")\n    if done_info is None:\n        raise K1EVCaptureParseError(\"capture text missing K1EV_CAPTURE_DONE line\")\n\n    return K1EVCaptureRun(\n        begin_count=begin_info[\"count\"],\n        begin_capacity=begin_info[\"capacity\"],\n        begin_dropped=begin_info[\"dropped\"],\n        done_count=done_info[\"count\"],\n        done_dropped=done_info[\"dropped\"],\n        samples=samples,\n    )\n\n\n# ---------------------------------------------------------------------------\n# Semantic validators\n# ---------------------------------------------------------------------------\n\n\ndef validate_chord_invariant(sample: K1EVSample) -> Optional[str]:\n    \"\"\"Check the croot/ctype consistency invariant for a has_chroma sample.\n\n    croot == -1 iff ctype == ChordType.NONE. Returns None if consistent (or\n    if the sample has no chroma data at all), otherwise a human-readable\n    description of the violation. Does not raise -- callers decide whether\n    to treat a violation as fatal.\n    \"\"\"\n    if not sample.has_chroma:\n        return None\n\n    is_none_root = sample.croot == -1\n    is_none_type = sample.ctype == ChordType.NONE\n    if is_none_root != is_none_type:\n        return (\n            f\"croot/ctype invariant violated: croot={sample.croot} \"\n            f\"ctype={sample.ctype} (expected croot==-1 iff ctype==NONE)\"\n        )\n    return None\n\n\ndef validate_capture_run(run: K1EVCaptureRun) -> list:\n    \"\"\"Validate an entire parsed capture run.\n\n    Returns a list of human-readable violation strings (empty if clean).\n    Checks:\n      - sample count equals K1EV_CAPTURE_DONE's count= field\n      - croot/ctype invariant on every has_chroma sample\n    \"\"\"\n    violations = []\n\n    if len(run.samples) != run.done_count:\n        violations.append(\n            f\"sample count mismatch: parsed {len(run.samples)} sample lines, \"\n            f\"DONE reported count={run.done_count}\"\n        )\n\n    for i, sample in enumerate(run.samples):\n        msg = validate_chord_invariant(sample)\n        if msg:\n            violations.append(f\"sample[{i}] (t_ms={sample.t_ms}): {msg}\")\n\n    return violations\n","numLines":416,"startLine":1,"totalLines":416}}}
