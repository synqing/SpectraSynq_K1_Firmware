{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cd4UTvmM1g4bYiZEvzWHJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XYnxZwPjwpWpfpM9gEo2i9","name":"Write","input":{"file_path":"/private/tmp/k1-ruflo-live/tests/test_k1ev_capture_replay.py","content":"\"\"\"test_k1ev_capture_replay.py — regression tests for the host-side [K1EV]\nbuffered telemetry capture parser (scripts/regression-harness/k1ev_capture_parse.py).\n\nSynthetic fixture strings only -- no real device or capture file required.\n\"\"\"\nfrom __future__ import annotations\n\nimport importlib.util\nimport sys\nfrom pathlib import Path\n\nimport pytest\n\nROOT = Path(__file__).resolve().parents[1]\nMODULE_PATH = ROOT / \"scripts\" / \"regression-harness\" / \"k1ev_capture_parse.py\"\n\nspec = importlib.util.spec_from_file_location(\"k1ev_capture_parse\", MODULE_PATH)\nassert spec is not None\nk1ev_capture_parse = importlib.util.module_from_spec(spec)\nassert spec.loader is not None\nsys.modules[spec.name] = k1ev_capture_parse\nspec.loader.exec_module(k1ev_capture_parse)\n\nK1EVCaptureParseError = k1ev_capture_parse.K1EVCaptureParseError\nChordType = k1ev_capture_parse.ChordType\n\n# Firmware pins K1EV_CAPTURE_CAPACITY=65536 (4 MiB ring). Not hardcoded as a\n# parser requirement -- just pinned in this fixture as a round-trip sanity\n# check on the golden capture.\nK1EV_CAPTURE_CAPACITY = 65536\n\n\ndef _base_only_line(\n    t_ms=1000,\n    event_ms=990,\n    ev=1,\n    onset=0,\n    bass=0,\n    kick=0,\n    snare=0,\n    hihat=0,\n    kid=0,\n    sid=0,\n    hid=0,\n    beat=0,\n    bphase=0.123,\n    bconf=0.456,\n    bpm=120.0,\n):\n    return (\n        f\"[K1EV] t_ms={t_ms} event_ms={event_ms} ev={ev} onset={onset} \"\n        f\"bass={bass} kick={kick} snare={snare} hihat={hihat} kid={kid} \"\n        f\"sid={sid} hid={hid} beat={beat} bphase={bphase:.3f} \"\n        f\"bconf={bconf:.3f} bpm={bpm:.1f}\"\n    )\n\n\ndef _chroma_suffix(\n    croot=0,\n    ctype=ChordType.MAJOR,\n    cconf=0.789,\n    chroma=None,\n    mode=3,\n    photons=0.512,\n):\n    if chroma is None:\n        chroma = [0.1 * i for i in range(12)]\n    assert len(chroma) == 12\n    chroma_str = \";\".join(f\"{v:.3f}\" for v in chroma)\n    return (\n        f\"croot={croot} ctype={ctype} cconf={cconf:.3f} \"\n        f\"chroma={chroma_str} mode={mode} photons={photons:.3f}\"\n    )\n\n\ndef _chroma_line(**base_kwargs):\n    base = _base_only_line(**base_kwargs)\n    return base + \" \" + _chroma_suffix()\n\n\n# ---------------------------------------------------------------------------\n# 1. Wrapper line parsing\n# ---------------------------------------------------------------------------\n\n\ndef test_parse_begin_line_extracts_count_capacity_dropped():\n    \"\"\"K1EV_CAPTURE_BEGIN wrapper fields are extracted correctly, and the\n    firmware-pinned capacity (65536 / 4 MiB ring) round-trips through the\n    parser unmodified.\"\"\"\n    line = f\"K1EV_CAPTURE_BEGIN,count=42,capacity={K1EV_CAPTURE_CAPACITY},dropped=3\"\n    info = k1ev_capture_parse.parse_begin_line(line)\n    assert info == {\"count\": 42, \"capacity\": K1EV_CAPTURE_CAPACITY, \"dropped\": 3}\n    assert info[\"capacity\"] == 65536\n\n\ndef test_parse_done_line_extracts_count_and_dropped_no_capacity():\n    \"\"\"K1EV_CAPTURE_DONE has no capacity field; only count and dropped.\"\"\"\n    line = \"K1EV_CAPTURE_DONE,count=42,dropped=3\"\n    info = k1ev_capture_parse.parse_done_line(line)\n    assert info == {\"count\": 42, \"dropped\": 3}\n    assert \"capacity\" not in info\n\n\n# ---------------------------------------------------------------------------\n# 2. Base-only sample line parsing\n# ---------------------------------------------------------------------------\n\n\ndef test_parse_base_only_sample_line_extracts_fields_and_types():\n    \"\"\"A base-only line (no ' croot=' substring) yields correct field\n    extraction and int/float type coercion, with no chroma/chord/mode/photons\n    populated.\"\"\"\n    line = _base_only_line(\n        t_ms=5000,\n        event_ms=4990,\n        ev=7,\n        onset=1,\n        bass=0,\n        kick=1,\n        snare=0,\n        hihat=0,\n        kid=2,\n        sid=0,\n        hid=0,\n        beat=1,\n        bphase=0.250,\n        bconf=0.900,\n        bpm=128.4,\n    )\n    sample = k1ev_capture_parse.parse_sample_line(line)\n\n    assert sample.t_ms == 5000\n    assert isinstance(sample.t_ms, int)\n    assert sample.event_ms == 4990\n    assert sample.ev == 7\n    assert sample.onset == 1\n    assert isinstance(sample.onset, int)\n    assert sample.bass == 0\n    assert sample.kick == 1\n    assert sample.snare == 0\n    assert sample.hihat == 0\n    assert sample.kid == 2\n    assert sample.sid == 0\n    assert sample.hid == 0\n    assert sample.beat == 1\n    assert sample.bphase == pytest.approx(0.250)\n    assert isinstance(sample.bphase, float)\n    assert sample.bconf == pytest.approx(0.900)\n    assert sample.bpm == pytest.approx(128.4)\n    assert isinstance(sample.bpm, float)\n\n    assert sample.has_chroma is False\n    assert sample.croot is None\n    assert sample.ctype is None\n    assert sample.cconf is None\n    assert sample.chroma is None\n    assert sample.mode is None\n    assert sample.photons is None\n\n\n# ---------------------------------------------------------------------------\n# 3. has_chroma sample line parsing\n# ---------------------------------------------------------------------------\n\n\ndef test_parse_has_chroma_sample_line_extracts_chord_and_photon_fields():\n    \"\"\"A sample_frame row with the chroma suffix yields correct croot, ctype,\n    cconf, all 12 chroma floats in order, mode, and photons.\"\"\"\n    chroma_values = [round(0.05 * i, 3) for i in range(12)]\n    line = _base_only_line() + \" \" + _chroma_suffix(\n        croot=5,\n        ctype=ChordType.MINOR,\n        cconf=0.333,\n        chroma=chroma_values,\n        mode=9,\n        photons=0.876,\n    )\n    sample = k1ev_capture_parse.parse_sample_line(line)\n\n    assert sample.has_chroma is True\n    assert sample.croot == 5\n    assert sample.ctype == ChordType.MINOR\n    assert sample.cconf == pytest.approx(0.333)\n    assert sample.chroma == pytest.approx(chroma_values)\n    assert len(sample.chroma) == 12\n    assert sample.mode == 9\n    assert sample.photons == pytest.approx(0.876)\n\n\ndef test_has_chroma_detected_even_when_row_is_also_onset():\n    \"\"\"A row can be both onset AND sample_frame; has_chroma must be detected\n    by the literal ' croot=' substring, not inferred from onset/beat flags.\"\"\"\n    line = _base_only_line(onset=1, beat=1) + \" \" + _chroma_suffix()\n    sample = k1ev_capture_parse.parse_sample_line(line)\n    assert sample.onset == 1\n    assert sample.beat == 1\n    assert sample.has_chroma is True\n\n\n# ---------------------------------------------------------------------------\n# 4. croot == -1 <=> ctype == NONE semantic invariant\n# ---------------------------------------------------------------------------\n\n\ndef test_chord_invariant_consistent_case_passes():\n    \"\"\"croot=-1 with ctype=NONE (0) is a consistent, valid row.\"\"\"\n    line = _base_only_line() + \" \" + _chroma_suffix(croot=-1, ctype=ChordType.NONE)\n    sample = k1ev_capture_parse.parse_sample_line(line)\n    assert k1ev_capture_parse.validate_chord_invariant(sample) is None\n\n\ndef test_chord_invariant_violation_is_flagged():\n    \"\"\"croot=-1 paired with a non-NONE ctype (or vice versa) is a data\n    integrity bug and must be flagged by the validator.\"\"\"\n    line = _base_only_line() + \" \" + _chroma_suffix(croot=-1, ctype=ChordType.MAJOR)\n    sample = k1ev_capture_parse.parse_sample_line(line)\n    violation = k1ev_capture_parse.validate_chord_invariant(sample)\n    assert violation is not None\n    assert \"invariant violated\" in violation\n\n    # Also check the inverse mismatch: a real root paired with NONE ctype.\n    line2 = _base_only_line() + \" \" + _chroma_suffix(croot=3, ctype=ChordType.NONE)\n    sample2 = k1ev_capture_parse.parse_sample_line(line2)\n    violation2 = k1ev_capture_parse.validate_chord_invariant(sample2)\n    assert violation2 is not None\n\n\ndef test_base_only_sample_has_no_invariant_violation():\n    \"\"\"A sample with no chroma data is not subject to the invariant check.\"\"\"\n    sample = k1ev_capture_parse.parse_sample_line(_base_only_line())\n    assert k1ev_capture_parse.validate_chord_invariant(sample) is None\n\n\n# ---------------------------------------------------------------------------\n# 5. Malformed / truncated line handling\n# ---------------------------------------------------------------------------\n\n\ndef test_truncated_sample_line_raises_parse_error():\n    \"\"\"A truncated [K1EV] line (missing trailing fields) raises\n    K1EVCaptureParseError rather than silently returning garbage or None.\"\"\"\n    truncated = \"[K1EV] t_ms=100 event_ms=90 ev=1 onset=0 bass=0 kick=0\"\n    with pytest.raises(K1EVCaptureParseError):\n        k1ev_capture_parse.parse_sample_line(truncated)\n\n\ndef test_missing_prefix_raises_parse_error():\n    \"\"\"A line missing the '[K1EV] ' prefix entirely raises rather than being\n    silently accepted.\"\"\"\n    with pytest.raises(K1EVCaptureParseError):\n        k1ev_capture_parse.parse_sample_line(\"t_ms=100 event_ms=90 ev=1\")\n\n\ndef test_malformed_chroma_vector_raises_parse_error():\n    \"\"\"A chroma vector with fewer than 12 semicolon-separated values raises.\"\"\"\n    bad_line = _base_only_line() + \" croot=0 ctype=1 cconf=0.500 chroma=0.1;0.2 mode=1 photons=0.100\"\n    with pytest.raises(K1EVCaptureParseError):\n        k1ev_capture_parse.parse_sample_line(bad_line)\n\n\ndef test_malformed_begin_wrapper_raises_parse_error():\n    \"\"\"A corrupted BEGIN wrapper line raises K1EVCaptureParseError.\"\"\"\n    with pytest.raises(K1EVCaptureParseError):\n        k1ev_capture_parse.parse_begin_line(\"K1EV_CAPTURE_BEGIN,count=abc,capacity=65536\")\n\n\ndef test_capture_missing_done_wrapper_raises_parse_error():\n    \"\"\"A capture text with a BEGIN wrapper and sample lines but no DONE\n    wrapper raises rather than silently returning a partial run.\"\"\"\n    text = \"\\n\".join(\n        [\n            \"K1EV_CAPTURE_BEGIN,count=1,capacity=65536,dropped=0\",\n            _base_only_line(),\n        ]\n    )\n    with pytest.raises(K1EVCaptureParseError):\n        k1ev_capture_parse.parse_k1ev_capture(text)\n\n\n# ---------------------------------------------------------------------------\n# 6. Exact count equality\n# ---------------------------------------------------------------------------\n\n\ndef test_parsed_sample_count_equals_done_count_field():\n    \"\"\"Number of successfully parsed [K1EV] sample lines equals the DONE\n    line's count= field for a well-formed synthetic capture.\"\"\"\n    n = 10\n    lines = [\"K1EV_CAPTURE_BEGIN,count=%d,capacity=65536,dropped=2\" % n]\n    for i in range(n):\n        lines.append(_base_only_line(t_ms=1000 + i * 10, ev=i))\n    lines.append(\"K1EV_CAPTURE_DONE,count=%d,dropped=2\" % n)\n    text = \"\\n\".join(lines)\n\n    run = k1ev_capture_parse.parse_k1ev_capture(text)\n\n    assert len(run.samples) == n\n    assert run.done_count == n\n    assert len(run.samples) == run.done_count\n    assert run.begin_capacity == 65536\n    assert run.begin_dropped == 2\n    assert run.done_dropped == 2\n\n    violations = k1ev_capture_parse.validate_capture_run(run)\n    assert violations == []\n\n\ndef test_validate_capture_run_flags_count_mismatch():\n    \"\"\"If the DONE count= field disagrees with the actual number of parsed\n    sample lines, validate_capture_run must flag it.\"\"\"\n    lines = [\n        \"K1EV_CAPTURE_BEGIN,count=5,capacity=65536,dropped=0\",\n        _base_only_line(),\n        _base_only_line(t_ms=1010),\n        # DONE claims 5 but only 2 sample lines are present.\n        \"K1EV_CAPTURE_DONE,count=5,dropped=0\",\n    ]\n    run = k1ev_capture_parse.parse_k1ev_capture(\"\\n\".join(lines))\n    violations = k1ev_capture_parse.validate_capture_run(run)\n    assert any(\"sample count mismatch\" in v for v in violations)\n\n\n# ---------------------------------------------------------------------------\n# 7. Precision / flag edge cases + realistic mixed fixture\n# ---------------------------------------------------------------------------\n\n\n@pytest.mark.parametrize(\n    \"bpm_value\",\n    [120.0, 0.0, 999.9, 60.1],\n)\ndef test_bpm_always_one_decimal_parses_cleanly(bpm_value):\n    \"\"\"bpm is always printed with exactly 1 decimal digit; parser must not\n    choke on boundary-looking values like 120.0 or 0.0.\"\"\"\n    line = _base_only_line(bpm=bpm_value)\n    sample = k1ev_capture_parse.parse_sample_line(line)\n    assert sample.bpm == pytest.approx(bpm_value)\n\n\n@pytest.mark.parametrize(\n    \"field_value\",\n    [0.000, 1.000, -0.001, 0.999],\n)\ndef test_bconf_bphase_three_decimal_edge_values_parse_cleanly(field_value):\n    \"\"\"bphase/bconf/cconf/chroma are always printed with exactly 3 decimals;\n    parser must handle zero, near-boundary, and negative-looking values.\"\"\"\n    line = _base_only_line(bphase=field_value, bconf=field_value)\n    sample = k1ev_capture_parse.parse_sample_line(line)\n    assert sample.bphase == pytest.approx(field_value)\n    assert sample.bconf == pytest.approx(field_value)\n\n\n@pytest.mark.parametrize(\"flag_field\", [\"onset\", \"bass\", \"kick\", \"snare\", \"hihat\", \"beat\"])\ndef test_flags_are_int_zero_or_one(flag_field):\n    \"\"\"onset/bass/kick/snare/hihat/beat are parsed as 0/1 ints.\"\"\"\n    for val in (0, 1):\n        kwargs = {flag_field: val}\n        line = _base_only_line(**kwargs)\n        sample = k1ev_capture_parse.parse_sample_line(line)\n        parsed_val = getattr(sample, flag_field)\n        assert parsed_val == val\n        assert isinstance(parsed_val, int)\n\n\ndef test_mixed_capture_with_interleaved_base_and_chroma_rows():\n    \"\"\"Realistic mixed fixture mirroring real decimation cadence: has_chroma\n    on every 3rd sample_frame row OR any explicit onset row, base-only\n    otherwise. Full capture must parse and validate cleanly.\"\"\"\n    lines = [\"K1EV_CAPTURE_BEGIN,count=9,capacity=65536,dropped=0\"]\n    expected_chroma_flags = []\n    for i in range(9):\n        is_decimated_third = (i % 3) == 0\n        is_onset = i in (4, 7)\n        if is_decimated_third or is_onset:\n            lines.append(\n                _base_only_line(t_ms=1000 + i * 10, ev=i, onset=1 if is_onset else 0)\n                + \" \"\n                + _chroma_suffix(croot=(i % 12), ctype=ChordType.MAJOR, mode=1)\n            )\n            expected_chroma_flags.append(True)\n        else:\n            lines.append(_base_only_line(t_ms=1000 + i * 10, ev=i))\n            expected_chroma_flags.append(False)\n    lines.append(\"K1EV_CAPTURE_DONE,count=9,dropped=0\")\n\n    run = k1ev_capture_parse.parse_k1ev_capture(\"\\n\".join(lines))\n\n    assert len(run.samples) == 9\n    assert len(run.samples) == run.done_count\n    for sample, expected_flag in zip(run.samples, expected_chroma_flags):\n        assert sample.has_chroma is expected_flag\n\n    violations = k1ev_capture_parse.validate_capture_run(run)\n    assert violations == []\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5786,"cache_read_input_tokens":123606,"cache_creation":{"ephemeral_5m_input_tokens":5786,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":"toolu_013N9Y1C3fbUG1Hgeccu4BBw","session_id":"16a76e6c-f56d-436e-9309-aa9c7ce3989f","uuid":"0a5818b3-3d7b-491c-8efa-725a1554c383","request_id":"req_011Cd4UTuTDKo8fviGT4YLCW","subagent_type":"general-purpose","task_des