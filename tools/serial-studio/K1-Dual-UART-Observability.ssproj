                    "plotMax": 0,
                    "plotMin": 0,
                    "title": "transport_residual_ms",
                    "transformCode": "var t0Host;\nvar t0Dev;\nvar baseline;\nfunction transform(value, info) {\n  if (value === undefined || value === null || !isFinite(value))\n    return 0;\n  if (info === undefined || info.timestampMs === undefined)\n    return 0;\n  if (t0Host === undefined) {\n    t0Host = info.timestampMs;\n    t0Dev = value;\n    baseline = 0;\n    return 0;\n  }\n  var skew = (info.timestampMs - t0Host) - (value - t0Dev);\n  if (baseline === undefined || baseline === 0)\n    baseline = skew;\n  return skew - baseline;\n}\n",
                    "transformLanguage": 0,
