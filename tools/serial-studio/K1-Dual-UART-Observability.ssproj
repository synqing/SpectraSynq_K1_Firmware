                    "title": "frame_dt_ms",
                    "transformCode": "var prev = NaN;\nfunction transform(value) {\n  var dt = (isFinite(prev) && isFinite(value)) ? (value - prev) : 0;\n  prev = value;\n  if (dt < 0)\n    dt = 0;\n  return dt;\n}\n",
                    "transformLanguage": 0,
