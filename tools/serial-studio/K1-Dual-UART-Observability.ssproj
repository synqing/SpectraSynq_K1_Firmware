    "changeDrivenTransforms": false,
    "controlScriptCode": "/**\n * Cadence-facing shuttle. One slot: k1_gate.tx \u2192 named source \u2192 last_reply.\n *\n * Control scripts do not have deviceWrite() (__ss_dw). Use deviceWriteAndWait\n * on ControlApiBridge. Never io.getLatestFrame for a command reply.\n *\n * Firmware :chip_id (serial_menu.cpp cmd_chip_id / utilities.h print_chip_id):\n *   tx_begin()      \u2192 \"sbr{{\\n\"\n *   print_chip_id() \u2192 8 uppercase hex + \"\\n\"   (Main RPL: 9087A500)\n *   tx_end()        \u2192 \"}}\\n\"\n * There is no \"CHIP\" token on the wire. Do not wait for \"\\n\" or omit `until`:\n * Main RPL streams [AP] and either would complete on telemetry.\n */\nfunction setup() {}\n\nfunction loop() {\n  var tx = tableGet(\"k1_gate\", \"tx\");\n  if (tx) {\n    var sid = Number(tableGet(\"k1_gate\", \"source\"));\n    if (!isFinite(sid))\n      sid = 1;\n    var cmd = String(tx);\n    if (cmd.indexOf(\":chip_id\") !== 0) {\n      tableSet(\"k1_gate\", \"tx\", \"\");\n      tableSet(\"k1_gate\", \"last_reply\", \"\");\n      tableSet(\"k1_gate\", \"last_error\", \"SHUTTLE_UNPROVEN command\");\n    } else {\n      var until = \"9087A500\";\n      var r = deviceWriteAndWait(cmd, 1500, until, sid);\n      var data = (r && r.data) ? String(r.data) : \"\";\n      var bytes = (r && typeof r.bytesRead === \"number\") ? r.bytesRead : 0;\n      tableSet(\"k1_gate\", \"tx\", \"\");\n      tableSet(\"k1_gate\", \"last_reply\", data);\n      if (!r)\n        tableSet(\"k1_gate\", \"last_error\", \"no return bytesRead=0\");\n      else if (r.timedOut)\n        tableSet(\"k1_gate\", \"last_error\", \"timeout bytesRead=\" + bytes);\n      else if (!r.ok)\n        tableSet(\"k1_gate\", \"last_error\", String(r.error || \"write failed\") + \" bytesRead=\" + bytes);\n      else\n        tableSet(\"k1_gate\", \"last_error\", \"ok bytesRead=\" + bytes);\n    }\n  }\n  delay(50);\n}\n",
    "customizeWorkspaces": true,
