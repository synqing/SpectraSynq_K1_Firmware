// ============================================================================
// light_mode_waveform_tempo.cpp — Beat/Tempo-Phase-Locked Motion (reference impl)
// ----------------------------------------------------------------------------
// RENAMED from motion-tempo-scroll.cpp: the hyphenated name matched NEITHER
// build_src_filter pattern (+<light_mode_*.cpp> +<sb_*.cpp>) and would have been
// silently not built. This name matches +<light_mode_*.cpp> and the convention
// the New-Light-Mode gate requires. DELETE motion-tempo-scroll.cpp.
//
// THIS IS A PRODUCTION VISUAL-PIPELINE CHANGE, not "wire & install". It is a new
// shipping mode (whitelisted, Smart-Auto-selectable) → the full New-Light-Mode
// change-gate applies: append-only enum, VP-probe determinism, primary/secondary
// bleed test, secondary-enabled perf check. See AGENT-HANDOFF-tempo-phase-lock.md
// and invoke /sensorybridge-doctrine before this touches k1_hardware.
//
// THE DESIGN LAW [MEASURED] (docs/measurements/apparent-motion-on-k1.md):
//   Lock modulates CONTINUOUS per-frame scroll VELOCITY, stepping every frame.
//   NEVER per-beat position jumps (a 500 ms jump @120 BPM is ~10× past the
//   40–60 ms fusion floor → teleport). The eye reads the lock from the per-beat
//   velocity SURGE, not from scroll speed.
//
// FACTS from source [FACT]:
//   - SBTempoEvent (sb_tempo.h): bpm; phase01∈[0,1), 0==beat; confidence∈[0,1]
//     (already silence-scaled); locked = conf>0.30 && !silence; beat_tick;
//     beat_strength.  Lock range 60–156 BPM (out-of-range aliases half/double — ok).
//   - phase01 publishes at 50 Hz; read per render frame → quantises VELOCITY (fine;
//     does NOT touch the POSITION fusion floor).
//   - [FACT] sb_tempo is UNWIRED: the only callers of sb_tempo_update/read in the
//     tree are in this file. Until sb_tempo_update(sb_audio_snapshot_read()) is
//     called in the Core-0 audio loop, this mode reads a never-updated event →
//     confidence≈0 → idle scroll → nothing tempo-locked. WIRING IT IS THE ACTUAL
//     WORK AND THE ACTUAL RISK (AP-class, cross-core). Do that first (handoff Step 0).
//
// BINDINGS TO ADD (headers not in the review set — field additions, not decisions):
//   channel_effect_state.h → ChannelEffectState: float tempo_scroll_accum=0.0f;
//                                                  uint32_t tempo_last_ms=0;
//   render_params.h        → RenderParams (+ SECONDARY_* mirrors if needed):
//                              float TEMPO_PX_PER_BEAT=24.0f;  // px travelled per beat
//                              float TEMPO_DEPTH=0.5f;         // surge 0..1 — feel knob
//                              float TEMPO_IDLE_RATE=30.0f;    // px/s fallback when unlocked
//   config_types.h enum    → APPEND-ONLY at the end: LIGHT_MODE_WAVEFORM_TEMPO
//                              (never reorder; let NUM_MODES increment — IDs are referenced).
//   dispatch + whitelist   → route to light_mode_waveform_tempo(fx); add to the mode whitelist.
//   lightshow_modes.h      → declare tempo_scroll_step() + light_mode_waveform_tempo().
// ============================================================================

#include "lightshow_modes.h"
#include "sb_tempo.h"
#include "sb_audio_snapshot.h"
#include <math.h>

static const float SB_TWO_PI_F   = 6.28318530718f;
static const float TEMPO_CONF_LO = 0.30f;   // == SB_LOCK_CONFIDENCE (sb_tempo.cpp)
static const float TEMPO_CONF_HI = 0.60f;
static const float TEMPO_LEAD    = 0.0f;    // beat anticipation (0..~0.15); 0 = surge ON the beat

static inline float t_smoothstep(float lo, float hi, float x) {
  if (hi <= lo) return (x >= hi) ? 1.0f : 0.0f;
  float t = (x - lo) / (hi - lo);
  if (t < 0.0f) t = 0.0f; else if (t > 1.0f) t = 1.0f;
  return t * t * (3.0f - 2.0f * t);
}

// ── REUSABLE OWNED MOTION PRIMITIVE ─────────────────────────────────────────
// Scrolls the global leds_16 buffer by an integer step count derived from a
// continuous, tempo-locked, phase-shaped VELOCITY. Feature-agnostic; any MAPPING
// draws after. This is the new owned engine; the mode below is one demo of it.
//
// NOTE on VP-probe determinism: this reads millis() + live sb_tempo state. Under
// the VP bit-hash probe (which halts led_thread but NOT Core-0/sb_tempo) two runs
// can differ → non-reproducible hash → gate failure (cf. Quantum Collapse). MUST
// be resolved before Tier-A: either mark this mode nondeterministic in the probe,
// or have the probe snapshot/freeze tempo+time. See the handoff.
void tempo_scroll_step(float& accum, uint32_t& last_ms, const RenderParams* rp) {
  uint32_t now = millis();
  float dt = (last_ms == 0) ? (1.0f / 120.0f) : (now - last_ms) * 0.001f;
  last_ms = now;
  if (dt < 0.001f) dt = 0.001f; else if (dt > 0.050f) dt = 0.050f;

  SBTempoEvent    t = sb_tempo_read();
  SBAudioSnapshot a = sb_audio_snapshot_read();

  float base_px_s = rp->TEMPO_PX_PER_BEAT * (t.bpm / 60.0f);     // [FACT bpm ∈ 60..156]

  // Mean-preserving intra-beat velocity envelope — surge at beat (phase01==0).
  float ph  = t.phase01 - TEMPO_LEAD;
  float env = 1.0f + rp->TEMPO_DEPTH * cosf(SB_TWO_PI_F * ph);
  if (env < 0.0f) env = 0.0f;                                    // never scroll backward
  float tempo_px_s = base_px_s * env;

  // Confidence gate + graceful fallback (Spectronome). t.confidence is silence-scaled.
  float gate      = t_smoothstep(TEMPO_CONF_LO, TEMPO_CONF_HI, t.confidence);
  float idle_px_s = a.silence ? 0.0f : rp->TEMPO_IDLE_RATE;      // halt in true silence
  float rate_px_s = idle_px_s + (tempo_px_s - idle_px_s) * gate;

  accum += rate_px_s * dt;
  int steps = (int)accum;
  if (steps > 30) steps = 30;                                    // [MEASURED] correspondence ceiling
  if (steps > 0) {
    accum -= steps;
    if (rp->MIRROR_ENABLED) waveform_shift_upper_half_up(leds_16, (uint8_t)steps);
    else                    shift_leds_up(leds_16, (uint16_t)steps);
  }
}

// ── EXAMPLE MODE ────────────────────────────────────────────────────────────
// Tempo-velocity MOTION + a PALETTE-COMPLIANT chromagram MAPPING. The mapping
// mirrors the shipping light_mode_waveform_fast colour path (palette-ownership
// branch + palette_chroma_colour) — it does NOT roll raw HSV. Confirm it matches
// the gate's required helper (effect_palette_or_chroma_colour, lightshow_modes.h
// ~213) during integration. The mapping is swappable; the engine above is the point.
void light_mode_waveform_tempo(ChannelEffectState& fx) {
  const RenderParams* rp = active_render_params();

  // MOTION — reactive persistence (canon §4.3): trail breathes shorter when louder.
  float abs_amp = fabsf(waveform_peak_scaled);
  if (abs_amp > 1.0f) abs_amp = 1.0f;
  SQ15x16 fade = SQ15x16(1.0f - 0.10f * abs_amp);
  for (uint16_t i = 0; i < NATIVE_RESOLUTION; i++) {
    leds_16[i].r *= fade; leds_16[i].g *= fade; leds_16[i].b *= fade;
  }

  // MOTION — the new tempo-locked scroll velocity.
  tempo_scroll_step(fx.tempo_scroll_accum, fx.tempo_last_ms, rp);

  // MAPPING — sanctioned palette path (mirrors light_mode_waveform_fast). Compliant.
  const bool render_secondary    = vp_render_secondary_channel;
  const bool palette_owns_colour = render_params_palette_owns_colour(rp, render_secondary);
  const uint8_t palette_to_use   = render_params_palette_index(rp, render_secondary);
  const CRGBPalette16& pal       = cached_gradient_palette(palette_to_use, render_secondary);

  const float led_share = 1.0f / 12.0f;
  float  brightness_sum = 0.0f;
  CRGB16 sum_col = {0, 0, 0};
  float  total = 0.0f;

  for (uint8_t c = 0; c < 12; c++) {
    float bright = float(chromagram_smooth[c]);
    for (uint8_t s = 0; s < int(rp->SQUARE_ITER); s++) bright *= bright;   // contrast (as waveform)
    float fract = rp->SQUARE_ITER - floorf(rp->SQUARE_ITER);
    if (fract > 0.01f) { float sq = bright * bright; bright = bright * (1.0f - fract) + sq * fract; }
    if (bright > 1.0f) bright = 1.0f;

    if (palette_owns_colour) {
      brightness_sum += bright * led_share;
    } else if (chromatic_mode) {
      CRGB16 nc = hsv(SQ15x16(c / 12.0f), SQ15x16(rp->SATURATION), SQ15x16(bright));
      sum_col.r += nc.r; sum_col.g += nc.g; sum_col.b += nc.b; total += bright;
    } else {
      brightness_sum += bright * led_share;
    }
  }

  CRGB16 col;
  if (palette_owns_colour) {
    col = palette_chroma_colour(pal, clamp01_fixed(SQ15x16(brightness_sum)), rp->CHROMA);
  } else if (chromatic_mode && total > 0.01f) {
    SQ15x16 lv = clamp01_fixed(SQ15x16(total));
    col.r = (sum_col.r / total) * lv; col.g = (sum_col.g / total) * lv; col.b = (sum_col.b / total) * lv;
  } else {
    SQ15x16 v = (total > 0.01f) ? SQ15x16(total) : SQ15x16(abs_amp);
    col = hsv(chroma_val + hue_position, SQ15x16(rp->SATURATION), v);
  }
  col = clamp_crgb16(col);

  // Draw the sample into the upper-half source position; mirror reflects it for free.
  float amp = waveform_peak_scaled;
  uint16_t pos = rp->MIRROR_ENABLED ? waveform_upper_half_source_position(amp)
                                    : waveform_full_strip_position(amp);
  leds_16[pos] = col;

  if (rp->MIRROR_ENABLED) mirror_image_downwards(leds_16);
}