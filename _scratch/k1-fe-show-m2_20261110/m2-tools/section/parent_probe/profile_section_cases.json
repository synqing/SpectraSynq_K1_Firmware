      "sections": [{ "id": "all_choruses", "select": { "label": "chorus" }, "prim8": { "impact": { "transform": { "beat_amp_u16": 12000 } } } }] },
    { "name": "by time range", "ok": true, "schema": "mapping_profile_v2",
      "sections": [{ "id": "r", "select": { "time_range_us": { "t_us": 45680000, "t1_us": 60810000 } }, "prim8": { "impact": { "transform": { "beat_amp_u16": 12000 } } } }] },
    { "name": "two disjoint sections, two dimensions, a note", "ok": true, "schema": "mapping_profile_v2",
      "sections": [
        { "id": "a", "note": "quieter verse accents", "select": { "segment_indices": [1, 2] }, "prim8": { "impact": { "transform": { "beat_amp_u16": 20000 }, "notes": "x" } } },
        { "id": "b", "select": { "segment_indices": [4] }, "prim8": { "mass": { "transform": { "silence_floor": 0.001 } } } }
      ] },
    { "name": "transform type replaced whole", "ok": true, "schema": "mapping_profile_v2",
      "sections": [{ "id": "flat", "select": { "segment_indices": [0] }, "prim8": { "impact": { "transform": { "type": "beat_pulse_u16", "beat_amp_u16": 30000, "beat_pulse_us": 40000 } } } }] },
