  "cases": [
    { "name": "one section by index and label", "ok": true, "schema": "mapping_profile_v2",
      "sections": [{ "id": "chorus_1", "select": { "segment_indices": [4], "label": "chorus" }, "prim8": { "impact": { "transform": { "beat_amp_u16": 12000 } } } }] },
