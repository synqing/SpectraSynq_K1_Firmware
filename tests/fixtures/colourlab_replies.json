      "chunks": ["ESP-ROM:esp32s3-20210327\nBuild:Mar 27 2021\nrst:0x15 (USB_UART_CHIP_RESET)\nSPECTRASYNQ K1 boot\nPAINT: mode=off target=both rgb=140,140,140 s=1.000 v=0.550 stops=0\n"],
      "events": [
        {"kind": "chatter", "line": "ESP-ROM:esp32s3-20210327"},
        {"kind": "chatter", "line": "Build:Mar 27 2021"},
        {"kind": "chatter", "line": "rst:0x15 (USB_UART_CHIP_RESET)"},
        {"kind": "chatter", "line": "SPECTRASYNQ K1 boot"},
        {"kind": "paint", "mode": "off", "target": "both", "r": 140, "g": 140, "b": 140, "s": 1.0, "v": 0.55, "stops": 0}
      ]
    },
    {
