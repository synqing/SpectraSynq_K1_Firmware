{
  "description": "Serial reply parser fixtures for the Colour Lab web instrument. Each case feeds `chunks` (in order) into the line parser and expects exactly `events` classified Colour Lab events. Lines that are neither PAINT:/TUNE:/TUNE_SAVE:/Bad command: are `chatter`; lines with a Colour Lab prefix that fail strict grammar are `malformed`. Grammar frozen in tools/colourlab/README.md section 1.2.",
  "cases": [
    {
      "name": "simple_paint_lf",
      "chunks": ["PAINT: mode=solid target=both rgb=140,140,140 s=1.000 v=0.550 stops=0\n"],
      "events": [
        {"kind": "paint", "mode": "solid", "target": "both", "r": 140, "g": 140, "b": 140, "s": 1.0, "v": 0.55, "stops": 0}
      ]
    },
    {
      "name": "fragmented_across_three_chunks",
      "chunks": ["PAINT: mo", "de=ramp target=primary rgb=255,0,0 s=0.", "800 v=0.550 stops=0\n"],
      "events": [
        {"kind": "paint", "mode": "ramp", "target": "primary", "r": 255, "g": 0, "b": 0, "s": 0.8, "v": 0.55, "stops": 0}
      ]
    },
    {
      "name": "multiple_replies_one_chunk",
      "chunks": ["PAINT: mode=card target=secondary rgb=200,64,10 s=1.000 v=0.550 stops=2\nTUNE: gain=1.000,1.000,1.000 gamma=1.000 slot=15 type=2\n"],
      "events": [
        {"kind": "paint", "mode": "card", "target": "secondary", "r": 200, "g": 64, "b": 10, "s": 1.0, "v": 0.55, "stops": 2},
        {"kind": "tune", "gain_r": 1.0, "gain_g": 1.0, "gain_b": 1.0, "gamma": 1.0, "slot": 15, "type": "2"}
      ]
    },
    {
      "name": "crlf_line_endings",
      "chunks": ["TUNE: gain=0.500,1.000,2.000 gamma=2.200 slot=15 type=2\r\n"],
      "events": [
        {"kind": "tune", "gain_r": 0.5, "gain_g": 1.0, "gain_b": 2.0, "gamma": 2.2, "slot": 15, "type": "2"}
      ]
    },
    {
      "name": "cr_only_line_endings",
      "chunks": ["TUNE_SAVE: ok\rPAINT: mode=off target=both rgb=140,140,140 s=1.000 v=0.550 stops=0\r"],
      "events": [
        {"kind": "save_ok"},
        {"kind": "paint", "mode": "off", "target": "both", "r": 140, "g": 140, "b": 140, "s": 1.0, "v": 0.55, "stops": 0}
      ]
    },
